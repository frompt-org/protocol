#!/usr/bin/env bash
# claw-new -- scaffold a new Skill Injection document from TEMPLATE.claw.md.
#
#   bin/claw-new my-skill                    # print to stdout
#   bin/claw-new my-skill > skills/my-skill.claw.md
#   bin/claw-new my-skill -o skills/         # write skills/my-skill.claw.md
#   bin/claw-new my-skill --version 2.0.0 --author "Jane"
#
# Then edit '## Protocol', tighten the envelope, and run bin/claw-lint on it.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
template="$here/TEMPLATE.claw.md"

id=""; version="1.0.0"; author="${CLAW_AUTHOR:-$(git config user.name 2>/dev/null || echo unknown)}"; outdir=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--out)     outdir="$2"; shift 2 ;;
    --version)    version="$2"; shift 2 ;;
    --author)     author="$2"; shift 2 ;;
    -h|--help)    sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)           echo "claw-new: unknown flag $1" >&2; exit 2 ;;
    *)            id="$1"; shift ;;
  esac
done

[ -n "$id" ] || { echo "usage: claw-new <skill-id> [-o DIR] [--version X.Y.Z] [--author NAME]" >&2; exit 2; }
[ -f "$template" ] || { echo "claw-new: template not found at $template" >&2; exit 2; }

case "$id" in
  *[!a-z0-9-]*) echo "claw-new: id '$id' must match [a-z0-9-]+ (PROTOCOL.md 3.2)" >&2; exit 2 ;;
esac
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "claw-new: version '$version' must be semver MAJOR.MINOR.PATCH" >&2; exit 2 ;;
esac

render() {
  sed -e "s/my-skill/$id/g" -e "s/^version: 1\.0\.0$/version: $version/" \
      -e "s/v1\.0\.0/v$version/g" -e "s/^author: your-name-here$/author: $author/" "$template"
}

if [ -n "$outdir" ]; then
  mkdir -p "$outdir"
  dest="${outdir%/}/$id.claw.md"
  [ -e "$dest" ] && { echo "claw-new: $dest already exists" >&2; exit 1; }
  render > "$dest"
  echo "wrote $dest" >&2
  echo "next: edit '## Protocol', tighten the envelope, then run bin/claw-lint $dest" >&2
else
  render
fi
