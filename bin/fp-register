#!/usr/bin/env python3
"""fp-register — record that this workspace accepted a catalog. Like sources.list.

The `registered` context is defined as consent given once, and until now nothing
represented that moment: fpa.lock said what was pinned, never that anyone had
agreed to it. This is the missing artifact — one line per catalog, the shape apt
has used for thirty years.

    fp-register <base> --key SHA256:...  [--pin latest|version|digest] [--as who]
    fp-register <base> --trust <allowed_signers-file> [...]
    fp-register <base>              (the key is already in the workspace trust root)
    fp-register --list
    fp-unregister <base>            (same tool, invoked by that name)

--key is how a client trusts a catalog on someone's own domain. The publisher
gives you a fingerprint by some route that is not the catalog -- their website,
a colleague, a README you already trust -- and the key itself is then read from
<base>/allowed_signers and accepted only if it has exactly that fingerprint. The
fingerprint is the trust root; the fetched key is merely checked against it,
which is what keeps this inside FPA.md M7.

Everything is recorded in the workspace (bin/fpa_roots.py): FPA_WORKSPACE, else
this tool checkout. Point FPA_WORKSPACE at ~/.config/frompt for one record per
user, or at a directory your fleet tooling provisions for one per machine.

Registering verifies the catalog first: a catalog you cannot verify is not one you
can meaningfully accept. It records the signer's fingerprint, so a later key
substitution is visible even if the new key is also in allowed_signers.

Once fpa.registered exists, fp-verify refuses catalogs absent from it. Opting into
the model is what makes the model mean anything; a workspace with no such file is
simply not using it.

Exit: 0 done · 1 refused · 2 unusable input.
"""
import datetime
import json
import os
import pathlib
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import fpa_roots  # noqa: E402

ROOT = fpa_roots.TOOLS
WS = fpa_roots.workspace()
FILE = WS / "fpa.registered"
HEADER = [
    "# fpa.registered -- catalogs this workspace has accepted, and on what terms.",
    "#",
    "# <base> <signer-fingerprint> <pin-mode> <registered-on> <who>",
    "#",
    "# A line here is a record that someone agreed once, which is the whole content",
    "# of the registered context. Remove a line with fp-unregister; nothing else",
    "# revokes it, because nothing else agreed to it.",
]


def parse():
    if not FILE.exists():
        return {}
    out = {}
    for line in FILE.read_text().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        base, fp, pin, when, who = line.split(None, 4)
        out[base] = {"fingerprint": fp, "pin": pin, "when": when, "who": who}
    return out


def render(entries):
    lines = list(HEADER) + [""]
    for base in sorted(entries):
        e = entries[base]
        lines.append(f"{base} {e['fingerprint']} {e['pin']} {e['when']} {e['who']}")
    return "\n".join(lines) + "\n"


def key_of(line):
    """(principal, "type base64") of an allowed_signers line, or None.

    Options such as namespaces="..." may sit between the two, so the key is found
    by its type rather than by position."""
    parts = line.split()
    if not parts or parts[0].startswith("#"):
        return None
    for i, tok in enumerate(parts[1:], 1):
        if tok.startswith(("ssh-", "ecdsa-", "sk-")) and i + 1 < len(parts):
            return parts[0], f"{tok} {parts[i + 1]}"
    return None


def fingerprint(key):
    proc = subprocess.run(["ssh-keygen", "-lf", "-"], input=key + "\n", capture_output=True, text=True)
    return proc.stdout.split()[1] if proc.returncode == 0 and proc.stdout.split() else None


def fetch_signers(base):
    """<base>/allowed_signers, through the same transports a catalog is read by."""
    if base.startswith("gh:"):
        lint = load_lint()
        spec = base[len("gh:"):]
        return lint.fetch_gh(f"gh:{spec}/allowed_signers")
    if base.startswith(("http://", "https://")):
        return load_lint().fetch(f"{base}/allowed_signers")
    return pathlib.Path(base, "allowed_signers").read_text()


def load_lint():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("fp_lint", str(ROOT / "bin" / "fp-lint"))
    spec = importlib.util.spec_from_loader("fp_lint", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def extend_trust(lines, source):
    """Add publisher keys to the workspace trust root. A principal is a name a
    verification reports ("signed by X"), so two different keys may not share one:
    the second is refused rather than silently skipped or silently added."""
    local = WS / "allowed_signers"
    have = {}
    if local.exists():
        for l in local.read_text().splitlines():
            k = key_of(l)
            if k:
                have.setdefault(k[0], set()).add(k[1])
    added = []
    for line in lines:
        k = key_of(line)
        if not k:
            continue
        principal, key = k
        if key in have.get(principal, set()):
            continue
        if principal in have:
            print(f"fp-register: the principal {principal!r} already names a different key in "
                  f"{local}.\n  Two publishers under one name would make 'signed by {principal}' "
                  "mean either of them. Ask the publisher, or edit the trust root deliberately.",
                  file=sys.stderr)
            return None
        WS.mkdir(parents=True, exist_ok=True)
        with local.open("a") as f:
            f.write(line.rstrip("\n") + "\n")
        have.setdefault(principal, set()).add(key)
        added.append(f"{principal} {fingerprint(key)}")
    if added:
        print(f"trust root {local} extended from {source}:\n  " + "\n  ".join(added))
    return added


def main(argv):
    invoked_as = pathlib.Path(argv[0]).name
    valued = {"--key", "--trust", "--pin", "--as"}
    args = [a for i, a in enumerate(argv[1:], 1)
            if not a.startswith("-") and argv[i - 1] not in valued]
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0

    entries = parse()

    if "--list" in argv:
        if not entries:
            print("no catalogs registered -- this workspace has not opted into the registered "
                  "context, so fp-verify accepts any catalog it can verify")
            return 0
        for base, e in sorted(entries.items()):
            print(f"{base}\n  key {e['fingerprint']}  pin {e['pin']}  since {e['when']}  by {e['who']}")
        return 0

    if not args:
        print(__doc__)
        return 2
    base = args[0].rstrip("/")

    if invoked_as == "fp-unregister" or "--remove" in argv:
        if base not in entries:
            print(f"fp-unregister: {base} is not registered", file=sys.stderr)
            return 1
        del entries[base]
        FILE.write_text(render(entries))
        print(f"unregistered {base}\n  Nothing else revoked it, because nothing else agreed to it.")
        if not entries:
            print("  fpa.registered is now empty. It still opts this workspace into the model, so\n"
                  "  every catalog is refused until one is registered. Delete the file to opt out.")
        return 0

    # The trust root is never fetched from the catalog it validates (M7). The pilot
    # brings it: as a file obtained out of band (--trust), or as a fingerprint
    # obtained out of band (--key), against which the catalog's published key is
    # then checked. Either way the decision was made somewhere else.
    want = argv[argv.index("--key") + 1] if "--key" in argv else None
    if want is not None and not want.startswith("SHA256:"):
        print("fp-register: --key takes a fingerprint, SHA256:..., as ssh-keygen -l prints it",
              file=sys.stderr)
        return 2
    if "--trust" in argv or want:
        if "--trust" in argv:
            src = argv[argv.index("--trust") + 1]
            text = pathlib.Path(src).read_text()
        else:
            src = f"{base}/allowed_signers"
            try:
                text = fetch_signers(base)
            except Exception as exc:  # noqa: BLE001
                print(f"fp-register: cannot read {src} -- {exc}", file=sys.stderr)
                return 2
        lines = [l for l in text.splitlines() if key_of(l)]
        if want:
            lines = [l for l in lines if fingerprint(key_of(l)[1]) == want]
            if not lines:
                print(f"fp-register: no key with fingerprint {want} in {src}.\n"
                      "  Either the fingerprint you were given is not this catalog's, or the catalog "
                      "is not serving the key its publisher gave you. Do not register it.",
                      file=sys.stderr)
                return 1
        if extend_trust(lines, src) is None:
            return 1

    verify = ROOT / "bin" / "fp-verify"
    # --registering: check the catalog itself, but not whether it is already
    # registered. Otherwise the first check forbids the act it is checking for.
    proc = subprocess.run([str(verify), "--from", base, "--registering"],
                          capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if proc.returncode != 0:
        print(f"fp-register: cannot verify {base} -- refusing to record consent to a catalog "
              f"this workspace cannot check.\n  {proc.stderr.strip().splitlines()[0] if proc.stderr.strip() else ''}",
              file=sys.stderr)
        return 1

    # The fingerprint of the key that signed THIS catalog's manifest, as fp-verify
    # found it -- not the first key in the local file, which is some other publisher's.
    fp = None
    for line in proc.stdout.splitlines():
        if line.startswith("manifest verified:") and line.split()[-1].startswith("SHA256:"):
            fp = line.split()[-1]
    if not fp:
        print("fp-register: fp-verify did not report the signing key's fingerprint", file=sys.stderr)
        return 1

    if want and fp != want:
        print(f"fp-register: {base} is signed by {fp}, not by the key you were given ({want}).\n"
              "  Do not register it.", file=sys.stderr)
        return 1

    pin = "latest"
    if "--pin" in argv:
        pin = argv[argv.index("--pin") + 1]
    if pin not in ("latest", "version", "digest"):
        print(f"fp-register: --pin must be latest, version or digest", file=sys.stderr)
        return 2
    who = argv[argv.index("--as") + 1] if "--as" in argv else os.environ.get("USER", "unknown")

    was = entries.get(base)
    if was and was["fingerprint"] != fp:
        print(f"fp-register: {base} was registered against key {was['fingerprint']}, and now signs "
              f"with {fp}.\n  A publisher may have rotated a key, or someone may have swapped one. "
              "Unregister first, deliberately, if this is expected.", file=sys.stderr)
        return 1

    entries[base] = {"fingerprint": fp, "pin": pin,
                     "when": datetime.datetime.now().strftime("%Y-%m-%d"), "who": who}
    FILE.write_text(render(entries))
    print(f"registered {base}\n  key {fp}\n  pin {pin}, by {who}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
