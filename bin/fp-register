#!/usr/bin/env python3
"""fp-register — record that this workspace accepted a catalog. Like sources.list.

The `registered` context is defined as consent given once, and until now nothing
represented that moment: fpa.lock said what was pinned, never that anyone had
agreed to it. This is the missing artifact — one line per catalog, the shape apt
has used for thirty years.

    fp-register <base> --key SHA256:...  [--pin latest|version|digest] [--as who]
    fp-register <base> --trust <allowed_signers-file> [...]
    fp-register <base>              (the key is already in the workspace trust root)
    fp-register --list
    fp-unregister <base>            (same tool, invoked by that name)

--key is how a client trusts a catalog on someone's own domain. The publisher
gives you a fingerprint by some route that is not the catalog -- their website,
a colleague, a README you already trust -- and the key itself is then read from
<base>/allowed_signers and accepted only if it has exactly that fingerprint. The
fingerprint is the trust root; the fetched key is merely checked against it,
which is what keeps this inside FPA.md M7.

Everything is recorded in the workspace (bin/fpa_roots.py): FPA_WORKSPACE, else
this tool checkout. Point FPA_WORKSPACE at ~/.config/frompt for one record per
user, or at a directory your fleet tooling provisions for one per machine.

A catalog signed under a certificate (an authority's cert-authority line, FPA.md
M7b) is refused: a registration pins one key, and an authority vouches for many.

Registering verifies the catalog first: a catalog you cannot verify is not one you
can meaningfully accept. It records the signer's fingerprint, so a later key
substitution is visible even if the new key is also in allowed_signers.

Once fpa.registered exists, fp-verify refuses catalogs absent from it. Opting into
the model is what makes the model mean anything; a workspace with no such file is
simply not using it.

Exit: 0 done · 1 refused · 2 unusable input.
"""
import datetime
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import fpa_roots  # noqa: E402

ROOT = fpa_roots.TOOLS
WS = fpa_roots.workspace()
FILE = WS / "fpa.registered"
HEADER = [
    "# fpa.registered -- catalogs this workspace has accepted, and on what terms.",
    "#",
    "# <base> <signer-fingerprint> <pin-mode> <registered-on> <who>",
    "#",
    "# A line here is a record that someone agreed once, which is the whole content",
    "# of the registered context. Remove a line with fp-unregister; nothing else",
    "# revokes it, because nothing else agreed to it.",
]


def parse():
    if not FILE.exists():
        return {}
    out = {}
    for line in FILE.read_text().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        base, fp, pin, when, who = line.split(None, 4)
        out[base] = {"fingerprint": fp, "pin": pin, "when": when, "who": who}
    return out


def render(entries):
    lines = list(HEADER) + [""]
    for base in sorted(entries):
        e = entries[base]
        lines.append(f"{base} {e['fingerprint']} {e['pin']} {e['when']} {e['who']}")
    return "\n".join(lines) + "\n"


def key_of(line):
    """(principal, "type base64") of an allowed_signers line, or None."""
    entry = fpa_roots.signers_entry(line)
    return (entry[0], f"{entry[2]} {entry[3]}") if entry else None


# What a registration may add to the trust root: one named principal, one key, and
# at most the namespace this protocol signs in. The line is written here from those
# parts, never copied from the catalog, so nothing else a served line says reaches
# the trust root.
PRINCIPAL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._@+-]*")


def publisher_line(line, src):
    """The trust-root line for one served line, or raise ValueError saying why not."""
    entry = fpa_roots.signers_entry(line)
    if entry is None:
        raise ValueError(f"cannot read a line in {src}")
    principals, options, keytype, key = entry
    if not PRINCIPAL.fullmatch(principals):
        raise ValueError(f"{src} names the key for {principals!r}; a registration takes one plain "
                         "principal -- no list, pattern or quotes")
    extra = [n for n, v in options if not (n == "namespaces" and v == "foreign-prompts")]
    if extra:
        raise ValueError(f"{src} gives the key for {principals} the option(s) {', '.join(extra)}; "
                         "a registration takes a key and nothing else")
    return f'{principals} namespaces="foreign-prompts" {keytype} {key}'


def is_authority(line):
    """True for an allowed_signers line that names a certificate authority."""
    parts = line.split()
    return len(parts) > 2 and "cert-authority" in parts[1].split(",")


AUTHORITY_RESERVED = (
    "  A registration pins one key. An authority vouches for many principals, so pinning\n"
    "  it alone would let any of them sign this catalog. Registering an authority is\n"
    "  reserved until a registration binds the principal too (FPA.md M7b); trust it in\n"
    "  the managed context instead, with its cert-authority line in your trust root.")


def fingerprint(key):
    proc = subprocess.run(["ssh-keygen", "-lf", "-"], input=key + "\n", capture_output=True, text=True)
    return proc.stdout.split()[1] if proc.returncode == 0 and proc.stdout.split() else None


def fetch_signers(base):
    """<base>/allowed_signers, through the same transports a catalog is read by."""
    if base.startswith("gh:"):
        lint = load_lint()
        spec = base[len("gh:"):]
        return lint.fetch_gh(f"gh:{spec}/allowed_signers")
    if base.startswith(("http://", "https://")):
        return load_lint().fetch(f"{base}/allowed_signers")
    return pathlib.Path(base, "allowed_signers").read_text()


def load_lint():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("fp_lint", str(ROOT / "bin" / "fp-lint"))
    spec = importlib.util.spec_from_loader("fp_lint", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def extend_trust(lines, source, local):
    """Add publisher keys to a trust root. A principal is a name a verification
    reports ("signed by X"), so two different keys may not share one: the second
    is refused rather than silently skipped or silently added."""
    have = {}
    if local.exists():
        for l in local.read_text().splitlines():
            k = key_of(l)
            if k:
                have.setdefault(k[0], set()).add(k[1])
    added = []
    for line in lines:
        k = key_of(line)
        if not k:
            continue
        principal, key = k
        if key in have.get(principal, set()):
            continue
        if principal in have:
            print(f"fp-register: the principal {principal!r} already names a different key in "
                  "the trust root.\n  Two publishers under one name would make 'signed by {principal}' "
                  "mean either of them. Ask the publisher, or edit the trust root deliberately.",
                  file=sys.stderr)
            return None
        local.parent.mkdir(parents=True, exist_ok=True)
        with local.open("a") as f:
            f.write(line.rstrip("\n") + "\n")
        have.setdefault(principal, set()).add(key)
        added.append(f"{principal} {fingerprint(key)}")
    return added


# A registration is one line of whitespace-separated fields, so every field it
# records is one printable word.
ONE_WORD = re.compile(r"[^\s\x00-\x1f\x7f-\x9f]+")


class Trial:
    """A registration is tried in a copy of the workspace's trust state, and kept
    only if every check passes. The copy holds the trust root, the freshness floors
    and the catalog bindings, and no fpa.registered: the trial checks the catalog
    itself, not whether it is registered yet. Nothing in the real workspace changes
    until commit(), so a refusal needs no undoing."""

    FILES = ("allowed_signers", ".fpa/manifest-serials.json", ".fpa/catalog-signers.json")

    def __init__(self):
        self.dir = pathlib.Path(tempfile.mkdtemp(prefix="fp-register-"))
        for name in self.FILES:
            if (WS / name).exists():
                (self.dir / name).parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(WS / name, self.dir / name)
        self.trust = self.dir / "allowed_signers"

    def discard(self):
        shutil.rmtree(self.dir, ignore_errors=True)

    def commit(self):
        """Fold the trial into the workspace: keys added, floors raised, bindings
        recorded. Merged rather than copied, so nothing the workspace learned in
        the meantime is lost and no floor moves down."""
        WS.mkdir(parents=True, exist_ok=True)
        local = WS / "allowed_signers"
        have = local.read_text().splitlines() if local.exists() else []
        new = [l for l in (self.trust.read_text().splitlines() if self.trust.exists() else [])
               if l not in have]
        if new:
            local.write_text("\n".join(have + new) + "\n")
        for name, merge in ((".fpa/manifest-serials.json", lambda a, b: max(int(a), int(b))),
                            (".fpa/catalog-signers.json", lambda a, b: a)):
            src = self.dir / name
            if not src.exists():
                continue
            dst = WS / name
            mine = json.loads(dst.read_text()) if dst.exists() else {}
            for k, v in json.loads(src.read_text()).items():
                mine[k] = merge(mine[k], v) if k in mine else v
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(json.dumps(mine, indent=2, sort_keys=True) + "\n")
        self.discard()
        return new


def drop_key(fp):
    """Remove the trust-root lines for the key with this fingerprint."""
    local = WS / "allowed_signers"
    if not local.exists():
        return 0
    keep, dropped = [], 0
    for line in local.read_text().splitlines():
        k = key_of(line)
        if k and fingerprint(k[1]) == fp:
            dropped += 1
            continue
        keep.append(line)
    if dropped:
        local.write_text("\n".join(keep) + ("\n" if keep else ""))
    return dropped


def main(argv):
    invoked_as = pathlib.Path(argv[0]).name
    valued = {"--key", "--trust", "--pin", "--as"}
    args = [a for i, a in enumerate(argv[1:], 1)
            if not a.startswith("-") and argv[i - 1] not in valued]
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0

    entries = parse()

    if "--list" in argv:
        if not entries:
            print("no catalogs registered -- this workspace has not opted into the registered "
                  "context, so fp-verify accepts any catalog it can verify")
            return 0
        for base, e in sorted(entries.items()):
            print(f"{base}\n  key {e['fingerprint']}  pin {e['pin']}  since {e['when']}  by {e['who']}")
        return 0

    if not args:
        print(__doc__)
        return 2
    base = args[0].rstrip("/")
    if not ONE_WORD.fullmatch(base):
        print(f"fp-register: {base!r} cannot be a catalog address here -- it must be one word "
              "with no spaces or control characters", file=sys.stderr)
        return 2

    if invoked_as == "fp-unregister" or "--remove" in argv:
        if base not in entries:
            print(f"fp-unregister: {base} is not registered", file=sys.stderr)
            return 1
        gone = entries.pop(base)
        FILE.write_text(render(entries))
        print(f"unregistered {base}\n  Nothing else revoked it, because nothing else agreed to it.")
        # The key came in with the registration, so it leaves with it -- unless
        # another registration still names it. A publisher that rotates its key is
        # then unregistered and registered again, under the same principal.
        if not any(e["fingerprint"] == gone["fingerprint"] for e in entries.values()):
            if drop_key(gone["fingerprint"]):
                print(f"  its key {gone['fingerprint']} is removed from the trust root")
        if not entries:
            print("  fpa.registered is now empty. It still opts this workspace into the model, so\n"
                  "  every catalog is refused until one is registered. Delete the file to opt out.")
        return 0

    # The trust root is never fetched from the catalog it validates (M7). The pilot
    # brings it: as a file obtained out of band (--trust), or as a fingerprint
    # obtained out of band (--key), against which the catalog's published key is
    # then checked. Either way the decision was made somewhere else.
    pin = fpa_roots.flag_value(argv, "--pin", "fp-register") or "latest"
    if pin not in ("latest", "version", "digest"):
        print(f"fp-register: --pin must be latest, version or digest", file=sys.stderr)
        return 2
    who = fpa_roots.flag_value(argv, "--as", "fp-register") or os.environ.get("USER") or "unknown"
    if not ONE_WORD.fullmatch(who):
        print(f"fp-register: {who!r} cannot be recorded as who registered -- it must be one word "
              "with no spaces or control characters (set --as)", file=sys.stderr)
        return 2

    trial = Trial()
    try:
        return register(argv, entries, base, pin, who, trial)
    finally:
        trial.discard()


def register(argv, entries, base, pin, who, trial):
    want = fpa_roots.flag_value(argv, "--key", "fp-register")
    if want is not None and not want.startswith("SHA256:"):
        print("fp-register: --key takes a fingerprint, SHA256:..., as ssh-keygen -l prints it",
              file=sys.stderr)
        return 2
    if "--trust" in argv or want:
        if "--trust" in argv:
            src = fpa_roots.flag_value(argv, "--trust", "fp-register")
            text = pathlib.Path(src).read_text()
        else:
            src = f"{base}/allowed_signers"
            try:
                text = fetch_signers(base)
            except Exception as exc:  # noqa: BLE001
                print(f"fp-register: cannot read {src} -- {exc}", file=sys.stderr)
                return 2
        lines = [l for l in text.splitlines() if key_of(l)]
        if want:
            lines = [l for l in lines if fingerprint(key_of(l)[1]) == want]
            if not lines:
                print(f"fp-register: no key with fingerprint {want} in {src}.\n"
                      "  Either the fingerprint you were given is not this catalog's, or the catalog "
                      "is not serving the key its publisher gave you. Do not register it.",
                      file=sys.stderr)
                return 1
            if len(lines) > 1:
                print(f"fp-register: {src} serves the key {want} on {len(lines)} lines.\n"
                      "  A registration trusts one key under one principal. Do not register it.",
                      file=sys.stderr)
                return 1
        # An authority line gets its own answer: registering one is reserved (M7b).
        if any(is_authority(l) for l in lines):
            print(f"fp-register: {src} names a certificate authority, not a key.\n"
                  + AUTHORITY_RESERVED, file=sys.stderr)
            return 1
        try:
            lines = [publisher_line(l, src) for l in lines]
        except ValueError as exc:
            print(f"fp-register: {exc}. Do not register it.", file=sys.stderr)
            return 1
        if extend_trust(lines, src, trial.trust) is None:
            return 1

    verify = ROOT / "bin" / "fp-verify"
    # Verified in the trial workspace, which has no fpa.registered: the catalog is
    # checked on its own merits, and the real workspace's register still applies to
    # everyone else.
    proc = subprocess.run([str(verify), "--from", base],
                          env=dict(os.environ, FPA_WORKSPACE=str(trial.dir)),
                          capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if proc.returncode != 0:
        print(f"fp-register: cannot verify {base} -- refusing to record consent to a catalog "
              f"this workspace cannot check.\n  {proc.stderr.strip().splitlines()[0] if proc.stderr.strip() else ''}",
              file=sys.stderr)
        return 1

    # The fingerprint of the key that signed THIS catalog's manifest, as fp-verify
    # found it -- not the first key in the local file, which is some other publisher's.
    fp = None
    for line in proc.stdout.splitlines():
        if line.startswith("manifest verified:") and " via certificate from authority " in line:
            print(f"fp-register: {base} is signed under a certificate, not by a key.\n"
                  + AUTHORITY_RESERVED, file=sys.stderr)
            return 1
        if line.startswith("manifest verified:") and line.split()[-1].startswith("SHA256:"):
            fp = line.split()[-1]
    if not fp:
        print("fp-register: fp-verify did not report the signing key's fingerprint", file=sys.stderr)
        return 1

    if want and fp != want:
        print(f"fp-register: {base} is signed by {fp}, not by the key you were given ({want}).\n"
              "  Do not register it.", file=sys.stderr)
        return 1

    was = entries.get(base)
    if was and was["fingerprint"] != fp:
        print(f"fp-register: {base} was registered against key {was['fingerprint']}, and now signs "
              f"with {fp}.\n  A publisher may have rotated a key, or someone may have swapped one. "
              "Unregister first, deliberately, if this is expected.", file=sys.stderr)
        return 1

    added = trial.commit()
    if added:
        print(f"trust root {WS / 'allowed_signers'} extended:\n  " + "\n  ".join(added))
    entries[base] = {"fingerprint": fp, "pin": pin,
                     "when": datetime.datetime.now().strftime("%Y-%m-%d"), "who": who}
    FILE.write_text(render(entries))
    print(f"registered {base}\n  key {fp}\n  pin {pin}, by {who}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
