#!/usr/bin/env bash
# fp-verify -- the managed path: verify the manifest, then a prompt against it.
#
#   fp-verify                          # is the local index.json signed by a known publisher?
#   fp-verify <id> [--base DIR]        # ...and are these the bytes it vouched for?
#   fp-verify <id> --from <dir-or-url> # fetch the publisher's manifest, then check
#   ... --context registered            # fitness check for that context (default: managed)
#   ... --manifest-out FILE             # write the exact manifest bytes that were verified
#
# --manifest-out exists for fp-resolve. Resolving from a manifest other than the
# one just verified -- fetched a second time, say -- would let a server hand the
# verifier a signed manifest and the resolver an unsigned one.
#
# --from is what makes late binding real. Without it this reads a manifest from
# your own checkout, so a publisher updating a prompt reaches nobody until they
# pull -- and signing a file you already had is close to pointless. With it, the
# manifest and the document both come from the publisher and only the trust root
# (allowed_signers) is local, which is the one thing that must never be fetched
# from the host it is used to check.
#
# Exit: 0 verified · 1 not verified · 2 cannot check (missing signature, key, tool).
#
# Exit 2 is not exit 0. An agent in a managed context that cannot verify must
# fail closed -- falling back to an unsigned fetch turns a policy boundary into
# a suggestion at the moment it matters (FPA.md AC4).
set -uo pipefail
tools=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Two places (bin/fpa_roots.py). The catalog is whose manifest is checked when
# there is no --from: FPA_CATALOG, else this checkout, never a directory found on
# disk. The workspace holds the trust root, the registrations and the freshness
# floors -- what this client trusts, which is never read out of a catalog. In
# this repository they are the same directory.
catalog=$(python3 "$tools/bin/fpa_roots.py" catalog --no-discover) || exit 2
ws=$(python3 "$tools/bin/fpa_roots.py" workspace) || exit 2

# The prompt id is the one argument that is not a flag or a flag's value, wherever
# it stands: an id after the flags was once ignored, and the run then checked the
# manifest alone and exited 0.
from=""; context="managed"; manifest_out=""; base=""; id=""; prev=""
for i in "$@"; do
  case "$prev" in
    --from|--context|--manifest-out|--base)
      case "$i" in --*) echo "fp-verify: $prev needs a value" >&2; exit 2;; esac
      case "$prev" in
        --from) from="$i" ;; --context) context="$i" ;;
        --manifest-out) manifest_out="$i" ;; --base) base="$i" ;;
      esac
      prev=""; continue ;;
  esac
  case "$i" in
    --from|--context|--manifest-out|--base) ;;
    -*) echo "fp-verify: unknown option $i (flags take their value as the next argument)" >&2; exit 2 ;;
    *) [ -z "$id" ] || { echo "fp-verify: one prompt id at a time -- got $id and $i" >&2; exit 2; }
       id="$i" ;;
  esac
  prev="$i"
done
case "$prev" in --from|--context|--manifest-out|--base) echo "fp-verify: $prev needs a value" >&2; exit 2;; esac
case "$context" in registered|managed) ;; *) echo "fp-verify: --context must be registered or managed" >&2; exit 2;; esac
# One spelling per catalog: every trailing slash goes, as fp-register strips them.
while [ "${#from}" -gt 1 ] && [ "$from" != "${from%/}" ]; do from="${from%/}"; done
case "$from" in
  gh:*@?*|gh:*@?*/*) ;;
  gh:*) echo "fp-verify: a gh: catalog is gh:owner/repo@branch -- got $from" >&2; exit 2;;
esac
case "$manifest_out" in ""|/*) ;; *) manifest_out="$PWD/$manifest_out";; esac

# Once fpa.registered exists, this workspace has opted into the registered model,
# and a catalog absent from it was never agreed to. A workspace with no such file
# is simply not using the model, so nothing changes for it. There is no flag that
# skips this: fp-register verifies a catalog in a trial workspace of its own.
if [ -n "$from" ] && [ -f "$ws/fpa.registered" ]; then
  base_key="$from"
  # ENVIRON, not awk -v: -v reads backslash escapes in the value.
  if ! B="$base_key" awk '$1==ENVIRON["B"] {found=1} END {exit !found}' "$ws/fpa.registered"; then
    echo "fp-verify: $base_key is not in fpa.registered." >&2
    echo "  This workspace registers the catalogs it accepts. Register it deliberately:" >&2
    echo "    fp-register $base_key --key <the publisher's fingerprint>" >&2
    exit 1
  fi
fi

[ -f "$ws/allowed_signers" ] || { echo "fp-verify: no allowed_signers in the workspace ($ws) -- the trust root
  must be pinned locally, never taken from the host it checks. Failing closed." >&2; exit 2; }
command -v ssh-keygen >/dev/null || { echo "fp-verify: ssh-keygen not found" >&2; exit 2; }

# Everything is checked in a scratch directory: the manifest and its signature
# (fetched, or copied from the local catalog) beside a copy of the trust root.
# The template puts it under TMPDIR (a bare `mktemp -d` ignores TMPDIR on macOS), and
# a run that is stopped still removes it: bash runs the EXIT trap on a signal only
# when the signal is trapped.
tmproot=${TMPDIR:-/tmp}
work=$(mktemp -d "${tmproot%/}/fp-verify.XXXXXXXX") || { echo "fp-verify: cannot make a scratch directory -- failing closed" >&2; exit 2; }
trap 'rm -rf "$work"' EXIT
trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
for f in index.json index.json.sig; do
  case "$from" in
    "")
      [ -f "$catalog/$f" ] || { echo "fp-verify: missing $catalog/$f -- cannot verify, failing closed" >&2; exit 2; }
      cp "$catalog/$f" "$work/$f" || exit 2
      ;;
    gh:*)
      # A private catalog needs no publication, only the credential the pilot
      # already holds. The API's raw media type returns the blob itself.
      spec="${from#gh:}"; repo="${spec%%@*}"; branch="${spec#*@}"
      if ! gh api "repos/$repo/contents/$f" -H "Accept: application/vnd.github.raw" \
           -X GET -f "ref=$branch" > "$work/$f" 2>/dev/null; then
        echo "fp-verify: gh could not read $repo@$branch/$f -- cannot verify, failing closed" >&2
        exit 2
      fi
      ;;
    *://*)
      # A URL is fetched, never looked up as a path: `--` ends the options.
      if ! curl -fsS --globoff --proto '=https,http' --max-time 20 -o "$work/$f" -- "$from/$f" 2>/dev/null; then
        echo "fp-verify: cannot fetch $from/$f -- cannot verify, failing closed" >&2; exit 2
      fi
      ;;
    *)
      cp -- "$from/$f" "$work/$f" 2>/dev/null || { echo "fp-verify: cannot read $from/$f -- cannot verify, failing closed" >&2; exit 2; }
      ;;
  esac
done
cp "$ws/allowed_signers" "$work/allowed_signers" || exit 2
orig_pwd="$PWD"
cd "$work" || exit 2

# Which trusted key made this signature? A trust root holds one line per
# publisher, and an earlier version checked the first line only -- a second
# catalog with its own key was "NOT signed by" the first catalog's publisher.
# ssh-keygen's own reason is passed on: "expired certificate" is not "modified".
reason() { tr -d '\r' < "$1" | grep -v '^[[:space:]]*$' | head -1 | cut -c1-200; }
signer=$(ssh-keygen -Y find-principals -s index.json.sig -f allowed_signers 2>find.err | head -1)
if [ -z "$signer" ]; then
  echo "fp-verify: index.json.sig was not made by any key in allowed_signers" >&2
  echo "  Either the manifest was modified after signing, or this publisher's key is not in the local trust root." >&2
  # A certificate that matched no principal says why only when verified against
  # one, so ask for its own principal: "expired" is not "modified".
  certp=$(python3 - "$tools/bin" index.json.sig <<'PY' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
import fpa_roots
c = fpa_roots.certificate(fpa_roots.signature_key(open(sys.argv[2], "rb").read()))
print(c["principals"][0] if c["principals"] else "")
PY
)
  if [ -n "$certp" ]; then
    ssh-keygen -Y verify -f allowed_signers -I "$certp" -n foreign-prompts -s index.json.sig \
      < index.json >/dev/null 2>find.err || true
  fi
  [ -z "$(reason find.err)" ] || echo "  ssh-keygen: $(reason find.err)" >&2
  exit 1
fi
if ! verified=$(ssh-keygen -Y verify -f allowed_signers -I "$signer" -n foreign-prompts \
     -s index.json.sig < index.json 2>&1); then
  echo "fp-verify: index.json is NOT signed by $signer" >&2
  echo "  Either the manifest was modified after signing, or it was signed by someone else." >&2
  printf '%s\n' "$verified" > verify.err
  [ -z "$(reason verify.err)" ] || echo "  ssh-keygen: $(reason verify.err)" >&2
  exit 1
fi
# The fingerprint of the key that made THIS signature, as ssh-keygen reports it.
# Looking it up by principal in allowed_signers took the first line with that
# name, which is some other key whenever two publishers chose the same one.
sigfp=$(printf '%s\n' "$verified" | sed -n 's/.* key \(SHA256:[^ ]*\).*/\1/p' | head -1)
[ -n "$sigfp" ] || { echo "fp-verify: the signature verified but ssh-keygen did not name its key -- failing closed" >&2; exit 2; }

# M7b: a trust root may name an authority (a cert-authority line) instead of a key.
# Then the signing key is a certificate, and whom this client trusts is the
# authority that issued it: builder keys come and go under one authority, so the
# key's own fingerprint is not an identity worth pinning or keying a floor on.
# ssh-keygen names only the certified key, so the certificate is read back out of
# the signature itself.
authority=""; floor_id="$signer"
if printf '%s\n' "$verified" | grep -q -- '-CERT key '; then
  # Read from the certificate's own bytes (bin/fpa_roots.py), never from
  # `ssh-keygen -L` text, which a key id or a principal can spell.
  certinfo=$(python3 - "$tools/bin" index.json.sig "$sigfp" "$signer" <<'PY'
import datetime, sys
sys.path.insert(0, sys.argv[1])
import fpa_roots
try:
    c = fpa_roots.certificate(fpa_roots.signature_key(open(sys.argv[2], "rb").read()))
except ValueError as exc:
    print(f"fp-verify: the certificate in index.json.sig cannot be read ({exc}) -- failing closed",
          file=sys.stderr)
    sys.exit(2)
# The certificate read back must certify the very key ssh-keygen reported.
if c["certified"] != sys.argv[3]:
    print("fp-verify: the certificate in index.json.sig does not certify the key that made the "
          "signature -- failing closed", file=sys.stderr)
    sys.exit(2)
# One principal: a certificate counts as one signer, and with several it would be
# whichever of them a trust root happened to match first (FPA.md M7b).
if c["principals"] != [sys.argv[4]]:
    print(f"fp-verify: the certificate names {len(c['principals'])} principal(s) "
          f"{c['principals']!r}; it counts only when it names exactly one (FPA.md M7b). Refusing.",
          file=sys.stderr)
    sys.exit(1)
def when(t):
    return "forever" if t >= 2 ** 63 else datetime.datetime.fromtimestamp(
        t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
print(c["authority"])
print("".join(ch if ch.isprintable() and not ch.isspace() else "_" for ch in c["key_id"]) or "-")
print(f"{when(c['valid_after'])} to {when(c['valid_before'])}")
PY
) || exit $?
  authority=$(printf '%s\n' "$certinfo" | sed -n 1p)
  [ -n "$authority" ] || { echo "fp-verify: signed with a certificate whose authority could not be read -- failing closed" >&2; exit 2; }
  # A certificate signature counts only through a cert-authority line for the
  # authority that signed it: a certificate listed as a plain key is not an authority.
  python3 - "$tools/bin" allowed_signers "$authority" > authority_only <<'PY'
import base64, binascii, sys
sys.path.insert(0, sys.argv[1])
import fpa_roots
for line in open(sys.argv[2]).read().splitlines():
    e = fpa_roots.signers_entry(line)
    if not e or "cert-authority" not in [name for name, _ in e[1]]:
        continue
    try:
        fp = fpa_roots.ssh_fingerprint(base64.b64decode(e[3], validate=True))
    except (binascii.Error, ValueError):
        continue
    if fp == sys.argv[3]:
        print(line)
PY
  if ! ssh-keygen -Y verify -f authority_only -I "$signer" -n foreign-prompts \
       -s index.json.sig < index.json >/dev/null 2>&1; then
    echo "fp-verify: index.json is signed under a certificate from $authority, and no cert-authority line" >&2
    echo "  for that authority in the trust root accepts it. A certificate counts only through its authority. Refusing." >&2
    exit 1
  fi
  # M7b: an authority is trusted in the managed context only, registered or not.
  if [ "$context" = registered ]; then
    echo "fp-verify: index.json is signed under a certificate from $authority; a certificate is trusted" >&2
    echo "  in the managed context only (FPA.md M7b). Refusing for the registered context." >&2
    exit 1
  fi
  # Kept per authority AND principal (M7b), in a form no plain principal can spell.
  floor_id=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import fpa_roots; print(fpa_roots.cert_identity(sys.argv[2], sys.argv[3]))' "$tools/bin" "$authority" "$signer")
  echo "certificate: key id $(printf '%s\n' "$certinfo" | sed -n 2p), key $sigfp, valid $(printf '%s\n' "$certinfo" | sed -n 3p)"
  echo "  the signature stops verifying when the certificate does, whatever not_after says"
  echo "manifest verified: index.json signed by $signer via certificate from authority $authority"
else
  echo "manifest verified: index.json signed by $signer $sigfp"
fi

# AC2b: the key that signed must be the key this workspace registered. A new key
# in allowed_signers is not consent; the registration line is.
if [ -n "$from" ] && [ -f "$ws/fpa.registered" ]; then
  recorded=$(B="$from" awk '$1==ENVIRON["B"] {print $2; exit}' "$ws/fpa.registered")
  # A registration records one key. An authority vouches for many principals, so
  # pinning it alone would let any of them sign this catalog; until a registration
  # binds the principal too, a certificate-signed catalog is not registered (M7b).
  if [ -n "$recorded" ] && [ -n "$authority" ]; then
    echo "fp-verify: $from is signed under a certificate from authority $authority." >&2
    echo "  A registration pins one key, and registering an authority is reserved (FPA.md M7b). Refusing." >&2
    exit 1
  fi
  if [ -n "$recorded" ] && [ "$recorded" != "$sigfp" ]; then
    echo "fp-verify: ${from%/} is signed by $sigfp but this workspace registered $recorded" >&2
    echo "  The publisher's key changed since somebody agreed to it. If that is expected, re-register deliberately." >&2
    exit 1
  fi
fi

# With no prompt id the manifest itself is still checked for expiry and freshness:
# a valid signature on a stale manifest is not a current manifest.

case "$base" in ""|/*|*://*|gh:*) ;; *) base="$orig_pwd/$base";; esac
python3 - "$id" "$base" "$ws" "$from" "$context" "$manifest_out" "$floor_id" "$orig_pwd" "$tools/bin" <<'PY'
import hashlib, json, os, pathlib, sys, urllib.request
sys.path.insert(0, sys.argv[9])
import fpa_roots
wanted, base, root, origin = sys.argv[1], sys.argv[2], pathlib.Path(sys.argv[3]), sys.argv[4]
context, manifest_out, signer = sys.argv[5], sys.argv[6], sys.argv[7]
# A relative --from names a directory where the caller stood; this runs elsewhere.
origin_path = origin if origin.startswith(("/", "gh:")) or "://" in origin else os.path.join(sys.argv[8], origin)
manifest = json.load(open("index.json"))
# Expiry first, because it is the half that needs no memory. A serial floor only
# protects a client that has already seen something newer; a fresh agent, a wiped
# .fpa or a clean container has no floor at all, and would accept an arbitrarily
# old signed bundle. `not_after` kills a replay on its own.
import datetime
now = datetime.datetime.now(datetime.timezone.utc)
not_after = manifest.get("not_after")
expires = fpa_roots.parse_stamp(not_after)
if expires is None:
    print("fp-verify: manifest carries no not_after in the form 2026-12-01T08:57:00Z -- cannot "
          "tell a current manifest from a replayed one. Refusing.", file=sys.stderr)
    sys.exit(1)
if now > expires:
    print(f"fp-verify: manifest expired at {not_after} (now {now:%Y-%m-%dT%H:%M:%SZ}).\n"
          "  A signature stays valid forever; the manifest is not meant to. The publisher "
          "re-signs, they do not ask you to trust an old one.", file=sys.stderr)
    sys.exit(1)

# Freshness: a signed manifest older than the last one seen is a replay, and every
# signature on it verifies. The floor is what makes that detectable.
#
# Kept PER CATALOG AND SIGNING KEY. One global floor meant that adopting from a
# second publisher refused whichever catalog had the lower serial -- a brand new
# catalog starting at 1 read as a rollback of an unrelated one at 45. Keying by
# `base` alone fixed that and opened the reverse: `base` is inside the signed
# bytes, so nobody can edit it, but any publisher this client trusts can SIGN a
# manifest naming another catalog's base at serial 999999 -- and every real
# manifest from that catalog was then refused as a rollback. A floor only its own
# signer can raise is a floor nobody else can poison. The signer is the principal
# the signature verified as, not the key, so a publisher that rotates its key
# keeps its floor (M6).
# Under a certificate (M7b) the signer is the authority and the principal it
# certified, so builders certified by one authority cannot poison each other either.
raw_base = manifest.get("base")
if not fpa_roots.valid_base(raw_base):
    print(f"fp-verify: the manifest's base {raw_base!r} is neither an http(s) address nor an "
          "absolute path, written once and plainly: no '.' or '..' or empty segment, no '%', ';', "
          "query or fragment, no trailing dot on the host -- refusing", file=sys.stderr)
    sys.exit(1)
catalog = fpa_roots.normalize_base(raw_base)
serial = manifest.get("serial")
if not isinstance(serial, int) or isinstance(serial, bool) or serial < 1:
    print(f"fp-verify: the manifest's serial {serial!r} is not a positive whole number -- refusing",
          file=sys.stderr)
    sys.exit(1)
floor_key = f"{catalog} {signer}"
# The address the manifest was fetched from, spelled one way: a directory as its
# real path, a URL normalised like a base.
address = None
if origin:
    address = fpa_roots.normalize_base(
        origin if origin.startswith("gh:") or "://" in origin else os.path.realpath(origin_path))
# A catalog fetched from an http(s) address or a directory is the catalog that
# address serves: its base is that address plus /prompts. A base is otherwise a
# claim nobody checked, and it is what fpa.lock records for a reviewer to read.
# A gh: address stands for a repository, not a base, so it is not compared (FPA.md
# M6b says what that leaves).
if address is not None and not address.startswith("gh:"):
    if "://" in address:
        names_it = catalog == f"{address}/prompts"
    else:
        names_it = (catalog.startswith("/")
                    and os.path.realpath(catalog) == os.path.join(address, "prompts"))
    if not names_it:
        print(f"fp-verify: {origin} serves a manifest whose base is {raw_base}, not "
              f"{origin.rstrip('/')}/prompts.\n"
              "  A catalog's base is the address it is served from. Refusing.", file=sys.stderr)
        sys.exit(1)


def state_refusal(exc):
    print(f"fp-verify: {exc}.\n"
          "  This workspace cannot read what it has already accepted, so it cannot check anything\n"
          "  against it. Failing closed. Restore the file, or have the pilot remove it deliberately.",
          file=sys.stderr)
    sys.exit(2)


# One signer per catalog, one catalog per address (M6b). The first signer whose
# manifest naming a base this client accepted is the one it accepts for that base
# from then on, and an address that served one catalog serves that one: a second
# publisher this client also trusts can sign a manifest naming the same base, or
# serve its own catalog at another's address, and both are refusals here.
def problem(floors, signers, addresses):
    clash = fpa_roots.binding_conflict(signers, catalog, signer)
    if clash:
        bound_base, bound = clash
        return (f"fp-verify: {catalog} is signed by {signer}, but this workspace accepts "
                f"{bound_base} from {bound} only.\n"
                "  A catalog's manifests come from one signer. If its publisher deliberately moved to a\n"
                f"  new one, the pilot deletes the \"{bound_base}\" entry from "
                f"{fpa_roots.state_path(root, 'signers')}\n"
                f"  and the \"{bound_base} {bound}\" entry from {fpa_roots.state_path(root, 'floors')}.")
    if address is not None and addresses.get(address, catalog) != catalog:
        return (f"fp-verify: {address} served the catalog {addresses[address]} before, and now "
                f"serves {catalog}.\n"
                "  An address serves one catalog. If that change is deliberate, the pilot deletes the\n"
                f"  \"{address}\" entry from {fpa_roots.state_path(root, 'addresses')}.")
    # A floor recorded before floors were keyed by signer applies to every key that
    # signs that catalog until the pilot clears it. It cannot say which key set it,
    # so no key's manifest may retire it.
    known, legacy = floors.get(floor_key), None
    if known is None:
        legacy = next((k for k in (catalog, raw_base) if k in floors), None)
        known = floors[legacy] if legacy else None
    if known is not None and serial < known:
        text = (f"fp-verify: manifest serial {serial} from {catalog} is older than {known}, already "
                "seen from that catalog" + ("" if legacy else f" signed by {signer}") + ".\n"
                "  A validly signed but stale manifest is a rollback. Refusing.")
        if legacy:
            text += (f"\n  That floor was recorded before floors were kept per signer, so this tool\n"
                     f"  cannot tell which key set it. If the pilot is sure this catalog never published\n"
                     f"  serial {known}, they can delete the \"{legacy}\" entry from "
                     f"{fpa_roots.state_path(root, 'floors')};\n  nothing clears it on its own.")
        return text
    return None


try:
    found = problem(*fpa_roots.read_trust_state(root))
except fpa_roots.StateError as exc:
    state_refusal(exc)
if found:
    print(found, file=sys.stderr)
    sys.exit(1)


def record_floor():
    """Raise the floor and record the bindings only once everything this run checks
    has passed: a manifest that is refused for any reason is not one this client has
    accepted. Under the lock the state is read again and checked again, because
    another run may have accepted something in the meantime."""
    with fpa_roots.state_lock(root):
        try:
            floors, signers, addresses = fpa_roots.read_trust_state(root)
        except fpa_roots.StateError as exc:
            state_refusal(exc)
        found = problem(floors, signers, addresses)
        if found:
            print(found, file=sys.stderr)
            sys.exit(1)
        floors[floor_key] = max(serial, floors.get(floor_key, 0))
        signers.setdefault(catalog, signer)
        fpa_roots.write_state(root, "floors", floors)
        fpa_roots.write_state(root, "signers", signers)
        if address is not None:
            addresses.setdefault(address, catalog)
            fpa_roots.write_state(root, "addresses", addresses)


if not wanted:
    record_floor()
    if manifest_out:
        pathlib.Path(manifest_out).write_bytes(pathlib.Path("index.json").read_bytes())
    print(f"manifest current: serial {serial} expires {not_after}")
    sys.exit(0)
wanted, _, selector = wanted.partition("@")
group = next((p for p in manifest["prompts"] if p["id"] == wanted), None)
if group is None:
    print(f"fp-verify: {wanted!r} is not in the signed manifest -- refusing", file=sys.stderr)
    sys.exit(1)
asked = selector or "latest"
target = group["latest"] if asked == "latest" else asked
entry = next((v for v in group["versions"] if v["version"] == target), None)
if entry is None:
    have = ", ".join(v["version"] for v in group["versions"])
    print(f"fp-verify: {wanted} has no version {target!r} in the signed manifest. "
          f"Published: {have}", file=sys.stderr)
    sys.exit(1)
entry = dict(entry, id=wanted)
if not (fpa_roots.valid_id(wanted) and fpa_roots.valid_version(entry.get("version"))
        and fpa_roots.valid_digest(entry.get("digest"))):
    print(f"fp-verify: the signed manifest gives {wanted!r} an id, version or digest this client "
          "does not accept -- refusing", file=sys.stderr)
    sys.exit(1)
if not fpa_roots.safe_file(entry.get("file")):
    print(f"fp-verify: the signed manifest gives {wanted} the file {entry.get('file')!r}, which is "
          "not a plain path under prompts/ -- refusing", file=sys.stderr)
    sys.exit(1)
# A fetched manifest names where its own documents live; prefer that over the
# base baked into whatever copy happened to be on disk.
if base:
    src = f"{base.rstrip('/')}/{entry['file']}"
elif origin:
    src = f"{origin_path.rstrip('/')}/prompts/{entry['file']}"
else:
    src = f"{manifest['base']}/{entry['file']}"
try:
    if src.startswith("gh:"):
        import subprocess
        spec = src[3:]
        repo, _, rest = spec.partition("@")
        branch, _, path = rest.partition("/")
        proc = subprocess.run(["gh", "api", f"repos/{repo}/contents/{path}",
                               "-H", "Accept: application/vnd.github.raw", "-X", "GET",
                               "-f", f"ref={branch}"], capture_output=True, timeout=30)
        if proc.returncode != 0:
            raise OSError(proc.stderr.decode("utf-8", "replace")[:200])
        raw = proc.stdout
    else:
        raw = (pathlib.Path(src).read_bytes() if not src.startswith("http")
               else urllib.request.urlopen(src, timeout=15).read())
except Exception as exc:
    print(f"fp-verify: cannot read {src} -- {exc}", file=sys.stderr)
    sys.exit(2)
got = hashlib.sha256(raw).hexdigest()
if got != entry["digest"]:
    print(f"fp-verify: DIGEST MISMATCH for {wanted}\n  manifest {entry['digest']}\n"
          f"  fetched  {got}\n  source   {src}\nRefusing.", file=sys.stderr)
    sys.exit(1)
if context not in [c.strip() for c in entry["contexts"].split(",")]:
    how = "a signature" if context == "managed" else "a registration"
    print(f"fp-verify: {wanted} declares contexts [{entry['contexts']}] -- it is not fit for the "
          f"{context} context, so {how} does not authorize it (FPA.md AC4b).", file=sys.stderr)
    sys.exit(1)
soon = (expires - datetime.datetime.now(datetime.timezone.utc)).days
if soon <= 3:
    print(f"fp-verify: note -- this manifest expires in {soon} day(s), on {not_after}",
          file=sys.stderr)
record_floor()
if manifest_out:
    pathlib.Path(manifest_out).write_bytes(pathlib.Path("index.json").read_bytes())
print(f"authorized: {wanted} v{entry['version']} digest {got[:12]} "
      f"contexts [{entry['contexts']}] serial {serial} expires {not_after} source {src}")
PY
