#!/usr/bin/env python3
"""fp-lint — validate the structure of a foreign prompt (.prompt.md).

Checks what can be checked deterministically against FPA.md v1: the marker, the
front matter, the capability tokens, and the section frame. Takes a path, a URL,
or '-' for stdin.

    fp-lint prompts/repo-recon.prompt.md
    fp-lint https://raw.githubusercontent.com/org/repo/main/thing.prompt.md
    cat thing.prompt.md | fp-lint -

Flags: -q errors only · -v show notes · --json · --strict (warnings fail).

Exit: 0 valid · 1 findings · 2 bad usage or unreadable input · 3 internal error.
Those are distinct on purpose: a linter that crashes must never be mistaken for
a linter that rejected something.

WHAT THIS TOOL DOES NOT DO: judge intent. It scans for no hostile patterns,
because no pattern list survives paraphrase, and a "clean" verdict from one is
worse than no verdict at all. A valid document is a well-formed document and
nothing more. Read it before you adopt it.
"""

import json
import re
import sys

MARKER = "<!-- FOREIGN-PROMPT v1 -->"
MAX_BYTES = 256 * 1024

REQUIRED_KEYS = ["id", "version", "confirmation", "flow", "expiry", "envelope", "allow", "deny"]
OPTIONAL_KEYS = ["adoption", "persistence", "requires", "author"]

FRAME_HEAD = ["## Preamble", "## Envelope"]
FRAME_TAIL = ["## Handshake", "## Expiry"]

FLOWS = {
    "linear": ["## Steps", "## Stop conditions"],
    "loop": ["## Turn", "## Inputs", "## Exit"],
    "state-machine": ["## States", "## Transitions", "## Endings"],
    "rubric": ["## Criteria", "## Output", "## Never"],
    "interpreter": ["## Render", "## State", "## Keys", "## Director rules"],
    "interview": ["## Questions", "## Branching", "## Output"],
}

# FPA.md 4. Free-form English is not permitted: a capability nothing can compare
# against can never be enforced, only admired.
CAPABILITIES = {
    "read:files", "read:git", "read:logs", "read:conversation",
    "run:shell-ro", "run:tests", "run:build",
    "write:files", "write:artifact",
    "vcs:commit", "vcs:push",
    "net:get", "net:post",
    "pkg:install", "secrets:read",
}
SHOULD_DENY = ["secrets:read", "net:post"]

AXES = {
    "adoption": {"awaiting", "immediate", "one-shot"},
    "persistence": {"none", "artifact"},
    "envelope": {"strict", "open"},
}

GENERIC_PHRASES = {
    "run", "do", "go", "use", "load", "read", "open", "get", "fetch", "start",
    "exec", "execute", "apply", "install", "prompt", "url", "this", "it", "skill",
}

FENCE = re.compile(r"^(```|~~~).*?^\1", re.M | re.S)


class Unreadable(Exception):
    """Input could not be read — exit 2, distinct from a document being invalid."""


def read_source(src):
    if src == "-":
        return sys.stdin.read()
    if src.startswith(("http://", "https://")):
        return fetch(src)
    try:
        with open(src, encoding="utf-8") as fh:
            return fh.read()
    except UnicodeDecodeError as exc:
        raise Unreadable(f"not valid UTF-8 ({exc})") from exc
    except OSError as exc:
        raise Unreadable(str(exc)) from exc


def fetch(url):
    """Fetch a document with the limits a linter pointed at hostile URLs needs.

    HTTPS only, no redirects, no credentials, no private addresses, bounded size
    and time. The DNS answer is checked after resolution, so a public name that
    resolves inward does not get a pass.
    """
    import ipaddress
    import socket
    import urllib.error
    import urllib.request
    from urllib.parse import urlsplit

    parts = urlsplit(url)
    if parts.scheme != "https":
        raise Unreadable("refusing to fetch over anything but https")
    if parts.username or parts.password:
        raise Unreadable("refusing to fetch a URL carrying credentials")
    host = parts.hostname or ""
    try:
        infos = socket.getaddrinfo(host, parts.port or 443, proto=socket.IPPROTO_TCP)
    except socket.gaierror as exc:
        raise Unreadable(f"cannot resolve {host}: {exc}") from exc
    for info in infos:
        addr = ipaddress.ip_address(info[4][0])
        if addr.is_private or addr.is_loopback or addr.is_link_local or addr.is_reserved:
            raise Unreadable(f"{host} resolves to a non-public address ({addr})")

    class NoRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *_args, **_kwargs):
            return None

    opener = urllib.request.build_opener(NoRedirects)
    req = urllib.request.Request(url, headers={"User-Agent": "fp-lint/1.0"})
    try:
        with opener.open(req, timeout=15) as resp:
            ctype = resp.headers.get_content_type()
            if ctype not in ("text/plain", "text/markdown", "application/octet-stream"):
                raise Unreadable(f"unexpected content-type {ctype!r}; want raw text")
            raw = resp.read(MAX_BYTES + 1)
    except urllib.error.HTTPError as exc:
        raise Unreadable(f"HTTP {exc.code}" + (" (redirects are not followed)" if exc.code in (301, 302, 303, 307, 308) else "")) from exc
    except urllib.error.URLError as exc:
        raise Unreadable(str(exc.reason)) from exc
    if len(raw) > MAX_BYTES:
        raise Unreadable(f"document exceeds {MAX_BYTES} bytes")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Unreadable(f"not valid UTF-8 ({exc})") from exc


def parse_front_matter(lines):
    """Flat key: value pairs. Returns (dict, [errors])."""
    if len(lines) < 2 or lines[1].strip() != "---":
        return {}, ["front matter must open with '---' on line 2"]
    fm, errors, end = {}, [], None
    for i in range(2, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
        raw = lines[i].strip()
        if not raw or raw.startswith("#"):
            continue
        if ":" not in raw:
            errors.append(f"line {i + 1}: not a 'key: value' pair -- {raw[:60]!r}")
            continue
        key, val = raw.split(":", 1)
        key = key.strip()
        if key in fm:
            errors.append(f"line {i + 1}: duplicate key {key!r}")
        fm[key] = val.strip().strip('"').strip("'")
    if end is None:
        errors.append("front matter is never closed with '---'")
    return fm, errors


def tokens(value):
    return [t.strip() for t in value.split(",") if t.strip()]


def lint(text, name):
    errors, warnings, notes = [], [], []
    err, warn, note = errors.append, warnings.append, notes.append

    if len(text.encode("utf-8")) > MAX_BYTES:
        err(f"document exceeds {MAX_BYTES} bytes")
    lines = text.splitlines()
    if not lines:
        return ["empty document"], [], [], {}

    if lines[0].strip() != MARKER:
        first = lines[0].strip()
        if first.startswith("<!-- FOREIGN-PROMPT"):
            err(f"line 1: unsupported protocol version -- {first!r} (this linter speaks v1)")
        else:
            err(f"line 1: missing marker; must be exactly {MARKER!r}")

    fm, fm_errors = parse_front_matter(lines)
    for e in fm_errors:
        err(e)

    for key in REQUIRED_KEYS:
        if key not in fm:
            err(f"front matter: missing required key '{key}'")
    for key in fm:
        if key not in REQUIRED_KEYS + OPTIONAL_KEYS:
            warn(f"front matter: unknown key '{key}' (ignored by v1 readers, FPA.md 2.2)")
    if "handshake" in fm:
        warn("front matter: 'handshake' is not author-defined; it is computed as "
             "'ADOPTED: <id> v<version>' (FPA.md 11)")

    if "id" in fm and not re.fullmatch(r"[a-z0-9-]+", fm["id"]):
        err(f"front matter: id {fm['id']!r} must match [a-z0-9-]+")
    if "version" in fm and not re.fullmatch(r"\d+\.\d+\.\d+", fm["version"]):
        err(f"front matter: version {fm['version']!r} must be semver MAJOR.MINOR.PATCH")
    if "expiry" in fm and not re.fullmatch(r"session|task|turns:\s*\d+|until:.+", fm["expiry"]):
        err(f"front matter: expiry must be session|task|turns:<N>|until:<condition>, got {fm['expiry']!r}")
    for axis, allowed in AXES.items():
        if axis in fm and fm[axis] not in allowed:
            err(f"front matter: {axis} must be one of {sorted(allowed)}, got {fm[axis]!r}")

    phrase = fm.get("confirmation", "")
    if phrase:
        if not re.fullmatch(r"[a-z][a-z0-9-]{2,47}", phrase):
            err(f"front matter: confirmation {phrase!r} must match [a-z][a-z0-9-]{{2,47}} (FPA.md C1)")
        elif phrase in GENERIC_PHRASES:
            err(f"front matter: confirmation {phrase!r} is a generic command verb -- typable by "
                "accident, so it signals nothing about the pilot's intent (FPA.md C2)")

    for key in ("allow", "deny"):
        if key not in fm:
            continue
        listed = tokens(fm[key])
        if not listed:
            err(f"front matter: '{key}' must name at least one capability token (FPA.md 4)")
        for t in listed:
            if t not in CAPABILITIES:
                err(f"front matter: {key} token {t!r} is not in the v1 capability vocabulary "
                    f"(FPA.md 4); valid tokens: {', '.join(sorted(CAPABILITIES))}")
    overlap = set(tokens(fm.get("allow", ""))) & set(tokens(fm.get("deny", "")))
    if overlap:
        err(f"front matter: {sorted(overlap)} appear in both allow and deny; deny wins, "
            "so remove them from allow (FPA.md E1)")
    denied = set(tokens(fm.get("deny", "")))
    allowed = set(tokens(fm.get("allow", "")))
    for t in SHOULD_DENY:
        if t not in denied and t not in allowed:
            warn(f"front matter: deny does not list {t!r}; most prompts should deny it explicitly")

    persistence = fm.get("persistence", "none")
    if persistence == "none" and "write:artifact" in allowed:
        err("front matter: allows write:artifact while persistence is 'none' (FPA.md P1)")
    if persistence == "artifact" and "write:artifact" not in allowed:
        warn("front matter: persistence is 'artifact' but allow does not list write:artifact")

    # Sections. Fenced blocks are stripped first: a heading inside a code fence is
    # an example, not structure, and treating it as structure was a real bypass.
    prose = FENCE.sub(lambda m: "\n" * m.group(0).count("\n"), text)
    seen = [(m.group(1).strip(), m.start()) for m in re.finditer(r"^(## .+?)\s*$", prose, re.M)]
    positions = dict(seen)
    for h in FRAME_HEAD + FRAME_TAIL:
        if h not in positions:
            err(f"body: missing section '{h}' (outside code fences)")
    frame = [positions[h] for h in FRAME_HEAD + FRAME_TAIL if h in positions]
    if len(frame) == 4:
        if frame != sorted(frame):
            err("body: frame sections out of order; want Preamble, Envelope, …, Handshake, Expiry")
        elif not [p for _, p in seen if frame[1] < p < frame[2]]:
            err("body: no section of its own between '## Envelope' and '## Handshake' -- "
                "a prompt with no body is not a prompt")
    dupes = {h for h, _ in seen if [x for x, _ in seen].count(h) > 1}
    for h in sorted(dupes):
        err(f"body: section {h!r} appears more than once")

    flow = fm.get("flow", "")
    if flow and flow not in FLOWS:
        err(f"front matter: flow {flow!r} must be one of {sorted(FLOWS)} (FPA.md 3)")
    elif flow:
        missing = [h for h in FLOWS[flow] if h not in positions]
        if missing:
            note(f"body: flow '{flow}' conventionally uses {', '.join(missing)} -- "
                 "advisory only (FPA.md 3)")

    if "TART" not in text:
        warn("body: never addresses TART; a foreign prompt should speak to the runtime agent directly")
    if phrase and not re.search(rf"\b{re.escape(phrase)}\b", text, re.I):
        warn("body: never mentions its own confirmation phrase, so a reader cannot tell what "
             "the pilot had to type")
    hs = f"ADOPTED: {fm.get('id', '')} v{fm.get('version', '')}"
    if "id" in fm and "version" in fm and hs not in text:
        warn(f"body: the '## Handshake' section should show the computed line {hs!r}")

    if name not in ("-", "<stdin>") and not name.endswith(".prompt.md"):
        warn(f"{name}: conventional extension is '.prompt.md'")

    return errors, warnings, notes, fm


def main(argv):
    flags = {a for a in argv[1:] if a.startswith("-") and a != "-"}
    args = [a for a in argv[1:] if not a.startswith("-")] + (["-"] if "-" in argv[1:] else [])
    unknown = flags - {"-q", "--quiet", "-v", "--verbose", "--json", "--strict", "-h", "--help"}
    if unknown:
        print(f"fp-lint: unknown flag {sorted(unknown)[0]!r}", file=sys.stderr)
        return 2
    if not args or "-h" in flags or "--help" in flags:
        print(__doc__)
        return 0 if args else 2

    as_json, quiet = "--json" in flags, ("-q" in flags or "--quiet" in flags)
    strict, verbose = "--strict" in flags, ("-v" in flags or "--verbose" in flags)
    report, failed = {}, False

    for src in args:
        try:
            text = read_source(src)
        except Unreadable as exc:
            print(f"{src}: cannot read -- {exc}", file=sys.stderr)
            return 2

        errors, warnings, notes, fm = lint(text, src)
        report[src] = {"errors": errors, "warnings": warnings, "notes": notes,
                       "ok": not errors, "front_matter": fm}
        if errors or (strict and warnings):
            failed = True
        if as_json:
            continue
        for e in errors:
            print(f"{src}: ERROR: {e}")
        if not quiet:
            for w in warnings:
                print(f"{src}: WARN:  {w}")
            if verbose:
                for n in notes:
                    print(f"{src}: note:  {n}")
            if not errors:
                tail = f" ({len(warnings)} warning{'s' if len(warnings) != 1 else ''})" if warnings else ""
                # The confirmation phrase is deliberately not printed (FPA.md PV1).
                print(f"{src}: VALID{tail} -- well-formed {fm.get('flow', '?')} prompt "
                      f"'{fm.get('id', '?')}' v{fm.get('version', '?')}. Structure only: this says "
                      "nothing about intent. Read it.")

    if as_json:
        print(json.dumps(report, indent=2))
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as exc:  # noqa: BLE001 — a crash must not look like a rejection
        print(f"fp-lint: internal error: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(3)
