#!/usr/bin/env python3
"""fp-init-catalog — start a catalog of your own, served from your own domain.

    fp-init-catalog <dir> --url https://catalog.example.com [--identity NAME]

A catalog is a shape, not a privilege: a signed manifest and the documents it
lists, served as static files. This makes the shape, empty and already signed, so
the first thing you serve is a valid catalog with nothing in it. In <dir>:

    frompt-catalog.json   where it is served from, the signing identity, summaries
    prompts/              empty; fp-new -o prompts/ writes here
    index.json, .sig      the manifest, signed
    allowed_signers       your public key, published beside the manifest
    .fpa/signing_key      your private key -- gitignored, never committed or served
    .gitignore            .fpa/
    .nojekyll             without it GitHub Pages renders .md files instead of serving them
    CNAME                 your domain, for GitHub Pages (only for a bare https host)
    README.md             what this is and how to register it, fingerprint filled in
    .github/workflows/renew.yml   re-signs before the manifest expires, if given the key

--identity names the key in allowed_signers. It defaults to the URL's host, so
"signed by catalog.example.com" reads as what it is. The name is a label, not a
proof: the fingerprint is what a client registers.

It never commits, pushes or publishes. Serving the directory is your decision,
made with whatever already serves your static files.

Exit: 0 created · 1 refused (there is a catalog here already) · 2 bad usage or a tool failed.
"""
import json
import os
import pathlib
import subprocess
import sys
from urllib.parse import urlsplit

TOOLS = pathlib.Path(__file__).resolve().parent.parent

README = """# {name}

A catalog of foreign prompts -- frompts -- served from `{url}`.

A frompt is a prompt adopted on purpose by an agent that did not write it. This catalog is a
signed manifest (`index.json`, `index.json.sig`) and the documents it lists
(`prompts/<id>/<version>.frompt.md`). The protocol and the tools:
[frompt-org/frompt](https://github.com/frompt-org/frompt).

## Register it

The publisher key's fingerprint is

```
{fingerprint}
```

Confirm it somewhere other than this catalog: the fingerprint is the one thing a client must not
take from the host it is used to check. Then, with the tools from
[frompt-org/protocol](https://github.com/frompt-org/protocol) on your `PATH`:

```
fp-register {url} --key {fingerprint} --pin version
fp-lock --update <id> --from {url}
fp-resolve <id> --from {url}
```

## Publish to it

```
fp-new <id> -c <consent-sentence> -f <flow> -o prompts/
fp-index && fp-sign
git add -A && git commit && git push
```

A published version is immutable: a change is a new version. The manifest expires
{days} days after it is signed; `.github/workflows/renew.yml` re-signs it if you give CI the key,
or run `fp-index --renew && fp-sign` yourself.
"""

WORKFLOW = """# renew -- re-sign this catalog's manifest before it expires (FPA.md M6a).
#
# A manifest carries not_after, and past it every client refuses the catalog: that is
# what stops an old signed manifest being replayed. Something has to re-sign it. This
# job does, weekly, once fewer than ten days remain -- if you give it the key, as the
# repository secret FPA_SIGNING_KEY (the contents of .fpa/signing_key).
#
# A key in CI is a key your CI provider can use. If that is not acceptable, leave the
# secret unset: the job then only warns, and you renew by hand
# (fp-index --renew && fp-sign, then commit).
name: renew
on:
  schedule:
    - cron: "17 4 * * 1"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  renew:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: the tools, pinned to the commit this catalog was made with
        uses: actions/checkout@v4
        with:
          repository: frompt-org/protocol
          ref: {ref}
          path: .frompt-tools
      - name: renew if it expires within ten days
        env:
          FPA_SIGNING_KEY_MATERIAL: ${{{{ secrets.FPA_SIGNING_KEY }}}}
        run: |
          left=$(python3 -c "import json, datetime as d; t = d.datetime.strptime(json.load(open('index.json'))['not_after'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=d.timezone.utc); print((t - d.datetime.now(d.timezone.utc)).days)")
          echo "manifest expires in $left day(s)"
          [ "$left" -lt 10 ] || exit 0
          if [ -z "$FPA_SIGNING_KEY_MATERIAL" ]; then
            echo "::warning::manifest expires in $left day(s) and FPA_SIGNING_KEY is not set -- renew by hand"
            exit 0
          fi
          umask 077
          mkdir -p .fpa
          printf '%s\\n' "$FPA_SIGNING_KEY_MATERIAL" > .fpa/signing_key
          ssh-keygen -y -f .fpa/signing_key > .fpa/signing_key.pub
          .frompt-tools/bin/fp-index --renew
          .frompt-tools/bin/fp-sign
          rm -rf .fpa
          git config user.name renew
          git config user.email renew@frompt
          git add index.json index.json.sig INDEX.md allowed_signers
          git diff --cached --quiet || {{ git commit -m "renew manifest"; git push; }}
"""


def tools_ref():
    """A commit of frompt-org/protocol that exists upstream, so CI can fetch it:
    this checkout's HEAD if a remote has it, else the remote's main."""
    def git(*a):
        p = subprocess.run(["git", "-C", str(TOOLS), *a], capture_output=True, text=True)
        return p.stdout.strip() if p.returncode == 0 else ""
    head = git("rev-parse", "HEAD")
    if head and git("branch", "-r", "--contains", head):
        return head
    return git("rev-parse", "origin/main") or "main"


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    valued = {"--url", "--identity"}
    args = [a for i, a in enumerate(argv[1:], 1) if not a.startswith("-") and argv[i - 1] not in valued]
    if not args or "--url" not in argv or argv.index("--url") + 1 >= len(argv):
        print(__doc__, file=sys.stderr)
        return 2
    target = pathlib.Path(args[0]).expanduser().resolve()
    url = argv[argv.index("--url") + 1].rstrip("/")
    parts = urlsplit(url)
    identity = (argv[argv.index("--identity") + 1] if "--identity" in argv
                else parts.hostname or target.name)
    if not identity or any(c.isspace() or c == "," for c in identity):
        print(f"fp-init-catalog: identity {identity!r} cannot contain spaces or commas -- it is an "
              "allowed_signers principal", file=sys.stderr)
        return 2

    existing = [n for n in ("frompt-catalog.json", "index.json", ".fpa/signing_key")
                if (target / n).exists()]
    if (target / "prompts").is_dir() and any((target / "prompts").iterdir()):
        existing.append("prompts/")
    if existing:
        print(f"fp-init-catalog: {target} already holds a catalog ({', '.join(existing)}).\n"
              "  Refusing to overwrite it -- a new key would orphan every client that registered the old one.",
              file=sys.stderr)
        return 1

    (target / "prompts").mkdir(parents=True, exist_ok=True)
    (target / "prompts" / ".gitkeep").touch()
    days = 30
    config = {"url": url, "identity": identity, "validity_days": days, "summaries": {}}
    (target / "frompt-catalog.json").write_text(json.dumps(config, indent=2) + "\n")
    gitignore = target / ".gitignore"
    lines = gitignore.read_text().splitlines() if gitignore.exists() else []
    if ".fpa/" not in lines:
        gitignore.write_text("\n".join(lines + [".fpa/"]) + "\n")
    (target / ".nojekyll").touch()
    bare = parts.scheme == "https" and parts.path in ("", "/") and parts.hostname and not (
        parts.hostname.endswith(("github.io", "githubusercontent.com")))
    if bare and not (target / "CNAME").exists():
        (target / "CNAME").write_text(parts.hostname + "\n")

    env = dict(os.environ, FPA_CATALOG=str(target))
    env.pop("FPA_SIGNING_IDENTITY", None)
    for cmd in (["fp-index"], ["fp-sign", "--keygen"]):
        proc = subprocess.run([str(TOOLS / "bin" / cmd[0]), *cmd[1:]], env=env, cwd=target,
                              capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if proc.returncode != 0:
            sys.stderr.write(proc.stdout + proc.stderr)
            print(f"fp-init-catalog: {cmd[0]} failed in {target}", file=sys.stderr)
            return 2
    pub = target / ".fpa" / "signing_key.pub"
    fingerprint = subprocess.run(["ssh-keygen", "-lf", str(pub)], capture_output=True,
                                 text=True).stdout.split()[1]

    if not (target / "README.md").exists():
        (target / "README.md").write_text(README.format(
            name=identity, url=url, fingerprint=fingerprint, days=days))
    workflow = target / ".github" / "workflows" / "renew.yml"
    if not workflow.exists():
        workflow.parent.mkdir(parents=True, exist_ok=True)
        workflow.write_text(WORKFLOW.format(ref=tools_ref()))

    print(f"created a signed, empty catalog in {target}")
    print(f"  served from  {url}")
    print(f"  signed by    {identity} {fingerprint}")
    print(f"  private key  {target / '.fpa' / 'signing_key'} (gitignored -- back it up; losing it")
    print("               means every client re-registers a new one)")
    print("\nNext:")
    print(f"  cd {target}")
    print("  fp-new <id> -c <consent-sentence> -f <flow> -o prompts/   # write, or copy, frompts")
    print("  fp-index && fp-sign")
    print(f"  serve the directory at {url}, byte for byte")
    print(f"  publish {fingerprint} somewhere that is not the catalog")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
