#!/usr/bin/env bash
# fp-selftest -- conformance checks for fp-lint, fp-new and fp-docscheck.
#
# Every check asserts an EXACT exit code. Earlier versions accepted "nonzero" as
# proof a document was rejected, which meant a missing file or a crashing linter
# read as success. fp-lint's codes are: 0 valid, 1 findings, 2 unreadable/usage,
# 3 internal error.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The suite tests this checkout as its own catalog and its own workspace. Run from
# inside some other catalog, or with a workspace exported, the tools would find
# those instead (bin/fpa_roots.py) -- so neither may leak in.
unset FPA_CATALOG FPA_WORKSPACE FPA_SIGNING_IDENTITY
cd "$here" || exit 2
lint="$here/bin/fp-lint"
new="$here/bin/fp-new"
tmpl="$here/TEMPLATE.frompt.md"
fails=0
# Every scratch directory a tool makes during this run goes in one directory of the
# run's own, removed when it ends -- killed runs included.
suite_tmp=${TMPDIR:-/tmp}; suite_tmp=$(mktemp -d "${suite_tmp%/}/fp-selftest.XXXXXXXX") || exit 2
export TMPDIR="$suite_tmp"
trap 'rm -rf "$suite_tmp"' EXIT
trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM

check() { # check <name> <expected> <actual>
  if [ "$2" = "$3" ]; then printf 'ok   %s\n' "$1"
  else printf 'FAIL %s (expected exit %s, got %s)\n' "$1" "$2" "$3"; fails=$((fails + 1)); fi
}

# --- what must validate ------------------------------------------------------
"$lint" -q "$here"/prompts/*/*.frompt.md "$tmpl" >/dev/null 2>&1
check "bundled prompts and template are valid" 0 $?

# The fixture is hostile in content and structurally valid (it draws two warnings,
# so --strict would reject it). It passing the default check is the point: a
# structural validator cannot see intent, and this proves it in public.
"$lint" -q "$here/examples/03-refuse/hostile-sample.frompt.md.txt" >/dev/null 2>&1
check "hostile fixture passes structural validation (valid is not safe)" 0 $?

# --- exit-code taxonomy ------------------------------------------------------
"$lint" -q "$here/examples/does-not-exist.frompt.md" >/dev/null 2>&1
check "unreadable input exits 2, not 1" 2 $?
"$lint" --nonsense "$tmpl" >/dev/null 2>&1
check "unknown flag exits 2" 2 $?
"$lint" >/dev/null 2>&1
check "no arguments exits 2" 2 $?

# --- structural probes: each must be a finding, exit 1 -----------------------
probe() { # probe <name> [expected-exit] <sed program applied to the template>
  local want=1 prog="$2"
  if [ $# -eq 3 ]; then want="$2"; prog="$3"; fi
  sed "$prog" "$tmpl" | "$lint" -q - >/dev/null 2>&1
  check "probe: $1" "$want" $?
}
probe "unknown capability token"        's|^allow: .*|allow: read:everything|'
probe "capability in both allow and deny" 's|^allow: .*|allow: read:files, write:files|'
probe "consent sentence still in front matter" 's|^ceremony: .*|ceremony: standard\nconsent: i-have-read-this-and-accept-it|'
probe "malformed semver"                's|^version: .*|version: 1x.2y.3z|'
probe "missing marker"                  '1d'
probe "unknown flow"                    's|^flow: .*|flow: freestyle|'
probe "write:artifact under persistence none" 's|^allow: .*|allow: read:files, write:artifact|'

# A heading that exists only inside a code fence is an example, not structure.
printf '%s\n' '<!-- FOREIGN-PROMPT v1 -->' '---' 'id: fenced' 'version: 1.0.0' \
  'confirmation: quiet-anvil' 'flow: linear' 'expiry: session' 'envelope: strict' \
  'allow: read:files' 'deny: write:files, net:post, secrets:read' '---' '' \
  '## Preamble' 'TART, quiet-anvil.' '' '```' '## Envelope' '## Handshake' '## Expiry' '```' \
  | "$lint" -q - >/dev/null 2>&1
check "probe: sections hidden inside a code fence do not count" 1 $?

# A frame with nothing between Envelope and Handshake is not a prompt.
printf '%s\n' '<!-- FOREIGN-PROMPT v1 -->' '---' 'id: hollow' 'version: 1.0.0' \
  'confirmation: quiet-anvil' 'flow: linear' 'expiry: session' 'envelope: strict' \
  'allow: read:files' 'deny: write:files, net:post, secrets:read' '---' '' \
  '## Preamble' 'TART, quiet-anvil.' '' '## Envelope' 'x' '' '## Handshake' 'ADOPTED: hollow v1.0.0' \
  '' '## Expiry' 'session' | "$lint" -q - >/dev/null 2>&1
check "probe: empty body is a finding" 1 $?

# --- the scaffolder ----------------------------------------------------------
for flow in linear loop state-machine rubric interpreter interview; do
  "$new" "demo-$flow" -c "i-have-read-the-$flow-demo-and-accept-what-it-does" -f "$flow" \
    --author ci 2>/dev/null | "$lint" -q - >/dev/null 2>&1
  check "fp-new -f $flow scaffolds a valid prompt" 0 $?
done
scaf=$(mktemp -d 2>/dev/null || echo "/tmp/fp-scaf-$$")
"$new" demo-out -c i-have-read-this-and-accept-what-it-does -o "$scaf" --author ci >/dev/null 2>&1
[ -f "$scaf/demo-out/1.0.0.frompt.md" ]
check "fp-new -o writes <dir>/<id>/<version>.frompt.md, the layout fp-index reads" 0 $?
rm -rf "$scaf"
"$new" demo -c i-have-read-this-and-accept-what-it-does --author 'A/B & Co\' >/dev/null 2>&1
check "fp-new survives an author containing / & and backslash" 0 $?
"$new" demo -c i-have-read-this-and-accept-what-it-does --version 1x.2y.3z >/dev/null 2>&1
check "fp-new rejects malformed semver" 2 $?
"$new" demo -c zebra >/dev/null 2>&1
check "fp-new rejects a bare word as a consent sentence" 2 $?

# -c was silently a no-op once, because it substituted a literal the template no
# longer contained. The scaffolder now reads the sentence to replace out of the
# template, and this check is what would have caught it.
# Capture first: piping straight into `grep -q` kills the writer with SIGPIPE and
# reports 141, which is neither pass nor fail but looked like both.
scaffolded=$("$new" demo -c i-have-read-this-and-want-my-work-picked-apart --author ci 2>/dev/null)
printf '%s' "$scaffolded" | grep -q "^i-have-read-this-and-want-my-work-picked-apart"
check "fp-new -c actually replaces the template's consent sentence" 0 $?
default_sentence=$(awk '/^## Consent/{f=1} f && /^i-/{print; exit}' "$tmpl")
printf '%s' "$scaffolded" | grep -q "$default_sentence" && keep=1 || keep=0
check "fp-new output does not keep the template's default sentence" 0 "$keep"
TMPDIR=/nonexistent-on-purpose "$new" demo-loop -c i-have-read-this-and-accept-what-it-does \
  -f loop --author ci 2>/dev/null \
  | "$lint" -q - >/dev/null 2>&1
check "fp-new works without a writable temp dir" 0 $?

# --- regressions: every defect the reviews found, as an assertion -----------
probe "valid semver with a prerelease is accepted" 0 's|^version: .*|version: 1.0.0-rc.1|'
probe "leading zeros in semver"          's|^version: .*|version: 01.0.0|'
probe "marker not at column 1"           '1s|^| |'
probe "YAML anchor in front matter"      's|^author: .*|author: \&a Publisher|'
probe "capability 'none' beside others"  's|^allow: .*|allow: none, read:files|'
sed 's|^allow: .*|allow: none|' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "a prompt needing no capability can say 'none'" 0 $?
awk '{if ($0=="## Envelope") print "~~~"; print}' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "probe: an unclosed code fence is a finding" 1 $?
awk '/^## Consent/{c=1} c && /^i-/{sub(/^i-/, "adopt-"); } {print}' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "probe: a consent sentence opening with a forbidden verb" 1 $?
awk '{print} END{}' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "the template's own consent section is accepted" 0 $?
awk '/^## Consent/{exit} {print}' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "probe: a prompt with no Consent section at all" 1 $?
sed -e 's|^ceremony: .*|ceremony: light|' -e 's|^allow: .*|allow: read:files, write:files|' \
    -e 's|^deny: write:files, |deny: |' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "probe: ceremony light on a prompt that writes (CE1)" 1 $?
sed 's|^ceremony: .*|ceremony: theatrical|' "$tmpl" | "$lint" -q - >/dev/null 2>&1
check "probe: unknown ceremony level" 1 $?

# --- the index must not drift from the prompts it indexes --------------------
"$here/bin/fp-index" --check >/dev/null 2>&1
check "INDEX.md digests match the prompts" 0 $?

# --- the pilot-side adopt tool composes a phrase per ceremony ----------------
adopt_std=$("$here/bin/fp-adopt" "$here/prompts/repo-recon/1.1.0.frompt.md" --quiet 2>/dev/null)
printf '%s' "$adopt_std" | grep -q "repo-recon-[0-9a-f]\{7\} "
check "fp-adopt composes a standard-ceremony phrase" 0 $?
adopt_strict=$("$here/bin/fp-adopt" "$here/prompts/ticket-intake/1.0.0.frompt.md" --quiet 2>/dev/null)
printf '%s' "$adopt_strict" | grep -q "ticket-intake-[0-9a-f]\{64\} "
check "fp-adopt composes a strict-ceremony phrase" 0 $?
adopt_light=$("$here/bin/fp-adopt" "$here/prompts/grill-me/1.0.0.frompt.md" --quiet 2>/dev/null)
printf '%s' "$adopt_light" | grep -q "grill-me-" && light_has_id=1 || light_has_id=0
check "fp-adopt omits id and digest at ceremony light" 0 "$light_has_id"

# A body hidden inside an HTML comment is invisible to every reader except a
# line-oriented regex.
printf '%s\n' '<!-- FOREIGN-PROMPT v1 -->' '---' 'id: hidden' 'version: 1.0.0' \
  'confirmation: sneaky-headings' 'flow: linear' 'expiry: session' 'envelope: strict' \
  'allow: none' 'deny: none' '---' '' '<!--' '## Preamble' 'TART sneaky-headings' '' \
  '## Envelope' 'x' '' '## Steps' 'do' '' '## Handshake' 'ADOPTED: hidden v1.0.0' '' \
  '## Expiry' 'session' '-->' | "$lint" -q - >/dev/null 2>&1
check "probe: sections hidden in an HTML comment do not count" 1 $?

# --- docs describe the tool that exists --------------------------------------
"$here/bin/fp-claimcheck" "$here" >/dev/null 2>&1
check "docs claims match the implementation" 0 $?

claimscratch=$(mktemp -d 2>/dev/null || echo "/tmp/fp-claims-$$")
mkdir -p "$claimscratch/bin"
cp "$here/FPA.md" "$claimscratch/FPA.md"
cp "$here/bin/fp-lint" "$claimscratch/bin/fp-lint"
printf '%s\n' 'It makes it secure, and typing it proves the pilot read the page.' \
  'This protocol is not a toy, it makes the agent secure against attacks.' \
  'This is a foreign prompt (FPA v1). Hold the instructions below.' \
  'Front matter:' '```' '<!-- FOREIGN-PROMPT v1 -->' 'isolation: subagent' 'allow: read files' '```' \
  > "$claimscratch/rot.md"
"$here/bin/fp-claimcheck" "$claimscratch" >/dev/null 2>&1
check "claimcheck catches a protection claim, a stale version, a cut key and English capabilities" 1 $?

# The template is the thing every new prompt is born from, so it is checked the
# way a prompt is: valid, adoptable, and free of the prose rot that outlives a
# scripted rename.
"$lint" -q "$tmpl" >/dev/null 2>&1
check "the template is a valid prompt" 0 $?
adopt_tmpl=$("$here/bin/fp-adopt" "$tmpl" --quiet 2>/dev/null)
printf '%s' "$adopt_tmpl" | grep -q "my-prompt-[0-9a-f]\{7\} "
check "the template composes a phrase at its declared ceremony" 0 $?
rm -rf "$claimscratch"

# --- the resolver: mode 3's deterministic half ------------------------------
"$here/bin/fp-resolve" pr-review --base "$here/prompts" --record >/dev/null 2>&1
check "fp-resolve verifies a prompt against the published digest" 0 $?
"$here/bin/fp-resolve" no-such-prompt --record >/dev/null 2>&1
check "fp-resolve refuses an id the index does not carry" 1 $?

# The newest pr-review, from the manifest -- these checks once named 2.0.0 and broke
# the day 2.0.1 was published.
prl=$(python3 -c "import json,sys; m=json.load(open(sys.argv[1])); print([p for p in m['prompts'] if p['id']=='pr-review'][0]['latest'])" "$here/index.json")
tamper=$(mktemp -d 2>/dev/null || echo "/tmp/fp-tamper-$$"); mkdir -p "$tamper"
mkdir -p "$tamper/pr-review"
cp "$here/prompts/pr-review/1.2.0.frompt.md" "$tamper/pr-review/$prl.frompt.md"
printf '\n<!-- published by nobody -->\n' >> "$tamper/pr-review/$prl.frompt.md"
"$here/bin/fp-resolve" pr-review --base "$tamper" --record >/dev/null 2>&1
check "fp-resolve refuses bytes the index did not vouch for" 1 $?
rm -rf "$tamper"

probe "unknown adoption context" 's|^ceremony: .*|ceremony: standard\ncontexts: unattended|'

# --- registered: a pin bounds a consent given once ---------------------------
"$here/bin/fp-lock" --check >/dev/null 2>&1
check "fpa.lock is in sync with the prompts" 0 $?
"$here/bin/fp-resolve" pr-review --base "$here/prompts" --lock --record >/dev/null 2>&1
check "fp-resolve --lock accepts a prompt at its pin" 0 $?

moved=$(mktemp -d 2>/dev/null || echo "/tmp/fp-moved-$$"); mkdir -p "$moved"
cp -R "$here"/prompts/. "$moved/"
printf '\n<!-- moved since it was pinned -->\n' >> "$moved/pr-review/$(awk '$1=="pr-review" {print $2; exit}' "$here/fpa.lock").frompt.md"
"$here/bin/fp-resolve" pr-review --base "$moved" --lock --record >/dev/null 2>&1
check "fp-resolve --lock refuses a prompt that moved" 1 $?
rm -rf "$moved"

# --- managed: a signature authorizes a publisher, not a document -------------
if [ -f "$here/index.json.sig" ] && [ -f "$here/allowed_signers" ]; then
  "$here/bin/fp-verify" >/dev/null 2>&1 </dev/null
  check "the signed manifest verifies against allowed_signers" 0 $?
  "$here/bin/fp-verify" pr-review --base "$here/prompts" >/dev/null 2>&1 </dev/null
  check "fp-verify authorizes a prompt present in the signed manifest" 0 $?
  "$here/bin/fp-verify" no-such-prompt --base "$here/prompts" >/dev/null 2>&1 </dev/null
  check "fp-verify refuses a prompt absent from the manifest" 1 $?

  tampered=$(mktemp -d 2>/dev/null || echo "/tmp/fp-tamper2-$$"); mkdir -p "$tampered/bin"
  cp "$here"/index.json "$here"/index.json.sig "$here"/allowed_signers "$tampered/"
  cp "$here"/bin/fp-verify "$here"/bin/fpa_roots.py "$tampered/bin/"
  python3 - "$tampered/index.json" <<'PY'
import json, sys
p = sys.argv[1]
m = json.load(open(p))
m["prompts"][0]["digest"] = "0" * 64
json.dump(m, open(p, "w"), indent=2, sort_keys=True)
PY
  (cd "$tampered" && ./bin/fp-verify >/dev/null 2>&1 </dev/null)
  check "a manifest edited after signing fails verification" 1 $?
  rm -rf "$tampered"
else
  echo "skip -- no signature present; run bin/fp-sign to enable the managed checks"
fi

# --- identity and the adoption record ---------------------------------------
FPA_AGENT_NAME=selftest "$here/bin/fp-agent" --ensure >/dev/null 2>&1
check "fp-agent mints an identity" 0 $?
"$here/bin/fp-agent" --id >/dev/null 2>&1
check "fp-agent reports the id it minted" 0 $?
"$here/bin/fp-record" selftest-prompt 1.0.0 abc123abc123 managed ./selftest >/dev/null 2>&1
check "fp-record appends an adoption" 0 $?
"$here/bin/fp-record" selftest-prompt 1.0.0 abc123abc123 wishful ./selftest >/dev/null 2>&1
check "fp-record rejects an authorization it does not recognise" 2 $?
"$here/bin/fp-record" --list >/dev/null 2>&1
check "fp-record lists what this agent adopted" 0 $?

# --- the plugin ships what it claims -----------------------------------------
python3 - "$here" <<'PY' >/dev/null 2>&1
import json, pathlib, sys
root = pathlib.Path(sys.argv[1]) / "plugin"
manifest = json.loads((root / ".claude-plugin" / "plugin.json").read_text())
assert manifest["name"] and manifest["description"] and manifest["version"]
named = {"find", "prompt", "adopted"}
found = {p.parent.name for p in root.glob("skills/*/SKILL.md")}
assert named == found, f"{named} != {found}"
for p in root.glob("skills/*/SKILL.md"):
    head = p.read_text().split("---")[1]
    assert "name:" in head and "description:" in head, p
PY
check "the plugin manifest and its three skills are well formed" 0 $?
bash "$here/plugin/hooks/session-start.sh" >/dev/null 2>&1 </dev/null
check "the session-start hook runs and reports context" 0 $?

# --- integrity: the digest must cover bytes, not a normalization --------------
crlf=$(mktemp -d 2>/dev/null || echo "/tmp/fp-crlf-$$"); mkdir -p "$crlf"
python3 - "$here" "$crlf" "$prl" <<'PY'
import pathlib, sys
src = pathlib.Path(sys.argv[1]) / "prompts" / "pr-review" / f"{sys.argv[3]}.frompt.md"
dst = pathlib.Path(sys.argv[2]) / "pr-review" / f"{sys.argv[3]}.frompt.md"
dst.parent.mkdir(parents=True, exist_ok=True)
dst.write_bytes(src.read_bytes().replace(b"\n", b"\r\n"))
PY
"$here/bin/fp-resolve" pr-review --base "$crlf" --record >/dev/null 2>&1
check "a CRLF variant does not pass as its LF original" 1 $?
rm -rf "$crlf"

"$here/bin/fp-resolve" "$here/README.md" --record >/dev/null 2>&1
check "fp-resolve refuses bytes nothing ever vouched for" 1 $?

# --- context fitness: a pin and a signature only authorize what fits ----------
"$here/bin/fp-resolve" help-me --base "$here/prompts" --lock --record >/dev/null 2>&1
check "a pin does not authorize an interactive-only prompt" 1 $?
"$here/bin/fp-verify" help-me --base "$here/prompts" >/dev/null 2>&1 </dev/null
check "a signature does not authorize an interactive-only prompt" 1 $?
"$here/bin/fp-verify" pr-review --base >/dev/null 2>&1 </dev/null
check "fp-verify exits 2 when it cannot check, not 1" 2 $?

# --- late binding: the manifest comes from the publisher ---------------------
# A catalog's base is the address it is served from, so a copy of this checkout's
# catalog read from a directory is a catalog of its own. mirror <dir> publishes one
# there -- base <dir>/prompts -- signed by a key this run makes, as frompt-mirror.
# openws: a workspace that trusts what this checkout trusts and that key, and
# keeps no register, so a catalog is checked on its own merits.
mk=$(mktemp -d 2>/dev/null || echo "/tmp/fp-mk-$$"); mkdir -p "$mk"
ssh-keygen -q -t ed25519 -N "" -C frompt-mirror -f "$mk/key" >/dev/null 2>&1
mresign() { rm -f "$1/index.json.sig"; ssh-keygen -Y sign -f "${2:-$mk/key}" -n foreign-prompts "$1/index.json" >/dev/null 2>&1; }
mset() { # mset <dir> <python statement on m>: edit a mirror's manifest, then re-sign it
  python3 -c 'import json, sys
m = json.load(open(sys.argv[1])); exec(sys.argv[2])
open(sys.argv[1], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")' "$1/index.json" "$2"
  mresign "$1"; }
mirror() { mkdir -p "$1/prompts"; cp -R "$here"/prompts/. "$1/prompts/"
  cp "$here/index.json" "$1/index.json"; mset "$1" "m['base'] = '$1/prompts'"; }
openws() { local d; d=$(mktemp -d 2>/dev/null || echo "/tmp/fp-ows-$$-$RANDOM"); mkdir -p "$d"
  cp "$here/allowed_signers" "$d/"
  printf 'frompt-mirror namespaces="foreign-prompts" %s\n' "$(cut -d' ' -f1,2 "$mk/key.pub")" >> "$d/allowed_signers"
  printf '%s' "$d"; }
pub=$(mktemp -d 2>/dev/null || echo "/tmp/fp-pub-$$"); mirror "$pub"
ows=$(openws)
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$pub" >/dev/null 2>&1 </dev/null
check "fp-verify --from fetches a publisher manifest and authorizes against it" 0 $?
printf '\n<!-- unsigned change -->\n' >> "$pub/prompts/repo-recon/1.1.0.frompt.md"
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$pub" >/dev/null 2>&1 </dev/null
check "fp-verify --from refuses a document the fetched manifest did not vouch for" 1 $?
rm -rf "$pub" "$ows"

# --- freshness: a validly signed but older manifest is a replay --------------
old=$(mktemp -d 2>/dev/null || echo "/tmp/fp-old-$$"); mirror "$old"
kept=$(mktemp -d 2>/dev/null || echo "/tmp/fp-kept-$$"); cp "$old/index.json" "$old/index.json.sig" "$kept/"
ows=$(openws)
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$old" >/dev/null 2>&1 </dev/null
mset "$old" 'm["serial"] += 1'
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$old" >/dev/null 2>&1 </dev/null; r1=$?
cp "$kept/index.json" "$kept/index.json.sig" "$old/"
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$old" >/dev/null 2>&1 </dev/null
check "a validly signed but older manifest is refused as a rollback" "0 1" "$r1 $?"
rm -rf "$old" "$kept" "$ows"

# --- the lock pins only what declares the registered context -----------------
python3 - "$here" <<'PY' >/dev/null 2>&1
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
pinned = {l.split()[0] for l in (root / "fpa.lock").read_text().splitlines()
          if l.strip() and not l.startswith("#")}
fit = {p["id"] for p in json.loads((root / "index.json").read_text())["prompts"]
       if "registered" in [c.strip() for c in p["versions"][0]["contexts"].split(",")]}
assert pinned == fit, f"{pinned ^ fit} differ"
PY
check "fpa.lock pins exactly the prompts fit for the registered context" 0 $?

# --- transports: the digest is the constant, the fetcher is not --------------
# A regression this check would have caught immediately: narrowing the document
# path to gh: broke every other --from, because a local base fell through to the
# manifest's own unreachable URL.
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  ghout=$("$here/bin/fp-lint" "gh:frompt-org/catalog@main/prompts/repo-recon/1.1.0.frompt.md" 2>&1)
  printf '%s' "$ghout" | grep -q "VALID"
  check "gh: transport reads a document from a private catalog" 0 $?
else
  echo "skip -- gh not authenticated; private-transport check needs it"
fi

# --- freshness is per catalog, not per client --------------------------------
# Two catalogs, two serial lines. One global floor meant a brand new catalog
# starting at 1 read as a rollback of an unrelated one already at 45.
two=$(mktemp -d 2>/dev/null || echo "/tmp/fp-two-$$"); mirror "$two/a"; mirror "$two/b"
mset "$two/b" 'm["serial"] = 1'
ows=$(openws)
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$two/a" >/dev/null 2>&1 </dev/null
check "a catalog at a high serial is accepted" 0 $?
python3 - "$ows" "$two" <<'PY' >/dev/null 2>&1
import json, pathlib, sys
floors = pathlib.Path(sys.argv[1]) / ".fpa" / "manifest-serials.json"
data = json.loads(floors.read_text()) if floors.exists() else {}
assert any(v > 1 for v in data.values()), "expected a high floor recorded for some catalog"
PY
check "the floor it recorded is keyed by that catalog" 0 $?
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$two/b" >/dev/null 2>&1 </dev/null
check "  and another catalog starting at serial 1 is not a rollback of it" 0 $?
rm -rf "$two" "$ows"

# --- expiry: the half of freshness that needs no memory ----------------------
exp=$(mktemp -d 2>/dev/null || echo "/tmp/fp-exp-$$"); mirror "$exp"
ows=$(openws)
mset "$exp" 'm["not_after"] = "2001-01-01T00:00:00Z"'
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$exp" >/dev/null 2>&1 </dev/null
check "a validly signed but expired manifest is refused" 1 $?
mset "$exp" 'import datetime as d; m["not_after"] = (d.datetime.utcnow() + d.timedelta(days=30)).strftime("%Y-%m-%dT%H:%M:%SZ")'
FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$exp" >/dev/null 2>&1 </dev/null
check "a manifest inside its validity window is accepted" 0 $?
rm -rf "$exp" "$ows"

# --- registration: the record that someone agreed once -----------------------
reg=$(mktemp -d 2>/dev/null || echo "/tmp/fp-reg-$$"); mirror "$reg"
if [ -f "$here/fpa.registered" ]; then
  "$here/bin/fp-verify" repo-recon --from "$reg" >/dev/null 2>&1 </dev/null
  check "an unregistered catalog is refused once the workspace keeps a register" 1 $?
  "$here/bin/fp-verify" repo-recon --from "$reg" --registering >/dev/null 2>&1 </dev/null
  check "no flag skips the register: an option fp-verify does not have is a usage error" 2 $?
else
  echo "skip -- no fpa.registered in this workspace"
fi
rm -rf "$reg"

# --- two publishers, one trust root ------------------------------------------
# fp-verify once checked the first key in allowed_signers only, so a second catalog
# under its own key was "NOT signed by" the first catalog's publisher; and
# fp-register recorded the first local key's fingerprint, never the signing key's.
if [ -f "$here/.fpa/signing_key" ] && [ -f "$here/fpa.registered" ]; then
  cp "$here/allowed_signers" "$here/allowed_signers.selftest-bak"
  cp "$here/fpa.registered" "$here/fpa.registered.selftest-bak"
  sp=$(mktemp -d 2>/dev/null || echo "/tmp/fp-sp-$$"); mkdir -p "$sp/prompts"
  cp -R "$here"/prompts/. "$sp/prompts/"
  python3 -c 'import json, sys
m = json.load(open(sys.argv[1])); m["base"] = sys.argv[3]
open(sys.argv[2], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")' "$here/index.json" "$sp/index.json" "$sp/prompts"
  ssh-keygen -q -t ed25519 -N "" -C second-publisher -f "$sp/key2" >/dev/null 2>&1
  ssh-keygen -Y sign -f "$sp/key2" -n foreign-prompts "$sp/index.json" >/dev/null 2>&1
  ows=$(openws)
  FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$sp" >/dev/null 2>&1 </dev/null
  check "a publisher whose key is not in the local trust root is refused" 1 $?
  printf 'second-publisher %s\n' "$(cat "$sp/key2.pub")" >> "$here/allowed_signers"
  rm -rf "$ows"; ows=$(openws)
  out=$(FPA_WORKSPACE="$ows" "$here/bin/fp-verify" repo-recon --from "$sp" 2>/dev/null </dev/null); rc=$?
  rm -rf "$ows"
  [ $rc -eq 0 ] && printf '%s' "$out" | grep -q 'signed by second-publisher SHA256:'
  check "with two keys in the trust root, verification names the one that actually signed" 0 $?
  "$here/bin/fp-register" "$sp" --pin latest --as selftest >/dev/null 2>&1 </dev/null
  want=$(ssh-keygen -lf "$sp/key2.pub" | awk '{print $2}')
  grep -q "^$sp $want " "$here/fpa.registered"
  check "registration records the signing key's fingerprint, not the first local key's" 0 $?
  ssh-keygen -q -t ed25519 -N "" -C second-publisher-rotated -f "$sp/key3" >/dev/null 2>&1
  printf 'second-publisher-rotated %s\n' "$(cat "$sp/key3.pub")" >> "$here/allowed_signers"
  rm -f "$sp/index.json.sig"; ssh-keygen -Y sign -f "$sp/key3" -n foreign-prompts "$sp/index.json" >/dev/null 2>&1
  "$here/bin/fp-verify" repo-recon --from "$sp" >/dev/null 2>&1 </dev/null
  check "a catalog re-signed with a different trusted key is refused: registered key wins (AC2b)" 1 $?
  mv "$here/allowed_signers.selftest-bak" "$here/allowed_signers"
  mv "$here/fpa.registered.selftest-bak" "$here/fpa.registered"
  rm -rf "$sp"
else
  echo "skip -- two-publisher checks need a signing key and fpa.registered"
fi

# --- fp-sign must not drop other publishers from the trust root ---------------
if [ -f "$here/.fpa/signing_key" ]; then
  cp "$here/allowed_signers" "$here/allowed_signers.selftest-bak"
  printf 'someone-else ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n' >> "$here/allowed_signers"
  (cd "$here" && bin/fp-sign </dev/null >/dev/null 2>&1)
  grep -q '^someone-else ' "$here/allowed_signers" && [ "$(grep -c '^foreign-prompts-publisher ' "$here/allowed_signers")" -eq 1 ]
  check "fp-sign replaces its own line in allowed_signers and keeps every other publisher's" 0 $?
  mv "$here/allowed_signers.selftest-bak" "$here/allowed_signers"
fi

# --- fp-resolve --from: the registered context resolves the registered catalog,
# from a manifest that was verified first. "Register, then fp-resolve" once read
# the checkout's own index; then it read the publisher's JSON without checking
# the signature, the registered key, expiry or context fitness. Two reviewers
# found each in turn.
rf=$(mktemp -d 2>/dev/null || echo "/tmp/fp-rf-$$"); mirror "$rf"
rw=$(openws); printf '# fpa.registered\n' > "$rw/fpa.registered"
fp=$(ssh-keygen -lf "$mk/key.pub" | awk '{print $2}')

FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" pr-review --from "$rf" --record >/dev/null 2>&1
check "--from an unregistered catalog is refused once the workspace keeps a register" 1 $?
printf '%s %s latest 2026-01-01 selftest\n' "$rf" "$fp" >> "$rw/fpa.registered"

out=$(FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" pr-review --from "$rf" --record 2>/dev/null); rc=$?
[ $rc -eq 0 ] && printf '%s' "$out" | grep -q "source=$rf/prompts/" && printf '%s' "$out" | grep -q 'verified=registered'
check "--from resolves against the registered catalog's own verified manifest" 0 $?

FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" --list --from "$rf" 2>/dev/null | grep -q '^pr-review '
check "--list --from lists the registered catalog, not the catalog address as an id" 0 $?

FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" ghost-in-the-gist --from "$rf" --record >/dev/null 2>&1
check "a floating registration does not authorize a frompt that never offered 'registered' (AC4b)" 1 $?

cp "$rf/index.json" "$rf/index.json.orig"
python3 -c "import json,sys; p=sys.argv[1]; m=json.load(open(p)); m['prompts'][0]['versions'][0]['digest']='0'*64; open(p,'w').write(json.dumps(m,indent=2,sort_keys=True)+'\n')" "$rf/index.json"
FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" pr-review --from "$rf" --record >/dev/null 2>&1
check "a manifest edited after signing is refused before anything resolves from it" 1 $?
mv "$rf/index.json.orig" "$rf/index.json"

ssh-keygen -q -t ed25519 -N "" -C intruder -f "$mk/intruder" >/dev/null 2>&1
printf 'intruder %s\n' "$(cat "$mk/intruder.pub")" >> "$rw/allowed_signers"
mresign "$rf" "$mk/intruder"
FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" pr-review --from "$rf" --record >/dev/null 2>&1
check "a catalog re-signed by another trusted key is refused: the registered key wins (AC2b)" 1 $?
mresign "$rf"

rm -f "$rf/index.json.sig"
FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" pr-review --from "$rf" --record >/dev/null 2>&1
check "an unsigned catalog cannot be resolved from: cannot check is exit 2, not a fallback" 2 $?
mresign "$rf"

sed -i.bak "s#^$rf .* latest 2026-01-01 selftest\$#$rf $fp version 2026-01-01 selftest#" "$rw/fpa.registered" && rm -f "$rw/fpa.registered.bak"
FPA_WORKSPACE="$rw" "$here/bin/fp-lock" --update pr-review --from "$rf" >/dev/null 2>&1
pinned=$(awk '$1=="pr-review" {print $2; exit}' "$rw/fpa.lock" 2>/dev/null)
other=$(python3 -c 'import json, sys
e = [p for p in json.load(open(sys.argv[1]))["prompts"] if p["id"] == "pr-review"][0]
print(next(v["version"] for v in e["versions"] if v["version"] != sys.argv[2]))' "$rf/index.json" "$pinned")
FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" "pr-review@$other" --from "$rf" --record >/dev/null 2>&1
check "pin mode 'version' refuses a version that is not the pinned one (M5)" 1 $?
FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" "pr-review@$pinned" --from "$rf" --record >/dev/null 2>&1
check "pin mode 'version' accepts the pinned version" 0 $?

# The same signed bytes, served by another registered catalog: the pin names
# where it was taken from, and that is not here.
rf2=$(mktemp -d 2>/dev/null || echo "/tmp/fp-rf2-$$"); mirror "$rf2"
printf '%s %s version 2026-01-01 selftest\n' "$rf2" "$fp" >> "$rw/fpa.registered"
out=$(FPA_WORKSPACE="$rw" "$here/bin/fp-resolve" "pr-review@$pinned" --from "$rf2" --record 2>&1); rc=$?
[ $rc -eq 1 ] && printf '%s' "$out" | grep -q 'pinned from a different publisher'
check "a pin from one publisher does not authorize the same bytes from another (M5 origin)" 0 $?
rm -rf "$rf" "$rf2" "$rw"

# --- versions: choosing is exact or latest, and nothing else -----------------
"$here/bin/fp-resolve" pr-review@1.2.0 --base "$here/prompts" --record >/dev/null 2>&1
check "fp-resolve picks an exact version" 0 $?
sel=$("$here/bin/fp-resolve" pr-review@latest --base "$here/prompts" --record 2>/dev/null)
printf '%s' "$sel" | grep -q "version=$prl"
check "fp-resolve@latest picks the newest published version" 0 $?
"$here/bin/fp-resolve" pr-review@9.9.9 --base "$here/prompts" --record >/dev/null 2>&1
check "fp-resolve refuses a version nobody published" 1 $?
"$here/bin/fp-verify" pr-review@1.3.0 --base "$here/prompts" >/dev/null 2>&1 </dev/null
check "fp-verify authorizes an exact version from the signed manifest" 0 $?
"$here/bin/fp-verify" pr-review@1.9.9 --base "$here/prompts" >/dev/null 2>&1 </dev/null
check "fp-verify refuses a version absent from the signed manifest" 1 $?
python3 - "$here" <<'PY' >/dev/null 2>&1
import json, pathlib, sys
m = json.loads((pathlib.Path(sys.argv[1]) / "index.json").read_text())
e = [p for p in m["prompts"] if p["id"] == "pr-review"][0]
digests = {v["digest"] for v in e["versions"]}
assert len(digests) == len(e["versions"]) >= 3, "versions must be distinct documents"
assert e["latest"] == max(e["versions"], key=lambda v: tuple(int(x) for x in v["version"].split(".")))["version"]
PY
check "every published version is a distinct document, and latest is the newest" 0 $?

# --- docs integrity ----------------------------------------------------------
"$here/bin/fp-docscheck" "$here" >/dev/null 2>&1
check "repo docs: references resolve, links exist" 0 $?

scratch=$(mktemp -d 2>/dev/null || echo "/tmp/fp-selftest-$$") && mkdir -p "$scratch"
cp "$here/FPA.md" "$scratch/FPA.md"
printf '%s\n' 'See FPA.md §999 and §ZZ9.' '[dead](nope.md)' > "$scratch/rot.md"
"$here/bin/fp-docscheck" "$scratch" >/dev/null 2>&1
check "docscheck catches a bad section, a bad rule and a dead link" 1 $?
rm -rf "$scratch"

# --- fp-publish must refuse before it copies, not after -----------------------
# It once compared and copied in the same loop, so the immutability refusal was
# printed over a catalog it had already overwritten.
pubscratch=$(mktemp -d 2>/dev/null || echo "/tmp/fp-pub-$$"); mkdir -p "$pubscratch/prompts/repo-recon"
printf 'not the published bytes\n' > "$pubscratch/prompts/repo-recon/1.1.0.frompt.md"
"$here/bin/fp-publish" "$pubscratch" >/dev/null 2>&1; rc=$?
[ "$rc" -eq 1 ] && [ "$(cat "$pubscratch/prompts/repo-recon/1.1.0.frompt.md")" = "not the published bytes" ] \
  && [ ! -e "$pubscratch/prompts/pr-review" ]
check "fp-publish refuses a changed version before copying anything" 0 $?
rm -rf "$pubscratch"

# --- fp-assay: data, never prose (FPA.md AT3) ---------------------------------
if command -v skillspector >/dev/null 2>&1; then
  assay=$(mktemp -d 2>/dev/null || echo "/tmp/fp-assay-$$")
  "$here/bin/fp-assay" "$here/examples/03-refuse/hostile-sample.frompt.md.txt" -o "$assay" >/dev/null 2>&1
  python3 - "$assay" <<'PYEOF'
import glob, json, sys
files = [f for f in glob.glob(sys.argv[1] + "/*.json")]
a = json.load(open(files[0]))
banned = {"explanation", "remediation", "recommendation", "finding", "code_snippet", "pattern"}
leaks = banned & set(a) | {k for i in a["issues"] for k in i} & banned
assert not leaks, leaks
assert "ignore all previous" not in json.dumps(a).lower()
assert a["kind"] == "static-scan" and a["digest"] and a["severity"]
PYEOF
  check "fp-assay writes data only: no explanation, remediation, or quoted document text" 0 $?
  rm -rf "$assay"
else
  echo "skip fp-assay: skillspector not installed"
fi

# --- fp-publish --only publishes what was named and nothing else ---------------
onlycat=$(mktemp -d 2>/dev/null || echo "/tmp/fp-only-$$")
"$here/bin/fp-publish" "$onlycat" --only grill-me >/dev/null 2>&1
[ -d "$onlycat/prompts/grill-me" ] && [ "$(ls "$onlycat/prompts" | wc -l | tr -d ' ')" = "1" ]
check "fp-publish --only stages the named frompts and no others" 0 $?
rm -rf "$onlycat"

# --- self-hosted catalogs: a catalog and a workspace are two different places ---
# Every check here builds its own publishers with fresh keys, so none of them needs
# this checkout's signing key, and none of them writes to this checkout.
sh=$(mktemp -d 2>/dev/null || echo "/tmp/fp-sh-$$"); mkdir -p "$sh"
reg_before=$(cat "$here/fpa.registered" "$here/allowed_signers" 2>/dev/null | shasum | cut -c1-12)
# mkcat <dir> <name> [identity] -- an initialized catalog with one registered-fit
# frompt. A catalog's base is the address it is served from, and these are read
# from their directories, so each is published at its own directory; it signs as
# the host <name> gives, or as [identity].
mkcat() {
  local host=${2#*://}; host=${host%%/*}
  "$here/bin/fp-init-catalog" "$1" --url "$1" --identity "${3:-$host}" >/dev/null 2>&1 || return 1
  "$new" hello -c i-have-read-this-prompt-and-want-my-agent-to-say-hello-once -o "$1/prompts" \
    --author selftest >/dev/null 2>&1 || return 1
  sed -i.bak 's/^flow:/contexts: interactive, registered, managed\
flow:/' "$1/prompts/hello/1.0.0.frompt.md" && rm -f "$1/prompts/hello/1.0.0.frompt.md.bak"
  (cd "$1" && "$here/bin/fp-index" >/dev/null && "$here/bin/fp-sign" </dev/null >/dev/null 2>&1)
}
keyof() { ssh-keygen -lf "$1/.fpa/signing_key.pub" | awk '{print $2}'; }

mkcat "$sh/acme" https://catalog.acme.example
check "fp-init-catalog makes a catalog that indexes and signs with no edits to any tool" 0 $?
"$here/bin/fp-init-catalog" "$sh/web" --url https://catalog.acme.example >/dev/null 2>&1
python3 -c "import json,sys; assert json.load(open(sys.argv[1]))['base']=='https://catalog.acme.example/prompts'" "$sh/web/index.json" 2>/dev/null
check "fp-index takes the catalog's base from frompt-catalog.json, not from its own source" 0 $?
"$here/bin/fp-init-catalog" "$sh/acme" --url https://catalog.acme.example >/dev/null 2>&1
check "fp-init-catalog refuses to overwrite a catalog -- a new key would orphan its clients" 1 $?
[ -f "$sh/web/.nojekyll" ] && grep -qx 'catalog.acme.example' "$sh/web/CNAME" && grep -q '^.fpa/$' "$sh/web/.gitignore"
check "fp-init-catalog leaves .nojekyll, CNAME and a .gitignore that keeps the key out" 0 $?
(cd "$sh/acme" && "$here/bin/fp-index" --check >/dev/null 2>&1)
check "standing in a catalog, the tools that build it find it" 0 $?
FPA_CATALOG="$sh/acme" "$here/bin/fp-resolve" --list 2>/dev/null | grep -q '^hello '
check "a reader reads the catalog FPA_CATALOG names" 0 $?

# A reader reads only a catalog somebody chose: FPA_CATALOG, a registration, or
# this checkout. The current directory is none of those.
mkcat "$sh/stray" https://stray.example && rm -f "$sh/stray/index.json.sig"
(cd "$sh/stray" && "$here/bin/fp-resolve" --list 2>/dev/null) | grep -q '^hello '
check "standing in a catalog, fp-resolve --list does not read it" 1 $?
(cd "$sh/stray" && "$here/bin/fp-resolve" hello --record >/dev/null 2>&1)
check "standing in a catalog, fp-resolve does not resolve from it" 1 $?
mkdir -p "$sh/stray-ws"; (cd "$sh/stray" && FPA_WORKSPACE="$sh/stray-ws" "$here/bin/fp-lock" >/dev/null 2>&1)
grep -q '^hello ' "$sh/stray-ws/fpa.lock" 2>/dev/null
check "standing in a catalog, fp-lock does not pin from it" 1 $?

export FPA_WORKSPACE="$sh/client"
"$here/bin/fp-register" "$sh/acme" --key SHA256:0000000000000000000000000000000000000000000 >/dev/null 2>&1
check "fp-register --key refuses a catalog that serves no key with that fingerprint" 1 $?
"$here/bin/fp-register" "$sh/acme" --key "$(keyof "$sh/acme")" --pin version >/dev/null 2>&1 \
  && grep -q "^$sh/acme $(keyof "$sh/acme") version " "$sh/client/fpa.registered"
check "fp-register --key trusts the catalog's published key only because its fingerprint matched" 0 $?
reg_after=$(cat "$here/fpa.registered" "$here/allowed_signers" 2>/dev/null | shasum | cut -c1-12)
check "with FPA_WORKSPACE set, nothing is registered in the tool checkout" "$reg_before" "$reg_after"
"$here/bin/fp-lock" --update hello --from "$sh/acme" >/dev/null 2>&1 \
  && "$here/bin/fp-resolve" hello --from "$sh/acme" --record 2>/dev/null | grep -q 'verified=pinned'
check "fp-lock --from pins a version from a catalog the client does not hold" 0 $?
FPA_CATALOG="$here" "$here/bin/fp-lock" >/dev/null 2>&1; grep -q '^hello 1.0.0 ' "$sh/client/fpa.lock"
check "re-locking one catalog keeps the pins taken from another" 0 $?

# A second publisher this client trusts signs a manifest that names acme's catalog,
# at a serial acme will not reach for years. Keyed by base alone, that floor was
# acme's, and every real acme manifest after it was refused as a rollback.
mkcat "$sh/globex" https://catalog.globex.example
"$here/bin/fp-register" "$sh/globex" --key "$(keyof "$sh/globex")" >/dev/null 2>&1
python3 - "$sh/acme/index.json" "$sh/globex/index.json" <<'PY'
import json, sys
m = json.load(open(sys.argv[1])); m["serial"] = 999999
open(sys.argv[2], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")
PY
rm -f "$sh/globex/index.json.sig"; ssh-keygen -Y sign -f "$sh/globex/.fpa/signing_key" -n foreign-prompts "$sh/globex/index.json" >/dev/null 2>&1
"$here/bin/fp-verify" --from "$sh/globex" >/dev/null 2>&1 </dev/null
check "a manifest naming a catalog this client takes from another signer is refused (M6b)" 1 $?
"$here/bin/fp-verify" hello --from "$sh/acme" >/dev/null 2>&1 </dev/null
check "another trusted publisher cannot raise one catalog's freshness floor (M6)" 0 $?
grep -q '^catalog.acme.example namespaces="foreign-prompts" ssh-ed25519 ' "$sh/client/allowed_signers"
check "fp-register writes the trust-root line itself: one principal, the key, the namespace" 0 $?

# Two keys under one principal made "signed by X" mean either, and made the
# fingerprint lookup take whichever line came first.
mkcat "$sh/namesake" https://namesake.example catalog.acme.example
"$here/bin/fp-register" "$sh/namesake" --key "$(keyof "$sh/namesake")" >/dev/null 2>&1
check "a second key under a principal the trust root already uses is refused" 1 $?

# The published key matches the fingerprint, but the manifest was signed by a
# different key the client also trusts: registering records who actually signed.
mkcat "$sh/mixed" https://mixed.example
rm -f "$sh/mixed/index.json.sig"; ssh-keygen -Y sign -f "$sh/globex/.fpa/signing_key" -n foreign-prompts "$sh/mixed/index.json" >/dev/null 2>&1
floors_before=$(shasum < "$sh/client/.fpa/manifest-serials.json")
"$here/bin/fp-register" "$sh/mixed" --key "$(keyof "$sh/mixed")" >/dev/null 2>&1
check "fp-register refuses a catalog signed by a key other than the one it was given" 1 $?
[ "$(shasum < "$sh/client/.fpa/manifest-serials.json")" = "$floors_before" ]
check "a refused registration leaves the freshness floors as they were" 0 $?
grep -qF "$(awk '{print $2}' "$sh/mixed/.fpa/signing_key.pub")" "$sh/client/allowed_signers"
check "a refused registration leaves no key behind in the trust root" 1 $?
"$here/bin/fp-register" "$sh/stray" --key "$(keyof "$sh/stray")" >/dev/null 2>&1
rc=$?; grep -qF "$(awk '{print $2}' "$sh/stray/.fpa/signing_key.pub")" "$sh/client/allowed_signers"
check "a catalog that fails verification is refused and its key removed again" "1 1" "$rc $?"

# Every field of a registration is one word.
regs=$(shasum < "$sh/client/fpa.registered")
"$here/bin/fp-register" "$sh/acme" --key "$(keyof "$sh/acme")" --as "$(printf 'x\ny')" >/dev/null 2>&1
rc=$?; [ "$(shasum < "$sh/client/fpa.registered")" = "$regs" ]
check "fp-register refuses a name with a line break in --as, and records nothing" "2 0" "$rc $?"
USER="$(printf 'x\ny')" "$here/bin/fp-register" "$sh/acme" --key "$(keyof "$sh/acme")" >/dev/null 2>&1
check "fp-register refuses a line break arriving through USER" 2 $?

# The registered context: a manifest naming acme's catalog but signed by another
# key this client trusts is refused, because the registration names acme's key.
cp "$sh/acme/index.json" "$sh/acme/index.json.keep"; cp "$sh/acme/index.json.sig" "$sh/acme/index.json.sig.keep"
cp "$sh/globex/index.json" "$sh/globex/index.json.sig" "$sh/acme/"
"$here/bin/fp-verify" hello --from "$sh/acme" --context registered >/dev/null 2>&1 </dev/null
check "registered: another trusted key signing a manifest for this catalog is refused (AC2b)" 1 $?
mv "$sh/acme/index.json.keep" "$sh/acme/index.json"; mv "$sh/acme/index.json.sig.keep" "$sh/acme/index.json.sig"

# Floors written before they were keyed by signer: they still refuse, they say so,
# and they count once.
lw="$sh/legacy"; mkdir -p "$lw/.fpa"; cp "$sh/client/allowed_signers" "$lw/"
acme_base="$sh/acme/prompts"
acme_serial=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['serial'])" "$sh/acme/index.json")
printf '{"%s": %s}\n' "$acme_base" $((acme_serial + 1)) > "$lw/.fpa/manifest-serials.json"
FPA_WORKSPACE="$lw" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>"$sh/legacy.err" </dev/null
rc=$?; grep -q 'before floors were kept per signer' "$sh/legacy.err"
check "an old-format floor above the manifest refuses it and says how the pilot can clear it" "1 0" "$rc $?"
printf '{"%s": %s}\n' "$acme_base" "$acme_serial" > "$lw/.fpa/manifest-serials.json"
FPA_WORKSPACE="$lw" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null \
  && python3 -c '
import json, sys
f = json.load(open(sys.argv[1]))
sys.exit(0 if sys.argv[2] in f and any(k.startswith(sys.argv[2] + " ") for k in f) else 1)
' "$lw/.fpa/manifest-serials.json" "$acme_base"
check "an old-format floor stays when a manifest passes it, beside the new keyed floor" 0 $?
printf '{"%s": %s}\n' "$acme_base" $((acme_serial + 1)) > "$lw/.fpa/manifest-serials.json"
FPA_WORKSPACE="$lw" "$here/bin/fp-verify" --from "$sh/globex" >/dev/null 2>&1 </dev/null
FPA_WORKSPACE="$lw" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
check "another key passing an old-format floor does not lift it for the catalog's own key" 1 $?

# A floor moves only when everything the run checks has passed.
mkdir -p "$sh/g3"; cp "$sh/client/allowed_signers" "$sh/g3/"
FPA_WORKSPACE="$sh/g3" "$here/bin/fp-verify" no-such-prompt --from "$sh/acme" >/dev/null 2>&1 </dev/null
rc=$?; [ -e "$sh/g3/.fpa/manifest-serials.json" ]
check "a refused prompt does not raise the manifest's floor" "1 1" "$rc $?"

# A manifest's `file` is a plain path under prompts/, signed or not.
mkcat "$sh/odd" https://odd.example
python3 -c '
import json, sys
m = json.load(open(sys.argv[1]))
m["prompts"][0]["versions"][0]["file"] = "../../outside.frompt.md"
open(sys.argv[1], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")
' "$sh/odd/index.json"
rm -f "$sh/odd/index.json.sig"; ssh-keygen -Y sign -f "$sh/odd/.fpa/signing_key" -n foreign-prompts "$sh/odd/index.json" >/dev/null 2>&1
cat "$sh/odd/allowed_signers" >> "$lw/allowed_signers"
FPA_WORKSPACE="$lw" "$here/bin/fp-verify" hello --from "$sh/odd" >/dev/null 2>&1 </dev/null
check "fp-verify refuses a signed manifest whose file is not a plain path under prompts/" 1 $?
FPA_CATALOG="$sh/odd" "$here/bin/fp-resolve" hello --record >/dev/null 2>&1
check "fp-resolve refuses the same manifest from FPA_CATALOG" 1 $?

# A publisher's key changes under the same principal: the catalog's floor stays.
mkcat "$sh/turn" https://turn.example
tw="$sh/turn-ws"; mkdir -p "$tw"; cp "$sh/turn/allowed_signers" "$tw/"
cp "$sh/turn/index.json" "$sh/turn-old.json"; cp "$sh/turn/index.json.sig" "$sh/turn-old.sig"
FPA_WORKSPACE="$tw" "$here/bin/fp-verify" --from "$sh/turn" >/dev/null 2>&1 </dev/null
ssh-keygen -q -t ed25519 -N "" -C turn.example -f "$sh/turn-key2" >/dev/null 2>&1
printf 'turn.example %s\n' "$(cut -d' ' -f1,2 "$sh/turn-key2.pub")" >> "$tw/allowed_signers"
python3 -c 'import json, sys
m = json.load(open(sys.argv[1])); m["serial"] += 1
open(sys.argv[1], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")' "$sh/turn/index.json"
rm -f "$sh/turn/index.json.sig"; ssh-keygen -Y sign -f "$sh/turn-key2" -n foreign-prompts "$sh/turn/index.json" >/dev/null 2>&1
FPA_WORKSPACE="$tw" "$here/bin/fp-verify" --from "$sh/turn" >/dev/null 2>&1 </dev/null
r1=$?; cp "$sh/turn-old.json" "$sh/turn/index.json"; cp "$sh/turn-old.sig" "$sh/turn/index.json.sig"
FPA_WORKSPACE="$tw" "$here/bin/fp-verify" --from "$sh/turn" >/dev/null 2>&1 </dev/null
check "a key rotated under the same principal keeps the catalog's floor (M6)" "0 1" "$r1 $?"

# What a catalog serves as its key is checked, then written in the client's own form.
served() { mkcat "$sh/$1" "https://$1.example" >/dev/null 2>&1; mkdir -p "$sh/$1-ws"; }
pubkey() { cut -d' ' -f1,2 "$sh/$1/.fpa/signing_key.pub"; }
served opt;    printf 'opt.example valid-after="20200101" %s\n' "$(pubkey opt)" > "$sh/opt/allowed_signers"
served spaced; printf 'spaced.example namespaces="x y,foreign-prompts" %s\n' "$(pubkey spaced)" > "$sh/spaced/allowed_signers"
served star;   printf '* %s\n' "$(pubkey star)" > "$sh/star/allowed_signers"
r=""
for label in opt spaced star; do
  FPA_WORKSPACE="$sh/$label-ws" "$here/bin/fp-register" "$sh/$label" --key "$(keyof "$sh/$label")" >/dev/null 2>&1
  r="$r$? "; [ -e "$sh/$label-ws/allowed_signers" ] && r="${r}kept "
done
check "a served key line with an option, an odd namespace list or a pattern is refused, and nothing kept" "1 1 1 " "$r"
served twice;  printf 'twice.example %s\nfrompt-catalog %s\n' "$(pubkey twice)" "$(pubkey twice)" > "$sh/twice/allowed_signers"
FPA_WORKSPACE="$sh/twice-ws" "$here/bin/fp-register" "$sh/twice" --key "$(keyof "$sh/twice")" >/dev/null 2>&1
rc=$?; [ -e "$sh/twice-ws/allowed_signers" ]
check "a key served under two principals is refused, and neither is kept" "1 1" "$rc $?"

# Renewal extends what was published; it does not publish.
cp -R "$sh/acme" "$sh/acme-renew"
FPA_CATALOG="$sh/acme-renew" "$here/bin/fp-index" --renew >/dev/null 2>&1
r1=$?; printf '\nchanged\n' >> "$sh/acme-renew/prompts/hello/1.0.0.frompt.md"
FPA_CATALOG="$sh/acme-renew" "$here/bin/fp-index" --renew >/dev/null 2>&1
check "fp-index --renew renews unchanged documents and refuses changed ones" "0 1" "$r1 $?"
wf="$sh/acme/.github/workflows/renew.yml"
# Outside a git checkout (a release archive) fp-init-catalog has no commit to pin
# the tools to and writes no workflow. The workflow's checks still run: they read
# the same template, rendered here with a stand-in commit.
if [ ! -e "$wf" ]; then
  wf="$sh/renew-template.yml"
  python3 -c 'import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("fp_init_catalog", sys.argv[1])
m = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(m)
open(sys.argv[2], "w").write(m.WORKFLOW.format(ref="0123456789abcdef0123456789abcdef01234567"))' \
    "$here/bin/fp-init-catalog" "$wf"
  echo "note -- the tools are not a git checkout; the renew workflow checks read its template with a stand-in commit"
fi
! grep -Eq 'uses: [^ ]+@v[0-9]' "$wf" && grep -q '^    environment: frompt-signing$' "$wf" \
  && grep -q "trap 'rm -rf .fpa' EXIT" "$wf" && grep -q 'ssh-keygen -Y verify -f .fpa/self' "$wf" \
  && grep -q "if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)" "$wf"
check "the renew workflow pins actions by commit, signs only in its environment and branch, and cleans up" 0 $?

# A key from outside a catalog signs only a catalog somebody named.
(cd "$sh/acme" && FPA_SIGNING_KEY="$sh/acme/.fpa/signing_key" "$here/bin/fp-sign" </dev/null >/dev/null 2>&1)
check "fp-sign with FPA_SIGNING_KEY will not sign the catalog it merely stands in" 2 $?
gx_sig=$(shasum < "$sh/globex/index.json.sig")
(cd "$sh/globex" && FPA_SIGNING_KEY="$sh/acme/.fpa/signing_key" "$here/bin/fp-sign" --catalog "$sh/acme" </dev/null >/dev/null 2>&1)
rc=$?; ssh-keygen -Y verify -f "$sh/acme/allowed_signers" -I catalog.acme.example -n foreign-prompts \
  -s "$sh/acme/index.json.sig" < "$sh/acme/index.json" >/dev/null 2>&1
v=$?; [ "$(shasum < "$sh/globex/index.json.sig")" = "$gx_sig" ]
check "fp-sign --catalog signs the catalog it names, not the one it stands in" "0 0 0" "$rc $v $?"

# resign <dir> <python statement on m> [key]: rewrite a catalog's manifest and sign it
resign() {
  python3 -c 'import json, sys
m = json.load(open(sys.argv[1])); exec(sys.argv[2])
open(sys.argv[1], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")' "$1/index.json" "$2"
  rm -f "$1/index.json.sig"; ssh-keygen -Y sign -f "${3:-$1/.fpa/signing_key}" -n foreign-prompts "$1/index.json" >/dev/null 2>&1
}
freshws() { mkdir -p "$1"; cp "$sh/client/allowed_signers" "$1/"; }

# The workspace's own state: read whole, or not at all.
st="$sh/st"; freshws "$st"
FPA_WORKSPACE="$st" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
r=""
for bad in '' '{"https://catalog.acme.example/prompts": ' '[]' '{"x": 5}'; do
  printf '%s' "$bad" > "$st/.fpa/catalog-signers.json"
  FPA_WORKSPACE="$st" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>"$sh/st.err" </dev/null
  rc=$?; grep -q 'catalog-signers.json' "$sh/st.err" && r="$r$rc " || r="${r}unnamed-$rc "
done
check "a bindings file that exists but cannot be read is a refusal that names it" "2 2 2 2 " "$r"
rm -rf "$st/.fpa"; FPA_WORKSPACE="$st" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
printf '{"%s catalog.acme.example": 1' "$acme_base" > "$st/.fpa/manifest-serials.json"
FPA_WORKSPACE="$st" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
check "a floors file that exists but cannot be read is a refusal, not a fresh start" 2 $?
rm -rf "$st/.fpa"; FPA_WORKSPACE="$st" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
rm -f "$st/.fpa/catalog-signers.json"
FPA_WORKSPACE="$st" "$here/bin/fp-verify" --from "$sh/globex" >/dev/null 2>&1 </dev/null
check "with the bindings file gone, the bindings the floors imply still hold" 1 $?

# Accepted at once, remembered at once: every binding and floor survives.
cw="$sh/cw"; mkdir -p "$cw"; : > "$cw/allowed_signers"
for i in 1 2 3 4 5 6 7 8; do
  mkcat "$sh/p$i" "https://p$i.example"; cat "$sh/p$i/allowed_signers" >> "$cw/allowed_signers"
done
lost=0
for round in 1 2 3 4 5; do
  rm -rf "$cw/.fpa"
  for i in 1 2 3 4 5 6 7 8; do FPA_WORKSPACE="$cw" "$here/bin/fp-verify" --from "$sh/p$i" >/dev/null 2>&1 </dev/null & done
  wait
  n=$(python3 -c 'import json, sys
print(min(len(json.load(open(f))) for f in sys.argv[1:]))' "$cw/.fpa/catalog-signers.json" \
      "$cw/.fpa/manifest-serials.json" "$cw/.fpa/catalog-addresses.json" 2>/dev/null || echo 0)
  [ "$n" = 8 ] || lost=$((lost + 1))
done
check "eight catalogs accepted at once keep all eight bindings and floors" 0 $lost

# A lock line is space-delimited: what a manifest says cannot become a second pin.
mkcat "$sh/nl" https://nl.example; nw="$sh/nlws"; mkdir -p "$nw"; cp "$sh/nl/allowed_signers" "$nw/"
resign "$sh/nl" 'm["base"] = "https://nl.example/prompts\nhello 9.9.9 sha256:" + "0" * 64 + " https://x.example/p"'
FPA_WORKSPACE="$nw" "$here/bin/fp-verify" --from "$sh/nl" >/dev/null 2>&1 </dev/null
r1=$?; FPA_WORKSPACE="$nw" "$here/bin/fp-lock" --update hello --from "$sh/nl" >/dev/null 2>&1 </dev/null
r2=$?; [ -e "$nw/fpa.lock" ]
check "a manifest whose base would split a lock line is refused, and nothing is pinned" "1 1 1" "$r1 $r2 $?"
cp "$sh/client/fpa.lock" "$sh/lock.keep"
grep '^hello ' "$sh/lock.keep" | sed 's/sha256:[0-9a-f]*/sha256:'"$(printf '%064d' 0)"'/' >> "$sh/client/fpa.lock"
out=$("$here/bin/fp-resolve" hello --from "$sh/acme" --record 2>&1 </dev/null); rc=$?
printf '%s' "$out" | grep -q 'twice'
check "fp-resolve refuses a lock that pins one id twice" "1 0" "$rc $?"
cp "$sh/lock.keep" "$sh/client/fpa.lock"
printf 'zz 1.0.x sha256:%s https://x.example/zz/1.0.x.frompt.md\n' "$(printf '%064d' 0)" >> "$sh/client/fpa.lock"
out=$("$here/bin/fp-resolve" hello --from "$sh/acme" --record 2>&1 </dev/null); rc=$?
printf '%s' "$out" | grep -q "is not '<id> <version> sha256:<digest> <url>'"
check "fp-resolve refuses a lock with a malformed line" "1 0" "$rc $?"
cp "$sh/lock.keep" "$sh/client/fpa.lock"

# One spelling per catalog. A base is accepted written one plain way; the few
# variations allowed fold to one spelling, and a catalog bound under https is not
# free under http.
python3 - "$here/bin" <<'PY' >/dev/null 2>&1
import sys; sys.path.insert(0, sys.argv[1]); import fpa_roots as f
bad = ["https://a.example/./prompts", "https://a.example/x/../prompts", "https://a.example//prompts",
       "https://a.example/%70rompts", "https://a.example./prompts", "https://a.example/prompts;x",
       "https://a.example/prompts?", "https://a.example/prompts#", "https://u@a.example/prompts",
       "/srv//catalog/prompts", "/srv/./catalog/prompts", "/srv/x/../catalog/prompts", "//host/prompts",
       "file:///srv/prompts", "srv/prompts", "https://a.example/pro mpts"]
assert not [b for b in bad if f.valid_base(b)], [b for b in bad if f.valid_base(b)]
good = ["https://a.example/prompts", "https://a.example/prompts/", "HTTPS://A.Example:443/prompts",
        "http://a.example:8080/x/prompts", "/srv/catalog/prompts", "/srv/catalog/prompts/"]
assert all(f.valid_base(b) for b in good), [b for b in good if not f.valid_base(b)]
PY
check "a base is accepted in one plain spelling only: no dot or empty segment, escape, ';' or trailing dot" 0 $?
python3 - "$here/bin" <<'PY' >/dev/null 2>&1
import sys; sys.path.insert(0, sys.argv[1]); import fpa_roots as f
assert f.normalize_base("HTTPS://A.Example:443/prompts/") == "https://a.example/prompts"
assert f.normalize_base("http://a.example:80/prompts") == "http://a.example/prompts"
assert f.normalize_base("https://a.example:8443/prompts") == "https://a.example:8443/prompts"
assert f.normalize_base("/srv/catalog/prompts//") == "/srv/catalog/prompts"
PY
check "trailing slashes, the case of scheme and host, and a default port fold to one spelling" 0 $?
python3 - "$here/bin" <<'PY' >/dev/null 2>&1
import sys; sys.path.insert(0, sys.argv[1]); import fpa_roots as f
bound = {"https://a.example/prompts": "acme"}
assert f.binding_conflict(bound, "http://a.example/prompts", "globex") == ("https://a.example/prompts", "acme")
assert f.binding_conflict(bound, "http://a.example/prompts", "acme") is None
assert f.binding_conflict({"http://a.example/prompts": "acme"}, "https://a.example/prompts", "globex")
PY
check "a catalog bound under https is not free under http, nor the reverse" 0 $?
vw="$sh/vw"; freshws "$vw"
FPA_WORKSPACE="$vw" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
cp "$sh/acme/index.json" "$sh/acme/index.json.keep"; cp "$sh/acme/index.json.sig" "$sh/acme/index.json.sig.keep"
r=""
for spelling in 'm["base"] + "/"' 'm["base"].replace("/prompts", "/./prompts")'; do
  resign "$sh/acme" "m[\"serial\"] = 999999; m[\"base\"] = $spelling" "$sh/globex/.fpa/signing_key"
  FPA_WORKSPACE="$vw" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null; r="$r$? "
  cp "$sh/acme/index.json.keep" "$sh/acme/index.json"; cp "$sh/acme/index.json.sig.keep" "$sh/acme/index.json.sig"
done
rm -f "$sh/acme/index.json.keep" "$sh/acme/index.json.sig.keep"
check "another spelling of a bound catalog's base, signed by another, is refused at its address" "1 1 " "$r"
aw="$sh/aw"; mkdir -p "$aw"; cat "$sh/p1/allowed_signers" "$sh/p2/allowed_signers" > "$aw/allowed_signers"
cp -R "$sh/p1" "$sh/p1-at"; resign "$sh/p1-at" "m[\"base\"] = \"$sh/p1-at/prompts\"" "$sh/p1/.fpa/signing_key"
FPA_WORKSPACE="$aw" "$here/bin/fp-verify" --from "$sh/p1-at" >/dev/null 2>&1 </dev/null
r1=$?; cp "$sh/p2/index.json" "$sh/p2/index.json.sig" "$sh/p1-at/"; rm -rf "$sh/p1-at/prompts"; cp -R "$sh/p2/prompts" "$sh/p1-at/"
out=$(FPA_WORKSPACE="$aw" "$here/bin/fp-verify" hello --from "$sh/p1-at" 2>&1 </dev/null); r2=$?
printf '%s' "$out" | grep -q 'A catalog.s base is the address it is served from'
check "an address serves the catalog whose base it is, and no other" "0 1 0" "$r1 $r2 $?"
# A directory has more than one path. The address is its real path, and it serves the
# one catalog first accepted there, under whichever spelling of that path.
# ($sh/p1-at was first accepted here as the catalog $sh/p1-at/prompts.)
ln -s "$sh/p1-at" "$sh/p1-alias"
resign "$sh/p1-at" "m[\"base\"] = \"$sh/p1-alias/prompts\"" "$sh/p2/.fpa/signing_key"
out=$(FPA_WORKSPACE="$aw" "$here/bin/fp-verify" --from "$sh/p1-at" 2>&1 </dev/null); rc=$?
printf '%s' "$out" | grep -q 'served the catalog'
check "a directory serves one catalog under every spelling of its path" "1 0" "$rc $?"

# A certificate naming a catalog's principal does not stand in for that catalog's key.
cwk="$sh/certws"; freshws "$cwk"
FPA_WORKSPACE="$cwk" "$here/bin/fp-verify" --from "$sh/acme" >/dev/null 2>&1 </dev/null
ssh-keygen -q -t ed25519 -N "" -C auth -f "$sh/auth" >/dev/null 2>&1
ssh-keygen -q -t ed25519 -N "" -C holder -f "$sh/holder" >/dev/null 2>&1
ssh-keygen -q -s "$sh/auth" -I holder -n catalog.acme.example -V -5m:+1d "$sh/holder.pub" >/dev/null 2>&1
printf '* cert-authority,namespaces="foreign-prompts" %s\n' "$(cut -d' ' -f1,2 "$sh/auth.pub")" >> "$cwk/allowed_signers"
cp "$sh/acme/index.json" "$sh/acme/index.json.keep"; cp "$sh/acme/index.json.sig" "$sh/acme/index.json.sig.keep"
resign "$sh/acme" 'm["serial"] = 999999' "$sh/holder-cert.pub"
out=$(FPA_WORKSPACE="$cwk" "$here/bin/fp-verify" --from "$sh/acme" 2>&1 </dev/null); r=$?
mv "$sh/acme/index.json.keep" "$sh/acme/index.json"; mv "$sh/acme/index.json.sig.keep" "$sh/acme/index.json.sig"
check "a manifest signed under a certificate does not pass for a catalog bound to a key" 1 $r
case "$out" in *"but this workspace accepts"*) r=0 ;; *) r=1 ;; esac
check "  and the refusal is the catalog's binding to its signer, not an unrelated failure" 0 $r

# Renewal: a window has a ceiling, and the workflow will not sign unprotected.
FPA_CATALOG="$sh/acme-renew" FPA_VALIDITY_DAYS=99999 "$here/bin/fp-index" --renew >/dev/null 2>&1
check "fp-index refuses a validity window longer than its ceiling" 2 $?
r=""
for d in 0 -3 x 1.5 91 90; do
  rm -rf "$sh/acme-w"; cp -R "$sh/acme" "$sh/acme-w"
  FPA_CATALOG="$sh/acme-w" FPA_VALIDITY_DAYS="$d" "$here/bin/fp-index" --renew >/dev/null 2>&1; r="$r$? "
done
check "a window is 1 to 90 whole days: 0, negative, not a number and 91 are refused, 90 is not" "2 2 2 2 2 0 " "$r"
rm -rf "$sh/acme-w"; cp -R "$sh/acme" "$sh/acme-w"
python3 -c 'import json, sys
p = sys.argv[1]; m = json.load(open(p)); m["not_after"] = "2300-01-01T00:00:00Z"
open(p, "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")' "$sh/acme-w/index.json"
FPA_CATALOG="$sh/acme-w" "$here/bin/fp-index" >/dev/null 2>&1
python3 -c 'import datetime as d, json, sys
t = d.datetime.strptime(json.load(open(sys.argv[1]))["not_after"], "%Y-%m-%dT%H:%M:%SZ")
assert t < d.datetime.utcnow() + d.timedelta(days=91)' "$sh/acme-w/index.json" 2>/dev/null
check "a plain fp-index run does not keep a window longer than the ceiling" 0 $?
grep -q '^  actions: read$' "$wf"
check "the renew workflow may read its environment's protection rules" 0 $?
# The job itself, run with stand-ins for gh and git: it signs only when the
# environment's rules include required reviewers, and refuses when the API says
# anything else or nothing at all.
mkcat "$sh/jobcat" https://job.example
FPA_CATALOG="$sh/jobcat" FPA_VALIDITY_DAYS=5 "$here/bin/fp-index" --renew >/dev/null 2>&1
FPA_CATALOG="$sh/jobcat" "$here/bin/fp-sign" </dev/null >/dev/null 2>&1
python3 - "$here/bin/fp-init-catalog" "$sh/renew-job.sh" <<'PY'
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("fp_init_catalog", sys.argv[1])
m = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(m)
lines = m.WORKFLOW.format(ref="0" * 40).splitlines()
at = next(i for i, l in enumerate(lines) if l.strip() == "run: |")
indent = len(lines[at + 1]) - len(lines[at + 1].lstrip())
body = []
for l in lines[at + 1:]:
    if l.strip() and len(l) - len(l.lstrip()) < indent:
        break
    body.append(l[indent:])
open(sys.argv[2], "w").write("\n".join(body) + "\n")
PY
mkdir -p "$sh/jobbin"
printf '#!/bin/sh
[ "$JOB_RULES" = fail ] && exit 1
printf "%%s\\n" "$JOB_RULES"
' > "$sh/jobbin/gh"
printf '#!/bin/sh
exit 0
' > "$sh/jobbin/git"
chmod +x "$sh/jobbin/gh" "$sh/jobbin/git"
r=""
for rules in "" fail branch_policy wait_timer,branch_policy required_reviewers_x required_reviewers; do
  rm -rf "$sh/job"; cp -R "$sh/jobcat" "$sh/job"; rm -rf "$sh/job/.fpa"; ln -s "$here" "$sh/job/.frompt-tools"
  before=$(cat "$sh/job/index.json.sig")
  (cd "$sh/job" && env -u FPA_CATALOG -u FPA_WORKSPACE JOB_RULES="$rules" PATH="$sh/jobbin:$PATH" \
     GITHUB_REPOSITORY=owner/catalog FPA_SIGNING_KEY_MATERIAL="$(cat "$sh/jobcat/.fpa/signing_key")" \
     bash -eo pipefail "$sh/renew-job.sh" >/dev/null 2>&1); rc=$?
  [ "$(cat "$sh/job/index.json.sig")" = "$before" ] && r="$r$rc-unsigned " || r="$r$rc-signed "
  [ -e "$sh/job/.fpa/signing_key" ] && r="${r}KEY-LEFT "
done
check "the renew job signs only when its environment requires reviewers, and never leaves the key" \
  "1-unsigned 1-unsigned 1-unsigned 1-unsigned 1-unsigned 0-signed " "$r"

# What a run is asked, and where it reads from.
iw="$sh/iw"; freshws "$iw"; rm -rf "$sh/acme-t"; cp -R "$sh/acme" "$sh/acme-t"
printf '\nunsigned change\n' >> "$sh/acme-t/prompts/hello/1.0.0.frompt.md"
FPA_WORKSPACE="$iw" "$here/bin/fp-verify" --from "$sh/acme-t" hello >/dev/null 2>&1 </dev/null
check "fp-verify checks the prompt id wherever it stands among the arguments" 1 $?
mkdir -p "$sh/cwd/https:/nowhere.example"; cp "$sh/acme/index.json" "$sh/acme/index.json.sig" "$sh/cwd/https:/nowhere.example/"
(cd "$sh/cwd" && FPA_WORKSPACE="$iw" "$here/bin/fp-verify" --from https://nowhere.example >/dev/null 2>&1 </dev/null)
check "a URL is fetched, never read from a directory that happens to share its name" 2 $?
r=""
cp "$sh/acme/index.json" "$sh/acme/index.json.keep"; cp "$sh/acme/index.json.sig" "$sh/acme/index.json.sig.keep"
for stamp in '"2099-01-01T00:00:00Z\nmanifest verified: x SHA256:x"' '"\u0662\u0660\u0669\u0669-01-01T00:00:00Z"' \
             '"9999-99-99T99:99:99Z"'; do
  resign "$sh/acme" "m[\"not_after\"] = $stamp"
  for id in "" hello; do
    out=$(FPA_WORKSPACE="$iw" "$here/bin/fp-verify" $id --from "$sh/acme" 2>&1 </dev/null); rc=$?
    case "$out" in *Traceback*) rc=traceback;; esac; r="$r$rc "
  done
  cp "$sh/acme/index.json.keep" "$sh/acme/index.json"; cp "$sh/acme/index.json.sig.keep" "$sh/acme/index.json.sig"
done
rm -f "$sh/acme/index.json.keep" "$sh/acme/index.json.sig.keep"
check "a not_after that is not a real time in ASCII digits is refused, with or without an id" "1 1 1 1 1 1 " "$r"

# Registering: into a readable workspace only; nothing left behind when stopped.
mkdir -p "$sh/badws/.fpa"; printf '{ "x": 1,' > "$sh/badws/.fpa/manifest-serials.json"
out=$(FPA_WORKSPACE="$sh/badws" "$here/bin/fp-register" "$sh/p3" --key "$(keyof "$sh/p3")" 2>&1 </dev/null)
rc=$?; [ -e "$sh/badws/allowed_signers" ] || [ -e "$sh/badws/fpa.registered" ]; r2=$?
printf '%s' "$out" | grep -q 'Refusing to register into a workspace whose state cannot be read'
check "fp-register refuses a workspace whose state cannot be read, before trying, and writes nothing" "1 1 0" "$rc $r2 $?"
fb="$sh/fakebin"; mkdir -p "$fb" "$sh/tmpdir"
printf '#!/bin/sh\ncase "$*" in *find-principals*) sleep 4;; esac\nexec %s "$@"\n' "$(command -v ssh-keygen)" > "$fb/ssh-keygen"
chmod +x "$fb/ssh-keygen"
TMPDIR="$sh/tmpdir" PATH="$fb:$PATH" FPA_WORKSPACE="$sh/sigws" "$here/bin/fp-register" "$sh/p4" --key "$(keyof "$sh/p4")" >/dev/null 2>&1 </dev/null &
pid=$!; sleep 1.5; kill -TERM "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; sleep 5
ls "$sh/tmpdir" | grep -Eq '^(fp-register-|fp-verify\.)'
check "a registration stopped part way leaves no trial copy or scratch directory behind" 1 $?
mkcat "$sh/case" https://case.example
printf 'Catalog.Acme.Example %s\n' "$(cut -d' ' -f1,2 "$sh/case/.fpa/signing_key.pub")" > "$sh/case/allowed_signers"
"$here/bin/fp-register" "$sh/case" --key "$(keyof "$sh/case")" >/dev/null 2>&1 </dev/null
check "a principal that differs from one in use only in letter case is the same principal" 1 $?
mkdir -p "$sh/notgit"; cp -R "$here/bin" "$sh/notgit/"
"$sh/notgit/bin/fp-init-catalog" "$sh/ng" --url https://ng.example >/dev/null 2>&1
rc=$?; [ -e "$sh/ng/.github/workflows/renew.yml" ]
check "outside a git checkout, fp-init-catalog writes no workflow it cannot pin" "0 1" "$rc $?"

# A publisher rotates its key: re-registering needs a deliberate unregister, and
# the old key leaves the trust root with the registration it came in with.
mkcat "$sh/rot" https://rot.example
"$here/bin/fp-register" "$sh/rot" --key "$(keyof "$sh/rot")" >/dev/null 2>&1
old_key=$(awk '{print $2}' "$sh/rot/.fpa/signing_key.pub")
rm -f "$sh/rot/.fpa/signing_key" "$sh/rot/.fpa/signing_key.pub"
FPA_CATALOG="$sh/rot" "$here/bin/fp-sign" --keygen >/dev/null 2>&1 </dev/null
"$here/bin/fp-register" "$sh/rot" --key "$(keyof "$sh/rot")" >/dev/null 2>&1
r1=$?; "$here/bin/fp-unregister" "$sh/rot" >/dev/null 2>&1
r2=$?; grep -qF "$old_key" "$sh/client/allowed_signers"
r3=$?; "$here/bin/fp-register" "$sh/rot" --key "$(keyof "$sh/rot")" >/dev/null 2>&1
check "a rotated key: refused, then unregister drops the old key and the new one registers" "1 0 1 0" "$r1 $r2 $r3 $?"

# --- one writer's view: what a registration adds, and what a floor implies -------
# Two registrations at once. The later one's trial was taken before the earlier one
# committed, so it is checked again under the lock: a principal names one key.
slow="$sh/slowbin"; mkdir -p "$slow"
printf '#!/bin/sh\ncase "$*" in *find-principals*) sleep 4;; esac\nexec %s "$@"\n' "$(command -v ssh-keygen)" > "$slow/ssh-keygen"
chmod +x "$slow/ssh-keygen"
mkcat "$sh/ra" https://ra.example; mkcat "$sh/rq" https://rq.example ra.example
cw2="$sh/cw2"; mkdir -p "$cw2"
PATH="$slow:$PATH" FPA_WORKSPACE="$cw2" "$here/bin/fp-register" "$sh/rq" --key "$(keyof "$sh/rq")" >/dev/null 2>&1 </dev/null &
pid=$!; sleep 1.5
FPA_WORKSPACE="$cw2" "$here/bin/fp-register" "$sh/ra" --key "$(keyof "$sh/ra")" >/dev/null 2>&1 </dev/null; r1=$?
wait "$pid"; r2=$?
check "two registrations at once: the one that commits second cannot give a principal a second key" \
  "0 1 1" "$r1 $r2 $(grep -ci '^ra\.example ' "$cw2/allowed_signers")"
# An unregister that happens during another registration stays done.
mkcat "$sh/uc" https://uc.example; mkcat "$sh/ud" https://ud.example
cw3="$sh/cw3"; mkdir -p "$cw3"
FPA_WORKSPACE="$cw3" "$here/bin/fp-register" "$sh/uc" --key "$(keyof "$sh/uc")" >/dev/null 2>&1 </dev/null
PATH="$slow:$PATH" FPA_WORKSPACE="$cw3" "$here/bin/fp-register" "$sh/ud" --key "$(keyof "$sh/ud")" >/dev/null 2>&1 </dev/null &
pid=$!; sleep 1.5
FPA_WORKSPACE="$cw3" "$here/bin/fp-unregister" "$sh/uc" >/dev/null 2>&1 </dev/null; r1=$?
wait "$pid"; r2=$?
grep -qF "$(cut -d' ' -f2 "$sh/uc/.fpa/signing_key.pub")" "$cw3/allowed_signers"
check "an unregister during another registration stays done: its key does not come back" "0 0 1" "$r1 $r2 $?"
# Two registrations at once binding one catalog -- reached by two names for one
# directory -- to two signers: the one that commits second is refused.
mkcat "$sh/kk" https://kk.example; ln -s "$sh/kk" "$sh/kk-link"
ssh-keygen -q -t ed25519 -N "" -C kk-b -f "$sh/kk-b" >/dev/null 2>&1
printf 'kk-b.example %s\n' "$(cut -d' ' -f1,2 "$sh/kk-b.pub")" >> "$sh/kk/allowed_signers"
cp "$sh/kk/index.json.sig" "$sh/kk/sig.a"
rm -f "$sh/kk/index.json.sig"; ssh-keygen -Y sign -f "$sh/kk-b" -n foreign-prompts "$sh/kk/index.json" >/dev/null 2>&1
cw4="$sh/cw4"; mkdir -p "$cw4"
PATH="$slow:$PATH" FPA_WORKSPACE="$cw4" "$here/bin/fp-register" "$sh/kk-link" --key "$(ssh-keygen -lf "$sh/kk-b.pub" | awk '{print $2}')" >/dev/null 2>&1 </dev/null &
pid=$!; sleep 1.5; cp "$sh/kk/sig.a" "$sh/kk/index.json.sig"
FPA_WORKSPACE="$cw4" "$here/bin/fp-register" "$sh/kk" --key "$(keyof "$sh/kk")" >/dev/null 2>&1 </dev/null; r1=$?
wait "$pid"; r2=$?
check "two registrations at once binding one catalog to two signers: the second is refused" "0 1" "$r1 $r2"

# A floor counts as a binding even where the bindings file does not name the
# catalog -- as after a run stopped between writing the two.
mkcat "$sh/fa" https://fa.example; mkcat "$sh/fz" https://fz.example
fw="$sh/fw"; mkdir -p "$fw"; cat "$sh/fa/allowed_signers" "$sh/fz/allowed_signers" > "$fw/allowed_signers"
FPA_WORKSPACE="$fw" "$here/bin/fp-verify" --from "$sh/fz" >/dev/null 2>&1 </dev/null
FPA_WORKSPACE="$fw" "$here/bin/fp-verify" --from "$sh/fa" >/dev/null 2>&1 </dev/null
python3 -c 'import json, sys
p = sys.argv[1]; m = json.load(open(p)); del m[sys.argv[2]]
open(p, "w").write(json.dumps(m))' "$fw/.fpa/catalog-signers.json" "$sh/fa/prompts"
cp "$sh/fa/index.json" "$sh/fa/index.json.keep"; cp "$sh/fa/index.json.sig" "$sh/fa/index.json.sig.keep"
resign "$sh/fa" 'm["serial"] = 999999' "$sh/fz/.fpa/signing_key"
FPA_WORKSPACE="$fw" "$here/bin/fp-verify" --from "$sh/fa" >/dev/null 2>&1 </dev/null
check "a floor is a binding even when the bindings file does not name its catalog" 1 $?
mv "$sh/fa/index.json.keep" "$sh/fa/index.json"; mv "$sh/fa/index.json.sig.keep" "$sh/fa/index.json.sig"

# State that cannot be reached is not empty state.
r=""
for shape in dangling-file fpa-is-a-file fpa-dangling deep-json; do
  sw="$sh/sw-$shape"; mkdir -p "$sw"; cp "$sh/fa/allowed_signers" "$sw/"
  case "$shape" in
    dangling-file) mkdir -p "$sw/.fpa"; ln -s "$sh/nothing-here" "$sw/.fpa/catalog-signers.json" ;;
    fpa-is-a-file) printf 'x' > "$sw/.fpa" ;;
    fpa-dangling) ln -s "$sh/nothing-here" "$sw/.fpa" ;;
    deep-json) mkdir -p "$sw/.fpa"; python3 -c 'print("[" * 100000 + "]" * 100000)' > "$sw/.fpa/manifest-serials.json" ;;
  esac
  out=$(FPA_WORKSPACE="$sw" "$here/bin/fp-verify" --from "$sh/fa" 2>&1 </dev/null); rc=$?
  case "$out" in *Traceback*) rc=traceback;; esac; r="$r$rc "
done
check "a dangling state file, an .fpa that is a file or a dangling link, and deep JSON are the exit-2 refusal" \
  "2 2 2 2 " "$r"
if [ "$(id -u)" -ne 0 ]; then
  sw="$sh/sw-closed"; mkdir -p "$sw/.fpa"; cp "$sh/fa/allowed_signers" "$sw/"; chmod 000 "$sw/.fpa"
  FPA_WORKSPACE="$sw" "$here/bin/fp-verify" --from "$sh/fa" >/dev/null 2>&1 </dev/null; rc=$?
  chmod 700 "$sw/.fpa"
  check "an .fpa this tool may not enter is the exit-2 refusal" 2 $rc
else
  echo "skip -- running as root, so a closed .fpa is open; that check needs another user"
fi

# Values: what a signed manifest says is checked before anything is written from it.
r=""
for v in '"1.0.0 x"' '"1.0.1٠"'; do
  rm -rf "$sh/vv"; cp -R "$sh/fa" "$sh/vv"; resign "$sh/vv" "m[\"base\"] = \"$sh/vv/prompts\"; p = m[\"prompts\"][0]; p[\"latest\"] = p[\"versions\"][0][\"version\"] = $v" "$sh/fa/.fpa/signing_key"
  vw2="$sh/vw2"; rm -rf "$vw2"; mkdir -p "$vw2"; cp "$sh/fa/allowed_signers" "$vw2/"
  FPA_WORKSPACE="$vw2" "$here/bin/fp-verify" hello --from "$sh/vv" >/dev/null 2>&1 </dev/null; r="$r$? "
done
check "fp-verify refuses a signed version that is not a plain semantic version in ASCII digits" "1 1 " "$r"
rm -rf "$sh/lk" "$sh/lkws"; cp -R "$sh/fa" "$sh/lk"; mkdir -p "$sh/lkws"
sed -i.bak 's/^version: 1.0.0$/version: 1.0.0 x/' "$sh/lk/prompts/hello/1.0.0.frompt.md" && rm -f "$sh/lk/prompts/hello/1.0.0.frompt.md.bak"
FPA_CATALOG="$sh/lk" FPA_WORKSPACE="$sh/lkws" "$here/bin/fp-lock" >/dev/null 2>&1 </dev/null
rc=$?; [ -e "$sh/lkws/fpa.lock" ]
check "fp-lock refuses to write a value a lock line cannot hold, and writes nothing" "1 1" "$rc $?"

# A replaced file keeps its mode; a new one gets what the umask gives it.
mw="$sh/mw"; mkdir -p "$mw"
(umask 022; FPA_WORKSPACE="$mw" "$here/bin/fp-register" "$sh/fa" --key "$(keyof "$sh/fa")" >/dev/null 2>&1 </dev/null)
modes() { python3 -c 'import os, stat, sys; print(" ".join(oct(stat.S_IMODE(os.stat(p).st_mode))[2:] for p in sys.argv[1:]))' "$@"; }
m1=$(modes "$mw/allowed_signers" "$mw/fpa.registered" "$mw/.fpa/manifest-serials.json")
chmod 640 "$mw/allowed_signers"
(umask 077; FPA_WORKSPACE="$mw" "$here/bin/fp-register" "$sh/fz" --key "$(keyof "$sh/fz")" >/dev/null 2>&1 </dev/null)
check "a replaced file keeps its mode, and a new one gets the umask's" "644 644 644 640" "$m1 $(modes "$mw/allowed_signers")"

# The order a registration writes in: everything else first, the trust root last,
# so a run that cannot finish leaves a key that is not trusted.
if command -v chflags >/dev/null 2>&1; then
  ow="$sh/ow"; mkdir -p "$ow"; printf '# fpa.registered\n' > "$ow/fpa.registered"
  chflags uchg "$ow/fpa.registered"
  FPA_WORKSPACE="$ow" "$here/bin/fp-register" "$sh/fa" --key "$(keyof "$sh/fa")" >/dev/null 2>&1 </dev/null; rc=$?
  chflags nouchg "$ow/fpa.registered"
  [ "$rc" -ne 0 ] && ! grep -q '^fa\.example ' "$ow/allowed_signers" 2>/dev/null
  check "a registration that cannot be recorded leaves its key out of the trust root" 0 $?
else
  echo "skip -- no chflags here; the commit-order check needs a file that refuses to be replaced"
fi

# Usage errors are usage errors: exit 2 with a message, never a traceback.
r=""
for cmd in "fp-register $sh/acme --key" "fp-lock --update hello --from" "fp-resolve hello --from" \
           "fp-init-catalog $sh/never --url https://never.example --identity" "fp-verify --from"; do
  out=$("$here"/bin/$cmd 2>&1 </dev/null); rc=$?
  case "$out" in *Traceback*) rc=traceback;; esac; r="$r$rc "
done
check "a flag given without its value is a usage error in every tool" "2 2 2 2 2 " "$r"
"$here/bin/fp-verify" "--from=$sh/acme" hello >/dev/null 2>&1 </dev/null
check "fp-verify refuses an option it does not know, rather than ignoring it" 2 $?
"$here/bin/fp-verify" --from gh:frompt-org/catalog >/dev/null 2>&1 </dev/null
check "a gh: catalog without @branch is a usage error" 2 $?
"$here/bin/fp-verify" hello --from "$sh/acme//" --context registered >/dev/null 2>&1 </dev/null
check "trailing slashes do not make a registered catalog a different one" 0 $?
FPA_WORKSPACE="$lw" "$here/bin/fp-verify" --from "file://$sh/acme" >/dev/null 2>&1 </dev/null
check "fp-verify fetches over http and https only" 2 $?
unset FPA_WORKSPACE
rm -rf "$sh"

# --- certificate authorities: trust the authority, not the key (M7b) ----------
# The trust root names an authority, and publishers sign with keys it certified.
# Every key is made for these checks; nothing is written to this checkout.
ca=$(mktemp -d 2>/dev/null || echo "/tmp/fp-ca-$$"); mkdir -p "$ca/ws" "$ca/cat" "$ca/fresh"
export FPA_WORKSPACE="$ca/ws"
ssh-keygen -q -t ed25519 -N "" -C authority -f "$ca/authority" >/dev/null 2>&1
printf '*@docs.example.org cert-authority,namespaces="foreign-prompts" %s\n' \
  "$(cut -d' ' -f1,2 "$ca/authority.pub")" > "$ca/ws/allowed_signers"
cafp=$(ssh-keygen -lf "$ca/authority.pub" | awk '{print $2}')
for k in builder second rogue stale outsider; do
  ssh-keygen -q -t ed25519 -N "" -C "$k" -f "$ca/$k" >/dev/null 2>&1
done
ssh-keygen -q -s "$ca/authority" -I builder -n team-a@docs.example.org -V -5m:+1d "$ca/builder.pub" >/dev/null 2>&1
ssh-keygen -q -s "$ca/authority" -I second -n team-b@docs.example.org -V -5m:+1d "$ca/second.pub" >/dev/null 2>&1
ssh-keygen -q -s "$ca/authority" -I stale -n team-a@docs.example.org -V 20200101:20200102 "$ca/stale.pub" >/dev/null 2>&1
ssh-keygen -q -s "$ca/authority" -I outsider -n team-x@infra.example.org -V -5m:+1d "$ca/outsider.pub" >/dev/null 2>&1
casign() { # casign <serial> <key-or-cert>: the docs catalog's manifest at that serial, signed
  python3 -c 'import json, sys
m = {"base": sys.argv[3], "not_after": "2099-01-01T00:00:00Z",
     "prompts": [], "serial": int(sys.argv[2])}
open(sys.argv[1], "w").write(json.dumps(m, indent=2, sort_keys=True) + "\n")' "$ca/cat/index.json" "$1" "$ca/cat/prompts"
  rm -f "$ca/cat/index.json.sig"
  ssh-keygen -Y sign -f "$2" -n foreign-prompts "$ca/cat/index.json" >/dev/null 2>&1
}
casign 5 "$ca/builder-cert.pub"
out=$("$here/bin/fp-verify" --from "$ca/cat" 2>/dev/null </dev/null); rc=$?
[ $rc -eq 0 ] && printf '%s' "$out" | grep -q "signed by team-a@docs.example.org via certificate from authority $cafp"
check "a key the trusted authority certified verifies, and the authority is named, not the key (M7b)" 0 $?
casign 5 "$ca/builder-cert.pub"; { echo "-- note --"; cat "$ca/cat/index.json.sig"; } > "$ca/sig.tmp"
mv "$ca/sig.tmp" "$ca/cat/index.json.sig"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "a signature file with text before its armor is refused" 1 $?
casign 5 "$ca/second-cert.pub"; cp "$ca/cat/index.json.sig" "$ca/second.sig"
casign 5 "$ca/builder-cert.pub"; cat "$ca/second.sig" >> "$ca/cat/index.json.sig"
"$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "a signature file carrying a second signature after its armor is refused" 2 $?
casign 6 "$ca/outsider-cert.pub"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "a certificate for a principal outside the authority's pattern is refused" 1 $?
casign 6 "$ca/rogue"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "an uncertified key is refused when the trust root names only an authority" 1 $?
casign 6 "$ca/stale-cert.pub"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "an expired certificate is refused, whatever the manifest's not_after says" 1 $?
casign 999999 "$ca/second-cert.pub"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "a second principal of the same authority cannot sign a catalog the first one signs (M6b)" 1 $?
casign 6 "$ca/builder-cert.pub"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "one principal under an authority cannot raise another principal's freshness floor" 0 $?
casign 4 "$ca/builder-cert.pub"; "$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "the floor still holds for the principal that set it" 1 $?

# Registering pins one key; an authority vouches for many principals (M7b).
casign 7 "$ca/builder-cert.pub"; cp "$ca/ws/allowed_signers" "$ca/cat/allowed_signers"
FPA_WORKSPACE="$ca/fresh" "$here/bin/fp-register" "$ca/cat" --key "$cafp" >/dev/null 2>&1 </dev/null
rc=$?; [ $rc -eq 1 ] && [ ! -e "$ca/fresh/allowed_signers" ] && [ ! -e "$ca/fresh/fpa.registered" ]
check "fp-register refuses an authority's fingerprint before touching the trust root" 0 $?
r=""
for form in 'CERT-AUTHORITY,namespaces="foreign-prompts"' 'namespaces="x y,foreign-prompts",cert-authority'; do
  rm -rf "$ca/served" "$ca/served-ws"; cp -R "$ca/cat" "$ca/served"; mkdir -p "$ca/served-ws"
  printf '*@docs.example.org %s %s\n' "$form" "$(cut -d' ' -f1,2 "$ca/authority.pub")" > "$ca/served/allowed_signers"
  out=$(FPA_WORKSPACE="$ca/served-ws" "$here/bin/fp-register" "$ca/served" --key "$cafp" 2>&1 </dev/null)
  rc=$?; printf '%s' "$out" | grep -q 'names a certificate authority' && r="$r$rc " || r="${r}missed "
done
check "an authority line is recognised in any letter case and with quoted option values" "1 1 " "$r"
"$here/bin/fp-register" "$ca/cat" >/dev/null 2>&1 </dev/null
rc=$?; [ $rc -eq 1 ] && [ ! -e "$ca/ws/fpa.registered" ]
check "fp-register refuses a catalog signed under a certificate, even with the authority trusted" 0 $?
mkdir -p "$ca/fresh2"; cp "$ca/ws/allowed_signers" "$ca/fresh2/"
printf 'other@docs.example.org %s\n' "$(cut -d' ' -f1,2 "$ca/rogue.pub")" > "$ca/rogue.signers"
signers_before=$(shasum < "$ca/fresh2/allowed_signers")
FPA_WORKSPACE="$ca/fresh2" "$here/bin/fp-register" "$ca/cat" --trust "$ca/rogue.signers" >/dev/null 2>&1 </dev/null
rc=$?; [ $rc -eq 1 ] && [ "$(shasum < "$ca/fresh2/allowed_signers")" = "$signers_before" ] \
  && [ ! -e "$ca/fresh2/.fpa/manifest-serials.json" ]
check "refusing a catalog signed under a certificate also takes back the keys and floors it added" 0 $?
printf '%s %s latest 2026-01-01 selftest\n' "$ca/cat" "$cafp" > "$ca/ws/fpa.registered"
"$here/bin/fp-verify" --from "$ca/cat" >/dev/null 2>&1 </dev/null
check "a registered catalog signed under a certificate is refused (AC2b, M7b)" 1 $?
rm -f "$ca/ws/fpa.registered"

# fp-sign signs as the certificate beside the key, and publishes no key line.
signers_before=$(shasum < "$ca/cat/allowed_signers")
FPA_CATALOG="$ca/cat" FPA_SIGNING_KEY="$ca/builder" "$here/bin/fp-sign" >/dev/null 2>&1 </dev/null \
  && ssh-keygen -Y verify -f "$ca/cat/allowed_signers" -I team-a@docs.example.org -n foreign-prompts \
       -s "$ca/cat/index.json.sig" < "$ca/cat/index.json" >/dev/null 2>&1 \
  && [ "$(shasum < "$ca/cat/allowed_signers")" = "$signers_before" ]
check "fp-sign signs with the key's certificate and leaves the authority's trust root alone" 0 $?
FPA_CATALOG="$ca/cat" FPA_SIGNING_KEY="$ca/outsider" "$here/bin/fp-sign" >/dev/null 2>&1 </dev/null
check "fp-sign refuses a certificate no authority in allowed_signers accepts" 1 $?
unset FPA_WORKSPACE
rm -rf "$ca"

"$here/examples/08-host-your-own-catalog/run.sh" >/dev/null 2>&1
check "examples/08-host-your-own-catalog runs: fingerprint, pin, drift, a second publisher, a swapped key" 0 $?

# --- the full-blown example still runs ------------------------------------------
"$here/examples/06-catalog-end-to-end/run.sh" >/dev/null 2>&1
check "examples/06-catalog-end-to-end runs: write, sign, register, resolve, verify, refuse tampering" 0 $?

[ "$fails" -eq 0 ] && { echo "all checks passed"; exit 0; }
echo "$fails check(s) failed"; exit 1
