#!/usr/bin/env python3
"""fp-docscheck — every §N reference resolves, every relative link exists.

Docs rot silently when a spec is renumbered: §8 was the adoption algorithm, then
it was Refusal, and the examples went on citing §8 for the wrong thing. This
turns that into an exit code.
"""
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else ".")
heads = {m.group(1) for m in re.finditer(r"^## (\d+)\. ", (root / "FPA.md").read_text(), re.M)}
bad = []
for f in sorted(root.rglob("*.md")):
    if ".git" in str(f):
        continue
    text = f.read_text()
    bad += [f"{f}: §{n} is not a section of FPA.md" for n in re.findall(r"§(\d+)", text) if n not in heads]
    for target in re.findall(r"\]\(([^)#]+?)\)", text):
        target = target.strip()
        if not target.startswith(("http", "mailto:")) and not (f.parent / target).exists():
            bad.append(f"{f}: dead link -> {target}")
print("\n".join(bad) if bad else "docs ok")
sys.exit(1 if bad else 0)
