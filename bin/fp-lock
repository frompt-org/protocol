#!/usr/bin/env python3
"""fp-lock — pin the prompts a team adopts, so every agent resolves the same bytes.

Late binding is the point of a foreign prompt, and it is also the risk: whatever
the publisher changed this morning is what your agents run this afternoon. A lock
file is where a team says which version of that freedom they want.

    fp-lock                     # write fpa.lock from the current index
    fp-lock --check             # exit 1 if a prompt no longer matches its pin
    fp-lock --update <id>       # re-pin one prompt, deliberately, as a reviewed diff
    fp-lock --update <id> --from <base>   # pin one from a registered catalog you do not hold

Without --from the pins come from the catalog bin/fpa_roots.py finds, hashed from
its files. With --from they come from the publisher's manifest, verified first by
fp-verify -- which also fetched the document and checked it against that manifest,
so the digest pinned is the digest of bytes that actually arrived. fpa.lock lives
in the workspace (FPA_WORKSPACE, else this checkout).

The point is not that pinning is safer than floating. It is that the choice
becomes a line in a file somebody reviews, instead of an event nobody sees.

Exit: 0 in sync · 1 drift · 2 unreadable.
"""
import hashlib
import json
import pathlib
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import fpa_roots  # noqa: E402

TOOLS = fpa_roots.TOOLS
ROOT = fpa_roots.catalog()
LOCK = fpa_roots.workspace() / "fpa.lock"
HEADER = [
    "# fpa.lock -- pinned foreign prompts.",
    "#",
    "# Each line: <id> <version> sha256:<digest> <url>",
    "# An agent resolving one of these MUST refuse bytes whose digest is not the",
    "# one pinned here. Updating a pin is a reviewed diff, not a surprise.",
    "#",
    "# Regenerate with bin/fp-lock. Check with bin/fp-lock --check.",
]


def manifest():
    try:
        return json.loads((ROOT / "index.json").read_text())
    except OSError as exc:
        print(f"fp-lock: cannot read index.json -- {exc}", file=sys.stderr)
        sys.exit(2)


def current():
    """id -> (version, digest, url), hashed from the prompt files themselves.

    Deliberately not read out of index.json: the manifest can be stale, and a
    lock check that trusts a stale manifest reports "in sync" about a prompt that
    has already moved. What an agent resolves is bytes, so bytes are what this
    compares.
    """
    m = manifest()
    urls = {}
    for entry in m["prompts"]:
        for v in entry["versions"]:
            urls[(entry["id"], v["version"])] = f"{m['base']}/{v['file']}"
    out = {}
    for path in sorted(ROOT.glob("prompts/*/*.frompt.md")):
        raw = path.read_bytes()
        fm = {}
        for line in raw.decode("utf-8").splitlines()[2:]:
            if line.strip() == "---":
                break
            if ":" in line:
                k, v = line.split(":", 1)
                fm[k.strip()] = v.strip()
        key = (fm["id"], fm["version"])
        out.setdefault(fm["id"], []).append(
            (fm["version"], hashlib.sha256(raw).hexdigest(),
             urls.get(key, f"{m['base']}/{path.parent.name}/{path.name}")))
    # A lock pins one version per id: the newest published, unless --update says
    # otherwise. Pinning several would be a range by another name.
    return {pid: max(vs, key=lambda v: semver_key(v[0])) for pid, vs in out.items()}


def semver_key(v):
    core, _, pre = v.partition("-")
    nums = tuple(int(x) if x.isdigit() else 0 for x in core.split("."))
    return nums + ((0, pre) if pre else (1, ""))


def remote(pid, base):
    """(version, digest, url) for the latest version of pid in a registered catalog,
    from the manifest fp-verify just verified -- never a second fetch of it."""
    with tempfile.TemporaryDirectory() as td:
        out = pathlib.Path(td) / "index.json"
        proc = subprocess.run([str(TOOLS / "bin" / "fp-verify"), pid, "--from", base,
                               "--context", "registered", "--manifest-out", str(out)],
                              capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if proc.returncode != 0 or not out.exists():
            sys.stderr.write(proc.stderr)
            print(f"fp-lock: {pid} from {base} did not verify for the registered context -- "
                  "nothing pinned", file=sys.stderr)
            sys.exit(proc.returncode if proc.returncode in (1, 2) else 2)
        m = json.loads(out.read_text())
    entry = next(p for p in m["prompts"] if p["id"] == pid)
    v = next(v for v in entry["versions"] if v["version"] == entry["latest"])
    return v["version"], v["digest"], f"{m['base']}/{v['file']}"


def registered_ids():
    """Only prompts declaring `registered` may be pinned. A pin is consent given
    once for unattended reuse, and a prompt that never offered itself for that
    should not acquire it by being listed."""
    fit = set()
    for entry in manifest()["prompts"]:
        newest = entry["versions"][0]
        if "registered" in [c.strip() for c in newest.get("contexts", "").split(",")]:
            fit.add(entry["id"])
    return fit


def parse():
    if not LOCK.exists():
        return {}
    out = {}
    for line in LOCK.read_text().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        pid, version, digest, url = line.split()
        out[pid] = (version, digest.removeprefix("sha256:"), url)
    return out


def render(pins):
    lines = list(HEADER) + [""]
    for pid in sorted(pins):
        version, digest, url = pins[pid]
        lines.append(f"{pid} {version} sha256:{digest} {url}")
    return "\n".join(lines) + "\n"


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0

    if "--update" in argv:
        at = argv.index("--update") + 1
        if at >= len(argv) or argv[at].startswith("-"):
            print("fp-lock: --update needs a prompt id\n" + __doc__.split("\n\n")[2], file=sys.stderr)
            return 2
        wanted = argv[at]
        if "--from" in argv:
            base = argv[argv.index("--from") + 1].rstrip("/")
            pins = parse()
            was = pins.get(wanted)
            pins[wanted] = remote(wanted, base)
            LOCK.parent.mkdir(parents=True, exist_ok=True)
            LOCK.write_text(render(pins))
            now_v, now_d, _ = pins[wanted]
            if was and was[1] != now_d:
                print(f"re-pinned {wanted}: {was[0]} {was[1][:12]} -> {now_v} {now_d[:12]}")
            else:
                print(f"pinned {wanted} {now_v} {now_d[:12]} from {base}")
            return 0
        pins, now = parse(), current()
        if wanted not in now:
            print(f"fp-lock: {wanted!r} is not in the index", file=sys.stderr)
            return 2
        was = pins.get(wanted)
        pins[wanted] = now[wanted]
        LOCK.write_text(render(pins))
        if was and was[1] != now[wanted][1]:
            print(f"re-pinned {wanted}: {was[0]} {was[1][:12]} -> {now[wanted][0]} {now[wanted][1][:12]}")
        else:
            print(f"pinned {wanted} {now[wanted][0]} {now[wanted][1][:12]}")
        return 0

    if "--check" in argv:
        pins, now = parse(), current()
        if not pins:
            print("fp-lock: no fpa.lock -- nothing is pinned", file=sys.stderr)
            return 1
        drift = []
        # A pin from another catalog is checked where it is resolved (fp-resolve
        # --from compares bytes against it); this catalog's files say nothing about it.
        local = manifest()["base"].rstrip("/") + "/"
        for pid, (version, digest, url) in sorted(pins.items()):
            if not url.startswith(local):
                continue
            if pid not in now:
                drift.append(f"  {pid}: pinned, but no longer published")
                continue
            pub_version, pub_digest, pub_url = now[pid]
            if pub_digest != digest:
                drift.append(f"  {pid}: pinned {version} {digest[:12]}, "
                             f"published {pub_version} {pub_digest[:12]}")
            elif pub_version != version:
                drift.append(f"  {pid}: same bytes, but pinned as {version} and published as "
                             f"{pub_version} -- one of the two is lying about what changed")
            elif pub_url != url:
                drift.append(f"  {pid}: pinned at {url}, now published at {pub_url}")
        if drift:
            print("fp-lock: prompts have moved since they were pinned:\n" + "\n".join(drift)
                  + "\nRe-pin deliberately with 'fp-lock --update <id>'.", file=sys.stderr)
            return 1
        print(f"fpa.lock is in sync ({len(pins)} pinned)")
        return 0

    now = current()
    fit = {pid: v for pid, v in now.items() if pid in registered_ids()}
    skipped = sorted(set(now) - set(fit))
    # Pins taken from other catalogs (--from) are not this catalog's to rewrite.
    base = manifest()["base"].rstrip("/") + "/"
    kept = {pid: v for pid, v in parse().items() if not v[2].startswith(base) and pid not in fit}
    LOCK.write_text(render({**kept, **fit}))
    print(f"wrote fpa.lock ({len(fit)} pinned)")
    if skipped:
        print("not pinned -- these do not declare the registered context (FPA.md AC1): "
              + ", ".join(skipped))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as exc:  # noqa: BLE001
        print(f"fp-lock: internal error: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(3)
