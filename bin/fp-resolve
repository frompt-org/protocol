#!/usr/bin/env python3
"""fp-resolve — turn a prompt id into verified bytes, ready to adopt.

This is the deterministic half of a skill that adopts foreign prompts. It looks
an id up in the index, fetches it, recomputes the digest, and refuses if that
digest is not the one the index published. Nothing here interprets the document;
that is the agent's job, and it happens only after this exits 0.

    fp-resolve pr-review@1.2.0                # a version, exactly
    fp-resolve pr-review@latest               # whatever is newest now
    fp-resolve pr-review                      # same as @latest
    fp-resolve pr-review --base ./prompts     # resolve from a local checkout
    fp-resolve --list                         # what the index offers
    fp-resolve pr-review --record             # the adoption record, without the body
    fp-resolve pr-review --lock               # refuse anything not matching fpa.lock
    fp-resolve pr-review --from gh:frompt-org/catalog@main   # a registered catalog's manifest

--from fetches the publisher's manifest and resolves against it: that is the
registered context. An earlier version had no --from, so "register, then
resolve" resolved from this checkout's own index -- a different publisher than
the one just registered. With --from, a workspace that keeps fpa.registered
refuses an unregistered catalog, and the pin mode it registered with is
enforced: `latest` floats, `version` and `digest` require a matching fpa.lock.

Exit: 0 verified · 1 digest mismatch, unknown id, or refused · 2 unreachable.

A mismatch is not a warning. If the bytes are not the bytes the index vouched
for, the pilot and the agent are not looking at the same document, and there is
nothing to discuss.
"""
import hashlib
import pathlib
import json
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
INDEX = ROOT / "INDEX.md"


def semver_key(v):
    core, _, pre = v.partition("-")
    nums = tuple(int(x) if x.isdigit() else 0 for x in core.split("."))
    return nums + ((0, pre) if pre else (1, ""))


def entries(manifest):
    """id -> {latest, versions[]} from a manifest.

    Read from index.json rather than INDEX.md: the machine-readable copy is the
    one a signature covers, and prose is not a data structure.
    """
    return {p["id"]: p for p in manifest.get("prompts", [])}


def local_manifest():
    try:
        return json.loads((ROOT / "index.json").read_text())
    except OSError:
        return {}


def registered(base):
    """The fpa.registered line for a base, or None. A workspace with no such file
    is not using the registered model and is unaffected."""
    reg = ROOT / "fpa.registered"
    if not reg.exists():
        return "unregistered-model"
    for line in reg.read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            parts = line.split()
            if parts[0] == base.rstrip("/"):
                return {"fingerprint": parts[1], "pin": parts[2] if len(parts) > 2 else "latest"}
    return None


def pins():
    lock = ROOT / "fpa.lock"
    if not lock.exists():
        return None
    out = {}
    for line in lock.read_text().splitlines():
        if line.strip() and not line.startswith("#"):
            pid, version, dg, url = line.split()
            out[pid] = (version, dg.removeprefix("sha256:"), url)
    return out


def select(entry, selector):
    """Pick one version. Exactly two selectors exist: a version, or `latest`.

    No range grammar, deliberately. Ranges reconcile transitive dependencies and
    there are none here -- a pilot adopts one document, and chains need a fresh
    decision. Choosing is a human act; the digest is what binds.
    """
    versions = entry["versions"]
    if selector in (None, "", "latest"):
        wanted = entry["latest"]
    else:
        wanted = selector
    for v in versions:
        if v["version"] == wanted:
            return v, wanted
    return None, wanted


def tokens_of(value):
    return [t.strip() for t in value.split(",") if t.strip()]


def read(source):
    """Return exact bytes. read_text() translates newlines, so a CRLF variant of a
    document hashed to the same digest as its LF original and passed verification
    -- the integrity check was checking a normalization, not the document."""
    if source.startswith("gh:"):
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader("fp_lint", str(ROOT / "bin" / "fp-lint"))
        spec = importlib.util.spec_from_loader("fp_lint", loader)
        fp = importlib.util.module_from_spec(spec)
        loader.exec_module(fp)
        return fp.fetch_gh(source).encode("utf-8")
    if source.startswith(("http://", "https://")):
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader("fp_lint", str(ROOT / "bin" / "fp-lint"))
        spec = importlib.util.spec_from_loader("fp_lint", loader)
        fp = importlib.util.module_from_spec(spec)
        loader.exec_module(fp)
        return fp.fetch(source).encode("utf-8")
    return pathlib.Path(source).read_bytes()


def main(argv):
    # Positional arguments only: the value after --from or --base is not a prompt id.
    # Counting it as one made `fp-resolve --list --from <catalog>` resolve the catalog
    # address as if it were a prompt.
    valued = {"--from", "--base"}
    args = [a for i, a in enumerate(argv[1:], 1)
            if not a.startswith("-") and argv[i - 1] not in valued]
    flags = [a for a in argv[1:] if a.startswith("-")]
    if "-h" in flags or "--help" in flags or (not args and "--list" not in flags):
        print(__doc__)
        return 0 if ("-h" in flags or "--help" in flags) else 2

    origin = None
    if "--from" in argv:
        origin = argv[argv.index("--from") + 1].rstrip("/")
        reg = registered(origin)
        if reg is None:
            print(f"fp-resolve: {origin} is not in fpa.registered.\n"
                  "  This workspace registers the catalogs it accepts. Register it deliberately:\n"
                  f"    bin/fp-register {origin}", file=sys.stderr)
            return 1
        # The manifest is used only as fp-verify verified it: signature against the
        # local trust root, the signing key against the registered one (AC2b),
        # expiry, the serial floor, and fitness for the registered context (AC4b).
        # An earlier version read the fetched JSON directly and checked none of
        # that, while the catalog README promised all of it.
        import subprocess, tempfile
        target = args[0] if args else ""
        with tempfile.TemporaryDirectory() as td:
            out = pathlib.Path(td) / "index.json"
            cmd = [str(ROOT / "bin" / "fp-verify")] + ([target] if target else []) + [
                "--from", origin, "--context", "registered", "--manifest-out", str(out)]
            proc = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
            if proc.returncode != 0 or not out.exists():
                sys.stderr.write(proc.stderr)
                print(f"fp-resolve: refusing -- {origin} did not pass verification for the "
                      "registered context (reason above).", file=sys.stderr)
                return proc.returncode if proc.returncode in (1, 2) else 2
            manifest = json.loads(out.read_bytes().decode("utf-8"))
        pin_mode = reg["pin"] if isinstance(reg, dict) else "latest"
    else:
        manifest = local_manifest()
        pin_mode = None
    known = entries(manifest)
    if "--list" in flags:
        for e in known.values():
            newest = e["versions"][0]
            others = ", ".join(v["version"] for v in e["versions"][1:])
            print(f"{e['id']:<20} latest {e['latest']:<8} {newest.get('ceremony','?'):<9} "
                  f"{newest.get('flow','?'):<14}" + (f"also {others}" if others else ""))
        return 0

    wanted, _, selector = args[0].partition("@")
    base = None
    if "--base" in argv:
        base = argv[argv.index("--base") + 1]

    if wanted in known:
        version, asked = select(known[wanted], selector)
        if version is None:
            have = ", ".join(v["version"] for v in known[wanted]["versions"])
            print(f"fp-resolve: {wanted} has no version {asked!r}. Published: {have}",
                  file=sys.stderr)
            return 1
        entry = dict(version, id=wanted)
        if base:
            source = f"{base.rstrip('/')}/{entry['file']}"
        elif origin:
            source = f"{origin}/prompts/{entry['file']}"
        else:
            source = f"{manifest['base']}/{entry['file']}"
    elif wanted.startswith(("http://", "https://")) or pathlib.Path(wanted).exists():
        # Nothing vouched for these bytes, so there is nothing to verify against.
        # Exiting 0 here meant a skill told "adopt what it printed" adopted a
        # document no index had ever seen.
        print(f"fp-resolve: {wanted} is not in the index, so no digest was ever published "
              "for it. Refusing: there is nothing to verify against.\n"
              "  Use bin/fp-adopt to read an unindexed document as a pilot, with its phrase.",
              file=sys.stderr)
        return 1
    else:
        print(f"fp-resolve: no prompt {wanted!r} in the index. Try --list.", file=sys.stderr)
        return 1

    try:
        raw = read(source)
    except Exception as exc:  # noqa: BLE001
        print(f"fp-resolve: cannot read {source} -- {exc}", file=sys.stderr)
        return 2

    digest = hashlib.sha256(raw).hexdigest()

    # A pin is what bounds registered consent (FPA.md AC2). `latest` floats;
    # `version` and `digest` need a matching fpa.lock line, and the check covers
    # version and origin as well as digest (M5) -- an earlier version compared
    # the digest alone, so a pin was satisfied by the right bytes from the wrong
    # publisher, or at a version nobody had reviewed.
    want_lock = "--lock" in flags or pin_mode in ("version", "digest")
    if want_lock:
        locked = pins()
        if locked is None:
            print("fp-resolve: a lock is required here but there is no fpa.lock", file=sys.stderr)
            return 2
        if wanted not in locked:
            print(f"fp-resolve: {wanted!r} is not pinned in fpa.lock -- refusing"
                  + (f" (this catalog was registered with pin mode {pin_mode!r})" if pin_mode else ""),
                  file=sys.stderr)
            return 1
        if "registered" not in tokens_of(entry.get("contexts", "interactive")):
            print(f"fp-resolve: {wanted} declares contexts "
                  f"[{entry.get('contexts', 'interactive')}] -- it is not fit for the registered "
                  "context, so a pin does not authorize it (FPA.md AC1).", file=sys.stderr)
            return 1
        pv, pd, purl = locked[wanted]
        pub_base = manifest.get("base", "")
        if pub_base and not purl.startswith(pub_base.rstrip("/") + "/"):
            print(f"fp-resolve: {wanted} is pinned from a different publisher\n"
                  f"  pinned  {purl}\n  manifest base {pub_base}\n"
                  "A pin names one catalog; the same bytes from another are not what was agreed to (M5).",
                  file=sys.stderr)
            return 1
        if pin_mode != "digest" and pv != entry["version"]:
            print(f"fp-resolve: {wanted} is pinned at {pv}, the manifest offers {entry['version']}\n"
                  "Re-pin deliberately with 'bin/fp-lock --update' if the bump is wanted (M5).",
                  file=sys.stderr)
            return 1
        if pd != digest:
            print(f"fp-resolve: {wanted} has moved since it was pinned\n"
                  f"  pinned  {pv} {pd}\n"
                  f"  fetched {digest}\n"
                  "Re-pin deliberately with 'bin/fp-lock --update' if that is what you want.",
                  file=sys.stderr)
            return 1

    if entry and digest != entry["digest"]:
        print(f"fp-resolve: DIGEST MISMATCH for {wanted}\n"
              f"  index published {entry['digest']}\n"
              f"  fetched bytes   {digest}\n"
              f"  source          {source}\n"
              "Refusing. Either the document changed and the index is stale, or these are not "
              "the bytes the index vouched for.", file=sys.stderr)
        return 1

    how = "pinned" if want_lock else ("registered" if origin else "indexed")
    asked = selector or "latest"
    record = (f"resolved={wanted}@{asked} version={entry['version']} "
              f"digest={digest[:12]} source={source} verified={how}")
    if "--record" in flags:
        print(record)
        return 0
    print(f"<!-- fp-resolve: {record} -->")
    sys.stdout.write(raw.decode("utf-8", "replace"))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as exc:  # noqa: BLE001
        print(f"fp-resolve: internal error: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(3)
