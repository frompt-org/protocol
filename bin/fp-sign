#!/usr/bin/env bash
# fp-sign -- sign index.json, so a managed agent can verify a publisher.
#
# A digest proves the bytes are the bytes you expected. Only a signature proves
# who expected them -- which is what an unattended agent needs, because there is
# no pilot to have expected anything. So the manifest is signed and the documents
# are not: each document's digest is inside the signed manifest.
#
#   fp-sign                        # sign index.json with .fpa/signing_key
#   fp-sign --keygen               # create that key if it does not exist
#   fp-sign --catalog DIR          # name the catalog instead of standing in it
#   FPA_SIGNING_KEY=~/.ssh/id_ed25519 fp-sign --catalog DIR
#
# FPA_SIGNING_CERT names a certificate for the signing key: the manifest is then
# signed as that certificate, for clients that trust its authority (FPA.md M7b).
# A certificate is used only when named -- never a <key>-cert.pub found beside the
# key -- and it must certify that key. Unset or empty, the key signs as itself.
#
# It signs the catalog named by --catalog or FPA_CATALOG, else the one
# bin/fpa_roots.py finds: the nearest directory upward holding
# frompt-catalog.json, else this checkout. A key from outside the catalog
# (FPA_SIGNING_KEY) signs only a catalog named explicitly: finding one by where
# you stand is a convenience for the catalog's own key. The identity
# is FPA_SIGNING_IDENTITY, else the catalog's `identity`, else
# foreign-prompts-publisher.
#
# Uses ssh-keygen -Y, which is present wherever OpenSSH is, needs no GPG
# keyring, and verifies with a plain allowed_signers file.
#
# The private key never enters the repository (.fpa/ is gitignored). What ships
# is index.json, index.json.sig and allowed_signers -- enough to verify, not
# enough to forge.
set -euo pipefail
tools=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
keygen=""; named="${FPA_CATALOG:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --keygen) keygen=1 ;;
    --catalog) [ $# -ge 2 ] || { echo "fp-sign: --catalog needs a value" >&2; exit 2; }
               named="$2"; shift ;;
    *) echo "fp-sign: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
if [ -n "${FPA_SIGNING_KEY:-}" ] && [ -z "$named" ]; then
  echo "fp-sign: FPA_SIGNING_KEY is set, so name the catalog to sign with --catalog DIR (or FPA_CATALOG)." >&2
  echo "  A key from outside a catalog signs only a catalog somebody named, never the one you stand in." >&2
  exit 2
fi
if [ -n "$named" ]; then
  here=$(cd "$named" 2>/dev/null && pwd) || { echo "fp-sign: no catalog directory at $named" >&2; exit 2; }
else
  here=$(python3 "$tools/bin/fpa_roots.py" catalog)
fi
cd "$here"

key="${FPA_SIGNING_KEY:-$here/.fpa/signing_key}"
configured=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("identity",""))' \
  frompt-catalog.json 2>/dev/null || true)
identity="${FPA_SIGNING_IDENTITY:-${configured:-foreign-prompts-publisher}}"
case "$identity" in *[[:space:],]*|"") echo "fp-sign: identity '$identity' cannot contain spaces or commas -- it is an allowed_signers principal" >&2; exit 2;; esac

if [ -n "$keygen" ]; then
  mkdir -p "$(dirname "$key")"
  if [ -f "$key" ]; then
    echo "fp-sign: $key already exists; refusing to overwrite a signing key" >&2
    exit 2
  fi
  ssh-keygen -t ed25519 -N "" -C "$identity" -f "$key" >/dev/null
  echo "created $key (gitignored) and $key.pub"
fi

[ -f "$key" ] || { echo "fp-sign: no signing key at $key -- run 'fp-sign --keygen'" >&2; exit 2; }
[ -f index.json ] || { echo "fp-sign: no index.json -- run bin/fp-index" >&2; exit 2; }

# A key certified by an authority (FPA.md M7b) signs as its certificate, which is
# what lets a client trust the authority rather than this key. There is then no
# key line to publish: allowed_signers names the authority, and the authority
# distributes that line, not each publisher it certifies.
cert="${FPA_SIGNING_CERT:-}"
if [ -n "$cert" ]; then
  # A refusal leaves no signature behind: an unverifiable index.json.sig is worse
  # than none.
  refuse() { rm -f index.json.sig; echo "fp-sign: $1" >&2; [ -z "${2:-}" ] || echo "  $2" >&2; exit 1; }
  [ -f "$cert" ] || refuse "FPA_SIGNING_CERT names $cert, which does not exist"
  [ -f "$key.pub" ] || refuse "no public key at $key.pub to match the certificate against"
  certinfo=$(python3 - "$tools/bin" "$cert" "$key.pub" <<'PY'
import base64, sys
sys.path.insert(0, sys.argv[1])
import fpa_roots
try:
    c = fpa_roots.certificate_file(open(sys.argv[2]).read())
    key = fpa_roots.ssh_fingerprint(base64.b64decode(open(sys.argv[3]).read().split()[1], validate=True))
except (ValueError, IndexError, OSError) as exc:
    print(f"cannot read: {exc}")
    sys.exit(1)
if c["certified"] != key:
    print(f"certifies {c['certified']}, not the signing key {key}")
    sys.exit(1)
print(c["authority"])
print(",".join(c["principals"]))
PY
) || refuse "certificate $cert: $certinfo" "A certificate signs only for the key it certifies (FPA_SIGNING_KEY, else .fpa/signing_key)."
  authority=$(printf '%s\n' "$certinfo" | sed -n 1p)
  rm -f index.json.sig
  # ssh-keygen signs with the private key beside the certificate, which the check
  # above has shown is the key this run was given.
  ssh-keygen -Y sign -f "$cert" -n foreign-prompts index.json >/dev/null 2>&1 \
    || refuse "ssh-keygen could not sign index.json with certificate $cert"
  principal=$(ssh-keygen -Y find-principals -s index.json.sig -f allowed_signers 2>/dev/null | head -1 || true)
  if [ -z "$principal" ] || ! ssh-keygen -Y verify -f allowed_signers -I "$principal" -n foreign-prompts \
       -s index.json.sig < index.json >/dev/null 2>&1; then
    refuse "signed with certificate $cert, but no authority in allowed_signers accepts it" \
      "(unknown authority, a principal outside its pattern, or an expired certificate). Add the authority's cert-authority line, or renew the certificate."
  fi
  echo "signed index.json -> index.json.sig with a certificate (verified)"
  echo "principal $principal, authority $authority"
  echo
  echo "The signature verifies only while the certificate is valid. Commit index.json and"
  echo "index.json.sig; clients trust the authority's cert-authority line, not this key."
  exit 0
fi

# ssh-keygen -Y sign PROMPTS before overwriting an existing .sig, and answers "no"
# and exits 0 when stdin is closed. It reported success while leaving a stale
# signature in place -- a publisher accidentally serving yesterday's signed
# manifest is a rollback nobody had to attack for.
rm -f index.json.sig
if ! ssh-keygen -Y sign -f "$key" -n foreign-prompts index.json >/dev/null 2>&1; then
  echo "fp-sign: ssh-keygen could not sign index.json" >&2
  exit 1
fi
# Merge, do not overwrite: allowed_signers is also this workspace's trust root
# for OTHER publishers' catalogs, and an earlier version replaced the whole file
# with one line every time it signed -- silently dropping every registered key.
# Written under the state lock and replaced whole, since where catalog and
# workspace are one directory a registration may be writing it too.
python3 - "$tools/bin" "$here" "$identity" "$key.pub" <<'PY' || { echo "fp-sign: cannot write allowed_signers" >&2; exit 1; }
import pathlib, sys
sys.path.insert(0, sys.argv[1])
import fpa_roots
here, identity, pub = pathlib.Path(sys.argv[2]), sys.argv[3], pathlib.Path(sys.argv[4])
with fpa_roots.state_lock(here):
    path = here / "allowed_signers"
    keep = [l for l in (path.read_text().splitlines() if path.exists() else [])
            if (l.split() or [""])[0] != identity]
    fpa_roots.write_text_atomic(path, "\n".join(keep + [f"{identity} {pub.read_text().strip()}"]) + "\n")
PY

# Never claim a signature without checking it. This is the cheap half of the
# whole mechanism, and skipping it is how the stale .sig went unnoticed.
if ! ssh-keygen -Y verify -f allowed_signers -I "$identity" -n foreign-prompts \
     -s index.json.sig < index.json >/dev/null 2>&1; then
  echo "fp-sign: wrote a signature that does not verify -- refusing to claim success" >&2
  exit 1
fi
fingerprint=$(ssh-keygen -lf "$key.pub" | awk '{print $2}')
echo "signed index.json -> index.json.sig (verified)"
echo "published allowed_signers for identity '$identity'"
echo "key fingerprint $fingerprint"
echo
echo "The private key stays in $key and is gitignored. Commit index.json,"
echo "index.json.sig and allowed_signers; a managed agent needs exactly those three."
echo "Publish the fingerprint somewhere other than the catalog -- a client registers with"
echo "  fp-register <url> --key $fingerprint"
