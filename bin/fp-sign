#!/usr/bin/env bash
# fp-sign -- sign index.json, so a managed agent can verify a publisher.
#
# A digest proves the bytes are the bytes you expected. Only a signature proves
# who expected them -- which is what an unattended agent needs, because there is
# no pilot to have expected anything. So the manifest is signed and the documents
# are not: each document's digest is inside the signed manifest.
#
#   fp-sign                        # sign index.json with .fpa/signing_key
#   fp-sign --keygen               # create that key if it does not exist
#   FPA_SIGNING_KEY=~/.ssh/id_ed25519 fp-sign
#
# It signs the catalog bin/fpa_roots.py finds: FPA_CATALOG, else the nearest
# directory upward holding frompt-catalog.json, else this checkout. The identity
# is FPA_SIGNING_IDENTITY, else the catalog's `identity`, else
# foreign-prompts-publisher.
#
# Uses ssh-keygen -Y, which is present wherever OpenSSH is, needs no GPG
# keyring, and verifies with a plain allowed_signers file.
#
# The private key never enters the repository (.fpa/ is gitignored). What ships
# is index.json, index.json.sig and allowed_signers -- enough to verify, not
# enough to forge.
set -euo pipefail
tools=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
here=$(python3 "$tools/bin/fpa_roots.py" catalog)
cd "$here"

key="${FPA_SIGNING_KEY:-$here/.fpa/signing_key}"
configured=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("identity",""))' \
  frompt-catalog.json 2>/dev/null || true)
identity="${FPA_SIGNING_IDENTITY:-${configured:-foreign-prompts-publisher}}"
case "$identity" in *[[:space:],]*|"") echo "fp-sign: identity '$identity' cannot contain spaces or commas -- it is an allowed_signers principal" >&2; exit 2;; esac

if [ "${1:-}" = "--keygen" ]; then
  mkdir -p "$(dirname "$key")"
  if [ -f "$key" ]; then
    echo "fp-sign: $key already exists; refusing to overwrite a signing key" >&2
    exit 2
  fi
  ssh-keygen -t ed25519 -N "" -C "$identity" -f "$key" >/dev/null
  echo "created $key (gitignored) and $key.pub"
fi

[ -f "$key" ] || { echo "fp-sign: no signing key at $key -- run 'fp-sign --keygen'" >&2; exit 2; }
[ -f index.json ] || { echo "fp-sign: no index.json -- run bin/fp-index" >&2; exit 2; }

# ssh-keygen -Y sign PROMPTS before overwriting an existing .sig, and answers "no"
# and exits 0 when stdin is closed. It reported success while leaving a stale
# signature in place -- a publisher accidentally serving yesterday's signed
# manifest is a rollback nobody had to attack for.
rm -f index.json.sig
if ! ssh-keygen -Y sign -f "$key" -n foreign-prompts index.json >/dev/null 2>&1; then
  echo "fp-sign: ssh-keygen could not sign index.json" >&2
  exit 1
fi
# Merge, do not overwrite: allowed_signers is also this workspace's trust root
# for OTHER publishers' catalogs, and an earlier version replaced the whole file
# with one line every time it signed -- silently dropping every registered key.
tmp_signers=$(mktemp 2>/dev/null || echo "/tmp/fp-signers-$$")
{ [ -f allowed_signers ] && awk -v id="$identity" '$1 != id' allowed_signers; printf '%s %s\n' "$identity" "$(cat "$key.pub")"; } > "$tmp_signers"
mv "$tmp_signers" allowed_signers

# Never claim a signature without checking it. This is the cheap half of the
# whole mechanism, and skipping it is how the stale .sig went unnoticed.
if ! ssh-keygen -Y verify -f allowed_signers -I "$identity" -n foreign-prompts \
     -s index.json.sig < index.json >/dev/null 2>&1; then
  echo "fp-sign: wrote a signature that does not verify -- refusing to claim success" >&2
  exit 1
fi
fingerprint=$(ssh-keygen -lf "$key.pub" | awk '{print $2}')
echo "signed index.json -> index.json.sig (verified)"
echo "published allowed_signers for identity '$identity'"
echo "key fingerprint $fingerprint"
echo
echo "The private key stays in $key and is gitignored. Commit index.json,"
echo "index.json.sig and allowed_signers; a managed agent needs exactly those three."
echo "Publish the fingerprint somewhere other than the catalog -- a client registers with"
echo "  fp-register <url> --key $fingerprint"
